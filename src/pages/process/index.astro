---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import JournalCard from '../../components/JournalCard.astro';
import { getJournal } from '../../lib/journal';
import { url } from '../../lib/url';
import VideoClip from '../../components/VideoClip.astro';
import Figure from '../../components/Figure.astro';
import BreathSync from '../../components/BreathSync.astro';
import alphaTeaser from '../../assets/alpha/visitors-under-cloud.jpg';
import buildStuffing from '../../assets/photos/build-stuffing.jpg';
import visitCeiling from '../../assets/photos/visit-cloud-ceiling.jpg';
import visitFire from '../../assets/photos/visit-tv-fire.jpg';
import visitStars from '../../assets/photos/visit-stars.jpg';

const entries = await getJournal();
const stages = ['Proposal', 'Exploration', 'Making', 'Sharing'] as const;

const lessons = [
  {
    title: 'Never tell people what to feel',
    text: 'Being told to feel connected is the fastest way not to. Small rituals and room for people’s own stories work better.',
    href: '/process/2026-05-19-rituals-not-instructions/',
  },
  {
    title: 'Belonging is not control',
    text: 'Interactive work usually rewards control. We wanted people to play a role alongside the cloud, breathing with it rather than steering it.',
    href: '/process/2026-06-10-belonging-not-control/',
  },
  {
    title: 'Make it travel home',
    text: 'Asking the experience to carry into everyday life kept it minimal. The next cloud you see should bring a little of it back.',
    href: '/process/2026-05-13-something-you-take-home/',
  },
  {
    title: 'How people are welcomed shapes what they feel',
    text: 'Réespiration showed a wide range of responses, from deep relaxation to boredom. Priming, guidance and a robust signal matter as much as the artwork.',
    href: '/process/2026-07-02-quand-le-ciel-recule/',
  },
  {
    title: 'A breath sensor has to really hear a breath',
    text: 'Narrow stretch bands barely registered above the noise. A 20 cm band gave a clear, readable wave.',
    href: '/process/2026-06-12-a-belt-that-listens/',
  },
  {
    title: 'The material has to hide the technology',
    text: 'Mesh was too opaque and tulle wouldn’t hold a shape. Layers of soft fibre over a mesh shell finally turned hundreds of LEDs into one glow.',
    href: '/process/2026-07-30-the-alpha-cloud/',
  },
  {
    title: 'A bond before the breath',
    text: 'Six planned movements became three. The magical twilight gives the cloud a character, so breathing with it means more.',
    href: '/process/2026-09-24-the-final-score/',
  },
  {
    title: 'Design an adjacent possible',
    text: 'Offer something people can discover, lean into and make their own, with many ways in.',
    href: '/process/2026-06-26-conversation-with-amos-blanton/',
  },
];

const byMonth = new Map<string, typeof entries>();
for (const entry of entries) {
  const key = entry.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  byMonth.set(key, [...(byMonth.get(key) ?? []), entry]);
}
---

<Base title="Process" description="A process journal documenting how a cloud installation about belonging was imagined, tested and built over time.">
  <PageHeader
    eyebrow="Process journal"
    image={buildStuffing}
    imageAlt="Lying on a pillow beneath the lit cloud, pushing a bamboo skewer up into the fibre."
    title="How it came together"
    lede="Research-creation, as it happened: notes from our meetings, material tests, visits and conversations, in the order they happened. The false starts are here too, because they shaped the work as much as what stayed."
  />

  <section class="section lessons" id="lessons">
    <div class="wrap">
      <div class="lessons-head reveal">
        <p class="eyebrow">Lessons learned along the way</p>
        <h2>What the process taught us</h2>
      </div>
      <ol class="lesson-list">
        {
          lessons.map((l) => (
            <li class="reveal">
              <h3>{l.title}</h3>
              <p>{l.text}</p>
              <a href={url(l.href)}>Read the entry →</a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section timeline-section">
    <div class="wrap">
      <div class="journal-head reveal">
        <div>
          <p class="eyebrow">The journal</p>
          <h2>Month by month</h2>
        </div>
        <div class="filters" role="group" aria-label="Filter by stage">
          <button type="button" aria-pressed="true" data-filter="all">All</button>
          {stages.map((s) => <button type="button" aria-pressed="false" data-filter={s}>{s}</button>)}
        </div>
      </div>
      <div class="next reveal">
        <span class="pulse" aria-hidden="true"></span>
        <div>
          <p class="eyebrow">What comes next</p>
          <p class="next-text">
            Taking the cloud to new people and places, and trying the belonging workshop. We’ll add it here as it
            happens.
          </p>
        </div>
      </div>
      {
        [...byMonth].map(([month, items]) => (
          <section class="month" data-month>
            <h2 class="month-label">{month}</h2>
            <div class="grid-3">
              {items.map((entry) => (
                <div data-entry-stage={entry.data.stage}>
                  <JournalCard entry={entry} />
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
  <section class="section dark alpha" id="alpha">
    <div class="wrap grid-2 alpha-teaser">
      <div class="reveal">
        <p class="eyebrow">The alpha · 29–30 July 2026</p>
        <h2>A cloud you can lie under</h2>
        <p>
          Everything came together at the end of July: the first full cloud, a corner of the studio turned into a sky,
          and people lying beneath it. The installation page has films of the evening, the people who came, and how we
          got it ready.
        </p>
        <p><a class="button" href={url('/installation/#alpha')}>See the alpha</a></p>
      </div>
      <Figure src={alphaTeaser} alt="People lounging on sheets and beanbags beneath the glowing alpha cloud." ratio="4 / 3" class="reveal" />
    </div>
  </section>

  <section class="section dark sim">
    <div class="wrap">
      <div class="grid-2 sim-head">
        <div class="reveal">
          <p class="eyebrow">Simulating before building</p>
          <h2>An early walk-through in 3D</h2>
        </div>
        <div class="reveal">
          <p>
            Before building at full scale, we made a simulation of the room to think through the experience. Breaths
            are shown as waves with their own rate, depth and phase, and a <em>synchrony</em> measure rises as they
            align. Lightning can be tuned for frequency and intensity.
          </p>
          <p class="small">
            This recording is from July 2026, when the score still ended at sunrise. The final score has
            <a href={url('/concept/#score')}>three stages</a>.
          </p>
        </div>
      </div>
      <VideoClip name="simulation" ratio="1280 / 636" caption="Screen recording of the July 2026 simulation." class="reveal" />
    </div>
  </section>

  <section class="section try" id="try">
    <div class="wrap">
      <div class="grid-2 try-head">
        <div class="reveal">
          <p class="eyebrow">Try it</p>
          <h2>Breath synchrony, in your browser</h2>
        </div>
        <div class="reveal">
          <p>
            In the installation, a sensor follows your real breathing. Here, a button stands in for it. Your breath is
            the large cloud, which swells and glows as you breathe in. The smaller clouds drift at their own rhythms,
            and as you breathe slowly and steadily they gradually fall into step with you. Hold the rhythm long enough
            and the sky brightens.
          </p>
          <p class="small">
            This playful web version extends the idea beyond the installation. The small clouds are modelled as coupled
            oscillators (a Kuramoto model), the same maths often used to describe fireflies flashing in unison.
          </p>
        </div>
      </div>
      <div class="reveal">
        <BreathSync />
      </div>
    </div>
  </section>

  <section class="section visits" id="visits">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Looking at how others do it</p>
        <h2>Field visits</h2>
        <p class="measure">
          We visited immersive theatre in Paris to study thresholds, hosts and atmosphere: <em>Le Grand Hôtel des
          Rêves</em>, and Moir’s immersive personality test <em>TOI</em>. Other touchstones include Fujiko Nakaya’s fog
          sculptures and Olafur Eliasson’s <em>Beauty</em>.
        </p>
      </div>
      <div class="grid-3">
        <Figure src={visitCeiling} alt="A dark control room with swirling clouds projected across the ceiling." caption="A projected sky of clouds, Le Grand Hôtel des Rêves." ratio="3 / 4" class="reveal" />
        <Figure src={visitStars} alt="A deep blue room with a starry ceiling." caption="A starry room — should our night have stars?" ratio="3 / 4" class="reveal" />
        <Figure src={visitFire} alt="An old television showing a fireplace." caption="A fireplace on an old TV. For a while, a glowing hearth at the centre of the room was part of our design." ratio="3 / 4" class="reveal" />
      </div>
    </div>
  </section>

</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-entry-stage]');
  const months = document.querySelectorAll<HTMLElement>('[data-month]');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((el) => (el.hidden = f !== 'all' && el.dataset.entryStage !== f));
      months.forEach((m) => (m.hidden = !m.querySelector('[data-entry-stage]:not([hidden])')));
    }),
  );
</script>

<style>
  .journal-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
    margin-bottom: 2.5rem;
  }
  .journal-head h2 {
    margin: 0;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filters button {
    appearance: none;
    font: inherit;
    font-size: 0.88rem;
    color: var(--ink);
    background: rgb(255 255 255 / 0.5);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.5em 1.1em;
    cursor: pointer;
  }
  .filters button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .lessons {
    background: linear-gradient(180deg, var(--paper), var(--paper-deep));
    padding-top: 3rem;
  }
  .lessons-head {
    margin-bottom: 2.5rem;
  }
  .lesson-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1.25rem;
    counter-reset: lesson;
  }
  .lesson-list li {
    counter-increment: lesson;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.7);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
  }
  .lesson-list li::before {
    content: counter(lesson, decimal-leading-zero);
    font-family: var(--font-display);
    color: var(--dusk);
    margin-bottom: 0.8rem;
  }
  .lesson-list h3 {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }
  .lesson-list p {
    color: var(--ink-soft);
    font-size: 0.95rem;
    flex: 1;
  }
  .lesson-list a {
    color: var(--ink);
    font-size: 0.88rem;
  }
  .next {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.75rem;
    border: 1px dashed rgb(59 82 180 / 0.35);
    border-radius: var(--radius);
    margin-bottom: 4rem;
  }
  .next .eyebrow {
    margin-bottom: 0.3rem;
  }
  .next-text {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin: 0;
  }
  .pulse {
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    margin-top: 0.3rem;
    border-radius: 50%;
    background: var(--rose);
    box-shadow: 0 0 0 0 rgb(248 169 140 / 0.6);
    animation: ring 2.4s infinite;
  }
  @keyframes ring {
    70% {
      box-shadow: 0 0 0 14px rgb(248 169 140 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(248 169 140 / 0);
    }
  }
  .month {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 2rem;
    padding-block: 3rem;
    border-top: 1px solid var(--line);
  }
  .month-label {
    font-size: 1.3rem;
    position: sticky;
    top: 6rem;
    align-self: start;
  }
  @media (max-width: 760px) {
    .month {
      grid-template-columns: 1fr;
    }
    .month-label {
      position: static;
    }
  }
  .section-head {
    margin-bottom: 3rem;
    max-width: 44rem;
  }
  .sim-head,
  .try-head {
    margin-bottom: 3rem;
  }
  .alpha {
    background: linear-gradient(180deg, var(--night), #141a3d 60%, var(--night));
  }
  .alpha p {
    color: var(--ink-soft);
  }
  .alpha a {
    color: #eceefb;
  }
  .alpha-teaser {
    align-items: center;
  }
  .sim p {
    color: var(--ink-soft);
  }
  .small {
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

</style>
