---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import JournalCard from '../../components/JournalCard.astro';
import { getJournal } from '../../lib/journal';
import { url } from '../../lib/url';
import VideoClip from '../../components/VideoClip.astro';
import Figure from '../../components/Figure.astro';
import alphaTeaser from '../../assets/alpha/visitors-under-cloud.jpg';
import buildStuffing from '../../assets/photos/build-stuffing.jpg';
import visitCeiling from '../../assets/photos/visit-cloud-ceiling.jpg';
import visitFire from '../../assets/photos/visit-tv-fire.jpg';
import visitStars from '../../assets/photos/visit-stars.jpg';

const entries = await getJournal();
const stages = ['Concept formation', 'Conversation', 'Making', 'Article'] as const;

const byMonth = new Map<string, typeof entries>();
for (const entry of entries) {
  const key = entry.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  byMonth.set(key, [...(byMonth.get(key) ?? []), entry]);
}
---

<Base title="Process" description="A process journal documenting how a cloud installation about belonging was imagined, tested and built over time.">
  <PageHeader
    eyebrow="Process journal"
    image={buildStuffing}
    imageAlt="Lying on a pillow beneath the lit cloud, pushing a bamboo skewer up into the fibre."
    title="How it came together"
    lede="Research-creation, as it happened: notes from our meetings, material tests, visits and conversations, in the order they happened. The false starts are here too, because they shaped the work as much as what stayed."
  />

  <section class="section wash wash-sand timeline-section">
    <div class="wrap">
      <div class="journal-head reveal">
        <div>
          <p class="eyebrow">The journal</p>
          <h2>Month by month</h2>
        </div>
        <div class="filters" role="group" aria-label="Filter by stage">
          <button type="button" aria-pressed="true" data-filter="all">All</button>
          {stages.map((s) => <button type="button" aria-pressed="false" data-filter={s}>{s}</button>)}
        </div>
      </div>
      <div class="next reveal">
        <span class="pulse" aria-hidden="true"></span>
        <div>
          <p class="eyebrow">What comes next</p>
          <p class="next-text">
            <a href={url("/#call-for-belonging")}>Taking the cloud to new people and places, and trying the belonging workshop.</a>{' '}
            We’ll add it here as it happens.
          </p>
        </div>
      </div>
      {
        [...byMonth].map(([month, items]) => (
          <section class="month" data-month>
            <h2 class="month-label">{month}</h2>
            <div class="grid-3">
              {items.map((entry) => (
                <div data-entry-stage={entry.data.stage}>
                  <JournalCard entry={entry} />
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
  <section class="section dark blend alpha" id="alpha">
    <div class="wrap grid-2 alpha-teaser">
      <div class="reveal">
        <p class="eyebrow">The alpha · 29–30 July 2026</p>
        <h2>A cloud you can lie under</h2>
        <p>
          Everything came together at the end of July: the first full cloud, a corner of the studio turned into a sky,
          and people lying beneath it. The installation page has films of the evening, the people who came, and how we
          got it ready.
        </p>
        <p><a class="button" href={url('/installation/#alpha')}>See the alpha</a></p>
      </div>
      <Figure src={alphaTeaser} alt="People lounging on sheets and beanbags beneath the glowing alpha cloud." ratio="4 / 3" class="reveal" />
    </div>
  </section>

  <section class="section dark blend sim">
    <div class="wrap">
      <div class="grid-2 sim-head">
        <div class="reveal">
          <p class="eyebrow">Simulating before building</p>
          <h2>An early walk-through in 3D</h2>
        </div>
        <div class="reveal">
          <p>
            Before building at full scale, we made a simulation of the room to think through the experience. Breaths
            are shown as waves with their own rate, depth and phase, and a <em>synchrony</em> measure rises as they
            align. Lightning can be tuned for frequency and intensity.
          </p>
          <p class="small">
            This recording is from July 2026, when the score still ended at sunrise. The final score has
            <a href={url('/concept/#score')}>three stages</a>.
          </p>
        </div>
      </div>
      <VideoClip name="simulation" ratio="1280 / 636" caption="Screen recording of the July 2026 simulation." class="reveal" />
    </div>
  </section>

  <section class="section wash visits" id="visits">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Looking at how others do it</p>
        <h2>Field visits</h2>
        <p class="measure">
          We visited immersive theatre in Paris to study thresholds, hosts and atmosphere: <em>Le Grand Hôtel des
          Rêves</em>, and Moir’s immersive personality test <em>TOI</em>. Other touchstones include Fujiko Nakaya’s fog
          sculptures and Olafur Eliasson’s <em>Beauty</em>.
        </p>
      </div>
      <div class="grid-3">
        <Figure src={visitCeiling} alt="A dark control room with swirling clouds projected across the ceiling." caption="A projected sky of clouds, Le Grand Hôtel des Rêves." ratio="3 / 4" class="reveal" />
        <Figure src={visitStars} alt="A deep blue room with a starry ceiling." caption="A starry room — should our night have stars?" ratio="3 / 4" class="reveal" />
        <Figure src={visitFire} alt="An old television showing a fireplace." caption="A fireplace on an old TV. For a while, a glowing hearth at the centre of the room was part of our design." ratio="3 / 4" class="reveal" />
      </div>
    </div>
  </section>

</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-entry-stage]');
  const months = document.querySelectorAll<HTMLElement>('[data-month]');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((el) => (el.hidden = f !== 'all' && el.dataset.entryStage !== f));
      months.forEach((m) => (m.hidden = !m.querySelector('[data-entry-stage]:not([hidden])')));
    }),
  );
</script>

<style>
  .journal-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
    margin-bottom: 2.5rem;
  }
  .journal-head h2 {
    margin: 0;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filters button {
    appearance: none;
    font: inherit;
    font-size: 0.88rem;
    color: var(--ink);
    background: rgb(255 255 255 / 0.5);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.5em 1.1em;
    cursor: pointer;
  }
  .filters button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .next {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.75rem;
    border: 1px dashed rgb(59 82 180 / 0.35);
    border-radius: var(--radius);
    margin-bottom: 4rem;
  }
  .next .eyebrow {
    margin-bottom: 0.3rem;
  }
  .next-text {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin: 0;
  }
  .pulse {
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    margin-top: 0.3rem;
    border-radius: 50%;
    background: var(--rose);
    box-shadow: 0 0 0 0 rgb(248 169 140 / 0.6);
    animation: ring 2.4s infinite;
  }
  @keyframes ring {
    70% {
      box-shadow: 0 0 0 14px rgb(248 169 140 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(248 169 140 / 0);
    }
  }
  .month {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 2rem;
    padding-block: 3rem;
    border-top: 1px solid var(--line);
  }
  .month-label {
    font-size: 1.3rem;
    position: sticky;
    top: 6rem;
    align-self: start;
  }
  @media (max-width: 760px) {
    .month {
      grid-template-columns: 1fr;
    }
    .month-label {
      position: static;
    }
  }
  .section-head {
    margin-bottom: 3rem;
    max-width: 44rem;
  }
  .sim-head {
    margin-bottom: 3rem;
  }
  .alpha {
    background: linear-gradient(180deg, var(--night), #141a3d 60%, var(--night));
  }
  .alpha p {
    color: var(--ink-soft);
  }
  .alpha a {
    color: #eceefb;
  }
  .alpha-teaser {
    align-items: center;
  }
  .sim p {
    color: var(--ink-soft);
  }
  .small {
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

</style>
