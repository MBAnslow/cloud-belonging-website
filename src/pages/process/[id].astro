---
import { url } from '../../lib/url';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Cloud3D from '../../components/Cloud3D.astro';
import VideoClip from '../../components/VideoClip.astro';
import MediaGallery, { type GalleryItem } from '../../components/MediaGallery.astro';
import { getJournal, formatDate } from '../../lib/journal';

export async function getStaticPaths() {
  const entries = await getJournal();
  return entries.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, newer: entries[i - 1], older: entries[i + 1] },
  }));
}

const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const { title, date, stage, summary, cover, coverAlt, coverVideo, video, gallery, clips, sections, tags } = entry.data;
const media: GalleryItem[] = [
  ...clips.map((c) => ({ video: c.name, caption: c.caption, portrait: c.portrait, sound: c.sound })),
  ...gallery.map((g) => ({ image: g.src, alt: g.alt, caption: g.caption })),
];
const sectionMedia = sections.map((section) => {
  const sectionClips: GalleryItem[] = section.clips.map((clip) => ({
    video: clip.name,
    caption: clip.caption,
    portrait: clip.portrait,
    sound: clip.sound,
  }));
  const sectionGallery: GalleryItem[] = section.gallery.map((item) => ({
    image: item.src,
    alt: item.alt,
    caption: item.caption,
  }));
  return {
    ...section,
    media: section.galleryFirst
      ? [...sectionGallery, ...sectionClips]
      : [...sectionClips, ...sectionGallery],
  };
});
const portraitVideos = ['led-matrix', 'cloud-led', 'tulle-projector'];
const videoRatios: Record<string, string> = {
  simulation: '1280 / 636',
};
const twilightClouds = [
  {
    id: 'dusk',
    title: 'Dusk',
    cloud: 'dusk' as const,
    cycle: ['golden', 'dusk'] as const,
    audio: 'dusk.mp3',
  },
  {
    id: 'magical-twilight',
    title: 'Magical twilight',
    cloud: 'twilight' as const,
    cycle: ['dusk', 'twilight'] as const,
    audio: 'magical-twilight.mp3',
  },
];
const extraScoreClouds = [
  {
    id: 'breath-and-dawn',
    title: 'Breath and dawn',
    cloud: 'breath' as const,
    cycle: ['breath', 'dawn'] as const,
    audio: 'breath-and-dawn.mp3',
  },
  {
    id: 'daylight',
    title: 'Daylight',
    cloud: 'day' as const,
    cycle: ['day', 'paper'] as const,
    audio: 'daylight.mp3',
  },
];
const showTwilightClouds = entry.id === '2026-09-24-the-final-score';
---

<Base title={title} description={summary}>
  <article>
    <header class="entry-header">
      <div class="wrap narrow">
        <a class="back" href={url("/process/")}>← Process journal</a>
        <div class="meta">
          <span class="tag" data-stage={stage}>{stage}</span>
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
        </div>
        <h1>{title}</h1>
        <p class="lede">{summary}</p>
      </div>
    </header>

    {
      coverVideo ? (
        <div class="wrap narrow cover">
          <video
            src={url(`/video/${coverVideo}.mp4`)}
            poster={url(`/video/${coverVideo}.jpg`)}
            autoplay
            muted
            loop
            playsinline
            aria-label={coverAlt}
          />
        </div>
      ) : cover && (
        <div class="wrap narrow cover">
          <Image src={cover} alt={coverAlt ?? ''} widths={[800, 1200, 1800]} sizes="(min-width: 72rem) 72rem, 100vw" loading="eager" />
        </div>
      )
    }

    <div class="wrap narrow body">
      <div class="prose">
        <Content />
      </div>
    </div>

    {
      showTwilightClouds && (
        <div class="wrap narrow score-clouds" id="score-clouds-block" data-score-clouds>
          {twilightClouds.map((phase) => (
            <div class="score-period">
              <figure class="score-cloud">
                <div class="score-sky">
                  <Cloud3D mode="cycle" initial={phase.cloud} cycle={[...phase.cycle]} place={[0, 0.12, 0.62]} placeNarrow={[0, 0.12, 0.62]} />
                </div>
                <figcaption>
                  <strong>{phase.title}</strong>
                </figcaption>
              </figure>
              <audio controls preload="metadata" src={url(`/audio/${phase.audio}`)} aria-label={`${phase.title} score`} />
            </div>
          ))}
        </div>
      )
    }

    {
      showTwilightClouds && (
        <div class="wrap narrow score-clouds" id="score-clouds-extra-block" data-score-clouds>
          {extraScoreClouds.map((phase) => (
            <div class="score-period">
              <figure class="score-cloud">
                <div class="score-sky">
                  <Cloud3D mode="cycle" initial={phase.cloud} cycle={[...phase.cycle]} place={[0, 0.12, 0.62]} placeNarrow={[0, 0.12, 0.62]} />
                </div>
                <figcaption>
                  <strong>{phase.title}</strong>
                </figcaption>
              </figure>
              <audio controls preload="metadata" src={url(`/audio/${phase.audio}`)} aria-label={`${phase.title} score`} />
            </div>
          ))}
        </div>
      )
    }

    {
      sectionMedia.length > 0 ? (
        <div class="media-sections">
          {sectionMedia.map((section) => (
            <section class:list={['journal-part', { continuation: !section.title }]}>
              <div class="wrap narrow journal-part-copy">
                {section.title && <h2>{section.title}</h2>}
                <p set:html={section.description} />
              </div>
              {section.media.length > 0 && (
                <div class="wrap narrow media">
                  <MediaGallery
                    items={section.media}
                    columns={section.media.length < 3 ? section.media.length : 3}
                  />
                </div>
              )}
            </section>
          ))}
        </div>
      ) : media.length > 0 && (
        <div class="wrap narrow media">
          <MediaGallery items={media} columns={media.length < 3 ? media.length : 3} title={clips.length && gallery.length ? "Photos and video" : clips.length ? "Video" : "Photos"} />
        </div>
      )
    }

    <div class="wrap narrow body after-media">

      {
        video && (
          <div class:list={['entry-video', { portrait: portraitVideos.includes(video) }]}>
            <VideoClip
              name={video}
              orientation={portraitVideos.includes(video) ? 'portrait' : 'landscape'}
              ratio={videoRatios[video]}
            />
          </div>
        )
      }

      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {tags.map((t) => (
              <li>#{t}</li>
            ))}
          </ul>
        )
      }
    </div>
  </article>

  <nav class="pager wrap narrow" aria-label="More entries">
    {
      older ? (
        <a href={url(`/process/${older.id}/`)} class="prev">
          <span>← Earlier</span>
          {older.data.title}
        </a>
      ) : (
        <span />
      )
    }
    {
      newer && (
        <a href={url(`/process/${newer.id}/`)} class="next">
          <span>Later →</span>
          {newer.data.title}
        </a>
      )
    }
  </nav>
</Base>

{
  showTwilightClouds && (
    <script>
      [
        ['score-clouds-marker', 'score-clouds-block'],
        ['score-clouds-extra-marker', 'score-clouds-extra-block'],
      ].forEach(([markerId, blockId]) => {
        const marker = document.getElementById(markerId);
        const block = document.getElementById(blockId);
        if (marker && block) marker.replaceWith(block);
      });
    </script>
  )
}

<style>
  .narrow {
    max-width: 46rem;
  }
  .entry-header {
    padding-block: clamp(3rem, 8vw, 6rem) 2.5rem;
  }
  .back {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 2rem;
  }
  .back:hover {
    color: var(--ink);
  }
  .meta {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    font-size: 0.85rem;
    color: var(--ink-faint);
    margin-bottom: 1.25rem;
  }
  h1 {
    font-size: clamp(2.2rem, 1.5rem + 3vw, 4rem);
  }
  .cover img,
  .cover video {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 78vh;
    margin-inline: auto;
    border-radius: calc(var(--radius) * 1.2);
  }
  .body {
    padding-block: 3rem 4rem;
  }
  .entry-video {
    margin-top: 2.5rem;
  }
  .body:has(+ .media) {
    padding-bottom: 1.5rem;
  }
  .after-media {
    padding-top: 0;
  }
  .media {
    margin-bottom: 1.25rem;
  }
  .media-sections {
    display: grid;
    gap: clamp(3.5rem, 8vw, 6rem);
    margin-bottom: 1.25rem;
  }
  .journal-part-copy {
    margin-bottom: 1.5rem;
  }
  .journal-part-copy h2 {
    margin-bottom: 0.75rem;
  }
  .journal-part-copy p:last-child {
    color: var(--ink-soft);
  }
  .journal-part.continuation {
    margin-top: -2.5rem;
  }
  .entry-video.portrait {
    max-width: 22rem;
  }
  .score-clouds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-block: 1.25rem 2.5rem;
  }
  .score-cloud {
    position: relative;
    aspect-ratio: 16 / 10;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: #1b2250;
    color: #fbfaff;
  }
  .score-period audio {
    display: block;
    width: 100%;
    margin-top: 0.75rem;
  }
  .score-sky {
    position: absolute;
    inset: 0;
  }
  .score-cloud figcaption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: inline-flex;
    padding: 0.42rem 0.72rem;
    border-radius: 999px;
    background: rgb(14 19 40 / 0.72);
    backdrop-filter: blur(8px);
  }
  .score-cloud strong {
    font-size: 0.86rem;
    line-height: 1.1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (max-width: 700px) {
    .score-clouds {
      grid-template-columns: 1fr;
    }
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 2.5rem 5rem;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: grid;
    gap: 0.3rem;
    max-width: 18rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.3;
  }
  .pager a span {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  .pager .next {
    text-align: right;
    margin-left: auto;
  }
</style>
