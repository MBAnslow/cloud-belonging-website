---
import { url } from '../../lib/url';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import VideoClip from '../../components/VideoClip.astro';
import { getJournal, formatDate } from '../../lib/journal';

export async function getStaticPaths() {
  const entries = await getJournal();
  return entries.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, newer: entries[i - 1], older: entries[i + 1] },
  }));
}

const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const { title, date, stage, summary, cover, coverAlt, video, tags } = entry.data;
const portraitVideos = ['led-matrix', 'cloud-led', 'tulle-projector'];
---

<Base title={title} description={summary}>
  <article>
    <header class="entry-header">
      <div class="wrap narrow">
        <a class="back" href={url("/process/")}>← Process journal</a>
        <div class="meta">
          <span class="tag" data-stage={stage}>{stage}</span>
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
        </div>
        <h1>{title}</h1>
        <p class="lede">{summary}</p>
      </div>
    </header>

    {
      cover && (
        <div class="wrap cover">
          <Image src={cover} alt={coverAlt ?? ''} widths={[800, 1200, 1800]} sizes="(min-width: 72rem) 72rem, 100vw" loading="eager" />
        </div>
      )
    }

    <div class="wrap narrow body">
      <div class="prose">
        <Content />
      </div>

      {
        video && (
          <div class:list={['entry-video', { portrait: portraitVideos.includes(video) }]}>
            <VideoClip
              name={video}
              orientation={portraitVideos.includes(video) ? 'portrait' : 'landscape'}
              ratio={video === 'simulation' ? '1280 / 636' : undefined}
            />
          </div>
        )
      }

      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {tags.map((t) => (
              <li>#{t}</li>
            ))}
          </ul>
        )
      }
    </div>
  </article>

  <nav class="pager wrap narrow" aria-label="More entries">
    {
      older ? (
        <a href={url(`/process/${older.id}/`)} class="prev">
          <span>← Earlier</span>
          {older.data.title}
        </a>
      ) : (
        <span />
      )
    }
    {
      newer && (
        <a href={url(`/process/${newer.id}/`)} class="next">
          <span>Later →</span>
          {newer.data.title}
        </a>
      )
    }
  </nav>
</Base>

<style>
  .narrow {
    max-width: 46rem;
  }
  .entry-header {
    padding-block: clamp(3rem, 8vw, 6rem) 2.5rem;
  }
  .back {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 2rem;
  }
  .back:hover {
    color: var(--ink);
  }
  .meta {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    font-size: 0.85rem;
    color: var(--ink-faint);
    margin-bottom: 1.25rem;
  }
  h1 {
    font-size: clamp(2.2rem, 1.5rem + 3vw, 4rem);
  }
  .cover img {
    width: auto;
    max-width: 100%;
    max-height: 78vh;
    margin-inline: auto;
    border-radius: calc(var(--radius) * 1.2);
  }
  .body {
    padding-block: 3rem 4rem;
  }
  .entry-video {
    margin-top: 2.5rem;
  }
  .entry-video.portrait {
    max-width: 22rem;
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 2.5rem 5rem;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: grid;
    gap: 0.3rem;
    max-width: 18rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.3;
  }
  .pager a span {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  .pager .next {
    text-align: right;
    margin-left: auto;
  }
</style>
