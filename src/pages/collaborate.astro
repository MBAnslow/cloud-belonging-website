---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Checklist from '../components/Checklist.astro';
import CloudFrame from '../components/CloudFrame.astro';
import callForBelonging from '../assets/photos/call-for-belonging-flag.jpg';
import Figure from '../components/Figure.astro';
import { Image } from 'astro:assets';
import exhibitionPlan from '../assets/photos/exhibition-top-down.jpg';
import imgPeople from '../assets/photos/belonging-people.jpg';
import imgOurselves from '../assets/photos/belonging-ourselves.jpg';
import imgNature from '../assets/photos/belonging-nature.jpg';
import belongingApp from '../assets/photos/belonging-app.jpg';

const movements = [
  {
    name: 'Arrive',
    time: '20 min',
    text: 'Cross a threshold. Shoes off, phones away. A short inward question: how are you arriving today? A few minutes of breathing together, with nothing to achieve.',
  },
  {
    name: 'Sense',
    time: '30 min',
    text: 'Experience a small version of the cloud: lie under a small cloud of cotton and light, breathe with a sensor, notice what happens in you and around you. Then notice the room, the others, the weather outside.',
  },
  {
    name: 'Make',
    time: '60 min',
    text: 'In small groups, tinker with the materials we used (cotton, wadding, mesh, LEDs, breath sensors, sound) to build a tiny space for belonging. Many entry points: some will sew, some will code, some will write a ritual.',
  },
  {
    name: 'Share',
    time: '30 min',
    text: 'Visit each other’s spaces. Then a sharing circle: each person speaks once about what they experienced, and is listened to without reply.',
  },
];

const belongings = [
  {
    title: 'To people',
    image: imgPeople,
    alt: 'Friends gathered around a campfire under a crescent moon',
    text: 'Belonging to each other: strangers, friends, families and communities, and what makes us feel seen and accepted.',
  },
  {
    title: 'To ourselves',
    image: imgOurselves,
    alt: 'A person meditating by a window at sunset over rooftops',
    text: 'Belonging in our own bodies, memories and stories: feeling at home in who we are.',
  },
  {
    title: 'To nature',
    image: imgNature,
    alt: 'A walker on a mountain top above the clouds at sunrise',
    text: 'Belonging to the sky, the weather, the living world and the places we share with it.',
  },
];

const circleRules = [
  'Speak from your own experience, in the first person.',
  'Listen without replying, advising or comparing.',
  'Silence is welcome. You can always pass.',
  'What is shared in the circle stays in the circle.',
];

const prompts = [
  'The next time you see a cloud, take three breaths with it. Where was this water yesterday?',
  'Notice a moment today when someone made you feel you belonged. What exactly did they do?',
  'Think of a place where you belong. Which sense brings it back first — a sound, a smell, a texture?',
  'Offer someone five minutes of listening without replying.',
];
---

<Base title="Collaborate" description="Collaborate with us on workshops, installations and research about belonging. Includes the belonging checklist and an example workshop as examples of what a collaboration could produce.">
  <section class="section wash contact" id="contact">
    <div class="wrap contact-inner">
      <div class="contact-copy reveal">
        <p class="eyebrow">A call for belonging</p>
        <h2>Open to collaborate</h2>
        <p class="lede">
          We really enjoyed working and thinking about belonging and bringing that together to form our cloud. We're more than happy to expand on this work so please reach out!
        </p>
        <a class="button" href="mailto:michael.anslow@gmail.com?cc=zephir.lorne@ens.psl.eu">Start a conversation</a>
      </div>
      <CloudFrame
        src={callForBelonging}
        alt="A lone figure holding a large flag above a sea of clouds at sunrise."
        widths={[500, 800, 1100]}
        sizes="(min-width: 60rem) 42rem, 100vw"
        seed={47}
        class="contact-photo reveal"
      />
    </div>
  </section>

  <section class="section bridge">
    <div class="wrap bridge-inner reveal">
      <p class="eyebrow">What it could lead to</p>
      <h2>Possible outputs</h2>
      <p class="lede">
        To show what working together might produce, here are some possibilities: a <a href="#checklist">belonging checklist</a> for crafting installations, a <a href="#workshop">workshop</a> on belonging, an <a href="#exhibition">exhibition</a> on different types of belonging, exploration of small <a href="#practices">practices</a> to belong in everyday contexts, and a <a href="#sharing">website</a> to share experiences of belonging. All are tentative, and we would like to shape them with collaborators.
      </p>
    </div>
  </section>

  <section class="section wash wash-sand" id="checklist">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow">Example output · Designing a belonging checklist · draft</p>
      </div>
      <div class="grid-2 head">
        <div class="reveal">
          <h2>Designing a space where people can belong</h2>
        </div>
        <div class="reveal">
          <p>
            A set of prompts for anyone designing an installation, ritual, workshop or gathering. It isn’t a recipe, and
            you don’t need to cover every point. It is shown here as an example of what could be relevant: use it to see which parts of the design space you are working in, and
            which you might be missing. We see it as a starting point that could be refined together with collaborators.
          </p>
          <p class="small">
            Compiled (with AI assistance) from our literature notes on belonging, group mindfulness and ritual media
            (Malaver Turbay, 2022), then edited by us.
          </p>
        </div>
      </div>
      <Checklist />
      <div class="collab-actions reveal">
        <a class="button" href="mailto:michael.anslow@gmail.com?cc=zephir.lorne@ens.psl.eu&subject=Designing%20a%20belonging%20checklist">Start a conversation</a>
      </div>
    </div>
  </section>

  <section class="section wash workshop" id="workshop">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow">Example output · a possible workshop</p>
      </div>
      <div class="grid-2 head">
        <div class="reveal">
          <h2>A workshop on making spaces for belonging</h2>
        </div>
        <div class="reveal">
          <p>
            This is an example of what a hands-on workshop for artists, designers, researchers, students and communities
            could look like. It would draw on the <em>arriving, exploring, sharing</em> structure of performative scores in museums (Løppenthin
            et al., 2022). It could also borrow from tinkering and constructionist practice: design an <em>adjacent
            possible</em> that people can lean into, with many ways in.
          </p>
          <p class="small">A possible format, about 2½ hours. It is only a sketch, to be adapted to every group and place.</p>
        </div>
      </div>

      <ol class="movements">
        {
          movements.map((m, i) => (
            <li class="movement reveal">
              <span class="m-num">{i + 1}</span>
              <h3>{m.name}</h3>
              <p class="m-time">{m.time}</p>
              <p>{m.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="grid-2 extra">
        <div class="circle reveal">
          <h3>Guidelines for a sharing circle</h3>
          <p class="small">Inspired by Dharma sharing in the Plum Village tradition.</p>
          <ul>{circleRules.map((r) => <li>{r}</li>)}</ul>
        </div>
        <div class="host reveal">
          <h3>Host it with us</h3>
          <p>
            Would you like to explore a workshop like this at your school, lab, festival or community space? We would be
            glad to shape one together.
          </p>
          <a class="button" href="mailto:michael.anslow@gmail.com?cc=zephir.lorne@ens.psl.eu&subject=A%20workshop%20on%20belonging">Start a conversation</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section wash wash-sky exhibition" id="exhibition">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow">Possible output · an exhibition</p>
      </div>
      <div class="grid-2 head">
        <div class="reveal">
          <h2>An exhibition on belonging</h2>
        </div>
        <div class="reveal">
          <p>
            We would like to bring together installations on different kinds of belonging in one exhibition, and we invite
            artists, designers and researchers to propose their own. <em>Cloudfulness</em> looked at belonging to nature
            through the sky above us; alongside it, other works could explore belonging in other directions.
          </p>
          <p><a class="button" href="mailto:michael.anslow@gmail.com?cc=zephir.lorne@ens.psl.eu&subject=Proposing%20an%20exhibition%20installation">Start a conversation</a></p>
        </div>
      </div>
      <Figure
        src={exhibitionPlan}
        alt="Top-down watercolour view of a mock exhibition building: a campfire room on the left, a meditation room at the top, and a room with a glowing cloud installation on the right, joined by a central hall."
        caption="A mock exhibition bringing belonging to people, to ourselves and to nature together in one building."
        widths={[600, 1024]}
        sizes="(min-width: 72rem) 64rem, 100vw"
        class="exhibition-plan reveal"
      />
      <ul class="belongings">
        {
          belongings.map((b) => (
            <li class="belonging reveal">
              <Image src={b.image} alt={b.alt} widths={[400, 700]} sizes="(min-width: 60rem) 20rem, 100vw" />
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section wash prompts" id="practices">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow">Possible output · everyday practices</p>
        <h2>Designing belonging for everyday contexts</h2>
        <p class="small">Four small practices that could carry belonging beyond an installation, into daily life.</p>
      </div>
      <ol class="prompt-list">
        {prompts.map((p) => <li class="reveal">{p}</li>)}
      </ol>
      <div class="collab-actions reveal">
        <a class="button" href="mailto:michael.anslow@gmail.com?cc=zephir.lorne@ens.psl.eu&subject=Everyday%20practices%20for%20belonging">Start a conversation</a>
      </div>
    </div>
  </section>

  <section class="section wash wash-sky sharing" id="sharing">
    <div class="wrap grid-2">
      <div class="reveal">
        <p class="eyebrow">Possible output · community sharing platform</p>
        <h2>A website for sharing moments of connection</h2>
        <div class="prose" style="margin-top: 1.5rem;">
          <p class="lede">
            By focusing on community sharing, we imagine extending the physical installation into a shared digital space where anyone can contribute their own moments of belonging.
          </p>
          <p>
            Through photos, stories, and personal reflections, participants can share what belonging means to them. This digital space functions as a living, growing collective archive of human belonging and the forms of connection behind that, taking the themes of the installation beyond a single room and inviting a wider public to participate.
          </p>
          <p style="margin-top: 2rem;">
            We found an existing example of a website sharing an individual's photographs of clouds and mindfulness we thought we would share (<em>not affiliated with us</em>):
          </p>
          <div class="collab-actions start reveal" style="margin-top: 1.5rem;">
            <a class="button" href="https://cloudfullness.com/" target="_blank" rel="noopener">Visit cloudfullness.com ↗</a>
            <a class="button" href="mailto:michael.anslow@gmail.com?cc=zephir.lorne@ens.psl.eu&subject=Website%20for%20sharing%20experiences%20of%20belonging">Start a conversation</a>
          </div>
        </div>
      </div>
      <div class="reveal app-image-container">
        <Figure
          src={belongingApp}
          alt="Mockup of the community sharing website, showing sections for 'Moments of belonging', 'Shared moments' with category filter tags, community photos, and community testimonials under 'What people say'."
          widths={[400, 700]}
          sizes="(min-width: 60rem) 30rem, 100vw"
          class="app-image"
        />
      </div>
    </div>
  </section>
{import.meta.env.DEV && (
  <div id="gradient-debug" data-targets='[{"label":"Top (.contact)","selector":".contact"},{"label":"Bottom (.sharing)","selector":".sharing"}]'>
    <div class="gd-header">
      <strong>Gradient debugger</strong>
      <button type="button" data-action="toggle">–</button>
    </div>
    <div class="gd-body"></div>
  </div>
)}

<style is:global>
  #gradient-debug {
    position: fixed;
    top: 12px;
    right: 12px;
    z-index: 9999;
    width: 340px;
    max-height: 90vh;
    overflow: auto;
    background: #111827;
    color: #f3f4f6;
    border: 1px solid #374151;
    border-radius: 8px;
    font: 12px ui-monospace, Menlo, monospace;
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.3);
  }
  #gradient-debug.collapsed .gd-body { display: none; }
  #gradient-debug .gd-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 10px;
    background: #1f2937;
    border-bottom: 1px solid #374151;
    position: sticky;
    top: 0;
  }
  #gradient-debug button {
    background: #374151;
    color: #f3f4f6;
    border: none;
    border-radius: 4px;
    padding: 2px 8px;
    cursor: pointer;
    font: inherit;
  }
  #gradient-debug button:hover { background: #4b5563; }
  #gradient-debug .gd-body { padding: 10px; display: flex; flex-direction: column; gap: 14px; }
  #gradient-debug .gd-section { border: 1px solid #374151; border-radius: 6px; padding: 8px; }
  #gradient-debug .gd-section > h4 { margin: 0 0 8px; font-size: 12px; font-weight: 600; }
  #gradient-debug .gd-row { display: grid; grid-template-columns: 46px 32px 1fr 1fr 1fr; gap: 4px; align-items: center; margin-bottom: 4px; }
  #gradient-debug .gd-row label { font-size: 10px; opacity: 0.7; }
  #gradient-debug input[type="color"] { width: 32px; height: 22px; border: none; background: none; padding: 0; cursor: pointer; }
  #gradient-debug input[type="number"] { width: 100%; background: #1f2937; color: #f3f4f6; border: 1px solid #374151; border-radius: 3px; padding: 2px 4px; font: inherit; }
  #gradient-debug .gd-controls { display: grid; grid-template-columns: 60px 1fr; gap: 4px 8px; align-items: center; margin-bottom: 8px; }
  #gradient-debug textarea { width: 100%; height: 110px; background: #0b1220; color: #f3f4f6; border: 1px solid #374151; border-radius: 4px; padding: 6px; font: 11px ui-monospace, Menlo, monospace; resize: vertical; }
  #gradient-debug .gd-hint { font-size: 10px; opacity: 0.6; margin-top: 4px; }
</style>

<script is:inline>
  (function () {
    const panel = document.getElementById('gradient-debug');
    if (!panel) return;
    const targets = JSON.parse(panel.dataset.targets);
    const body = panel.querySelector('.gd-body');
    const paperHex = getComputedStyle(document.documentElement).getPropertyValue('--paper').trim() || '#f8f7f4';

    panel.querySelector('[data-action="toggle"]').addEventListener('click', () => {
      panel.classList.toggle('collapsed');
      panel.querySelector('[data-action="toggle"]').textContent = panel.classList.contains('collapsed') ? '+' : '–';
    });

    function readVar(el, name, fallback) {
      const v = getComputedStyle(el).getPropertyValue(name).trim();
      return v || fallback;
    }

    function mix(colorHex, paperHex, pct) {
      const toRgb = (h) => {
        const s = h.replace('#','').trim();
        const f = s.length === 3 ? s.split('').map(c=>c+c).join('') : s;
        return [parseInt(f.slice(0,2),16), parseInt(f.slice(2,4),16), parseInt(f.slice(4,6),16)];
      };
      const [r1,g1,b1] = toRgb(colorHex);
      const [r2,g2,b2] = toRgb(paperHex);
      const t = Math.max(0,Math.min(100,pct))/100;
      const r = Math.round(r1*(1-t)+r2*t), g = Math.round(g1*(1-t)+g2*t), b = Math.round(b1*(1-t)+b2*t);
      return '#' + [r,g,b].map(v=>v.toString(16).padStart(2,'0')).join('');
    }

    targets.forEach(({ label, selector }) => {
      const el = document.querySelector(selector);
      if (!el) return;

      const state = {
        angle: parseFloat(readVar(el, '--angle', '180')),
        stops: [1,2,3].map(i => ({
          c: readVar(el, '--c'+i, '#888888'),
          m: parseFloat(readVar(el, '--m'+i, '0')),
          p: parseFloat(readVar(el, '--p'+i, '0')),
        })),
      };

      const section = document.createElement('div');
      section.className = 'gd-section';
      section.innerHTML = `
        <h4>${label}</h4>
        <div class="gd-controls">
          <label>angle°</label>
          <input type="number" data-k="angle" value="${state.angle}" step="1" />
        </div>
        <div class="gd-row"><label></label><label>color</label><label>hex</label><label>% paper</label><label>% pos</label></div>
        ${state.stops.map((s,i)=>`
          <div class="gd-row" data-i="${i}">
            <label>stop ${i+1}</label>
            <input type="color" data-k="c" value="${s.c}" />
            <input type="text" data-k="chex" value="${s.c}" />
            <input type="number" data-k="m" value="${s.m}" step="1" min="0" max="100" />
            <input type="number" data-k="p" value="${s.p}" step="1" min="0" max="100" />
          </div>
        `).join('')}
        <div style="margin-top:8px"><label style="font-size:10px;opacity:.7">CSS snippet</label></div>
        <textarea readonly></textarea>
        <div class="gd-hint">Changes apply live. Copy snippet and paste back into chat.</div>
      `;
      body.appendChild(section);
      const ta = section.querySelector('textarea');

      function apply() {
        el.style.setProperty('--angle', String(state.angle));
        state.stops.forEach((s,i) => {
          el.style.setProperty('--c'+(i+1), s.c);
          el.style.setProperty('--m'+(i+1), String(s.m));
          el.style.setProperty('--p'+(i+1), String(s.p));
        });
        const stopLines = state.stops.map((s,i) =>
          `    --c${i+1}: ${s.c}; --m${i+1}: ${s.m}; --p${i+1}: ${s.p};`).join('\n');
        ta.value = `:global(main) > section.wash${selector},
${selector} {
  --angle: ${state.angle};
${stopLines}
}`;
      }

      section.addEventListener('input', (e) => {
        const t = e.target;
        if (t.dataset.k === 'angle') { state.angle = parseFloat(t.value) || 0; apply(); return; }
        const row = t.closest('[data-i]');
        if (!row) return;
        const i = Number(row.dataset.i);
        if (t.dataset.k === 'c') {
          state.stops[i].c = t.value;
          row.querySelector('[data-k="chex"]').value = t.value;
        } else if (t.dataset.k === 'chex') {
          state.stops[i].c = t.value;
          row.querySelector('[data-k="c"]').value = t.value;
        } else if (t.dataset.k === 'm') {
          state.stops[i].m = parseFloat(t.value) || 0;
        } else if (t.dataset.k === 'p') {
          state.stops[i].p = parseFloat(t.value) || 0;
        }
        apply();
      });

      apply();
    });
  })();
</script>

</Base>

<style>
  .head {
    margin-bottom: 3rem;
  }
  .small {
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .workshop p {
    color: var(--ink-soft);
  }
  .movements {
    list-style: none;
    margin: 0 0 4rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.5rem;
  }
  .movement {
    padding: 1.75rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.45);
    border: 1px solid var(--line);
  }
  .m-num {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    border: 1px solid var(--ink-faint);
    color: var(--ink-soft);
    font-family: var(--font-display);
    margin-bottom: 1.5rem;
  }
  .movement h3 {
    font-size: 1.8rem;
    margin-bottom: 0.2rem;
  }
  .m-time {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint) !important;
  }
  .circle,
  .host {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .circle ul {
    padding-left: 1.1em;
    color: var(--ink-soft);
    display: grid;
    gap: 0.5rem;
  }
  .circle li::marker {
    color: var(--dawn);
  }
  .prompt-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1.5rem;
    counter-reset: p;
  }
  .prompt-list li {
    counter-increment: p;
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.35;
    font-weight: 330;
    padding: 1.75rem;
    border-radius: var(--radius);
    background: linear-gradient(160deg, rgb(154 157 234 / 0.28), rgb(220 167 211 / 0.22) 50%, rgb(249 199 124 / 0.32));
  }
  .prompt-list li::before {
    content: counter(p);
    display: block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--ink-faint);
    margin-bottom: 1rem;
  }

  :global(main) > section.wash.contact,
  .contact {
    --wash-glow: rgb(232 130 100 / 0.22);
    padding-top: clamp(7rem, 12vw, 10rem);
    --angle: 180;
    --c1: #fff75c; --m1: 51; --p1: 0;
    --c2: #ff8629; --m2: 66; --p2: 30;
    --c3: #ea0606; --m3: 90; --p3: 82;
    --stop-1: color-mix(in srgb, var(--paper) calc(var(--m1) * 1%), var(--c1));
    --stop-2: color-mix(in srgb, var(--paper) calc(var(--m2) * 1%), var(--c2));
    --stop-3: color-mix(in srgb, var(--paper) calc(var(--m3) * 1%), var(--c3));
    background:
      radial-gradient(ellipse 60% 80% at 72% 50%, var(--wash-glow), transparent 75%),
      linear-gradient(calc(var(--angle) * 1deg),
        var(--stop-1) calc(var(--p1) * 1%),
        var(--stop-2) calc(var(--p2) * 1%),
        var(--stop-3) calc(var(--p3) * 1%),
        var(--paper) 100%);
  }
  .contact-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .contact-copy {
    position: relative;
    z-index: 1;
  }
  .contact-copy h2 {
    max-width: 12ch;
  }
  .contact-copy .lede {
    max-width: 33rem;
  }
  .collab-list {
    margin: 1rem 0 2rem;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.5rem;
    font-size: 1.15rem;
    line-height: 1.6;
  }
  .collab-list li::marker {
    color: var(--dusk);
  }
  .contact :global(.contact-photo) {
    position: relative;
    z-index: 0;
    margin-left: clamp(-7rem, -6vw, -2rem);
    margin-right: clamp(-4rem, -3vw, 0rem);
  }
  .contact-photo :global(img.main) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  @media (max-width: 860px) {
    .contact-inner {
      grid-template-columns: 1fr;
    }
    .contact :global(.contact-photo) {
      margin: 0;
    }
  }
  .bridge {
    padding-block: clamp(3rem, 6vw, 5rem) 0;
  }
  .bridge-inner {
    max-width: 44rem;
