---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Checklist from '../components/Checklist.astro';
import CloudFrame from '../components/CloudFrame.astro';
import callForBelonging from '../assets/photos/call-for-belonging-flag.jpg';
import Figure from '../components/Figure.astro';
import { Image } from 'astro:assets';
import exhibitionPlan from '../assets/photos/exhibition-top-down.jpg';
import imgPeople from '../assets/photos/belonging-people.jpg';
import imgOurselves from '../assets/photos/belonging-ourselves.jpg';
import imgNature from '../assets/photos/belonging-nature.jpg';
import belongingApp from '../assets/photos/belonging-app.jpg';


const belongings = [
  {
    title: 'To people',
    image: imgPeople,
    alt: 'Friends gathered around a campfire under a crescent moon',
    text: 'Belonging to each other: strangers, friends, families and communities, and what makes us feel seen and accepted.',
  },
  {
    title: 'To ourselves',
    image: imgOurselves,
    alt: 'A person meditating by a window at sunset over rooftops',
    text: 'Belonging in our own bodies, memories and stories: feeling at home in who we are.',
  },
  {
    title: 'To nature',
    image: imgNature,
    alt: 'A walker on a mountain top above the clouds at sunrise',
    text: 'Belonging to the sky, the weather, the living world and the places we share with it.',
  },
];


const prompts = [
  'The next time you see a cloud, take three breaths with it. Where was this water yesterday?',
  'Notice a moment today when someone made you feel you belonged. What exactly did they do?',
  'Think of a place where you belong. Which sense brings it back first — a sound, a smell, a texture?',
  'Offer someone five minutes of listening without replying.',
];
---

<Base title="Collaborate" description="Collaborate with us on workshops, installations and research about belonging. Includes the belonging checklist and an example workshop as examples of what a collaboration could produce.">
  <section class="section wash contact" id="contact">
    <div class="wrap contact-inner">
      <div class="contact-copy reveal">
        <p class="eyebrow">A call for belonging</p>
        <h2>Open to collaborate</h2>
        <p class="lede">
          We really enjoyed working and thinking about belonging and bringing that together to form our cloud. We're more than happy to expand on this work so please reach out!
        </p>
        <a class="button" href="mailto:michael.anslow@gmail.com?cc=zephir.lorne@ens.psl.eu">Start a conversation</a>
      </div>
      <CloudFrame
        src={callForBelonging}
        alt="A lone figure holding a large flag above a sea of clouds at sunrise."
        widths={[500, 800, 1100]}
        sizes="(min-width: 60rem) 42rem, 100vw"
        seed={47}
        class="contact-photo reveal"
      />
    </div>
  </section>

  <section class="section bridge">
    <div class="wrap bridge-inner reveal">
      <p class="eyebrow">What it could lead to</p>
      <h2>Possible outputs</h2>
      <p class="lede">
        To show what working together might produce, here are some possibilities: a <a href="#checklist">belonging checklist</a> for crafting installations, a <a href="#workshop">workshop</a> on belonging, an <a href="#exhibition">exhibition</a> on different types of belonging, exploration of small <a href="#practices">practices</a> to belong in everyday contexts, and a <a href="#sharing">website</a> to share experiences of belonging. All are tentative, and we would like to shape them with collaborators.
      </p>
    </div>
  </section>

  <section class="section wash wash-sand" id="checklist">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow">Example output · Designing a belonging checklist · draft</p>
      </div>
      <div class="grid-2 head">
        <div class="reveal">
          <h2>Designing a space where people can belong</h2>
        </div>
        <div class="reveal">
          <p>
            A checklist for belonging installation at the intersection of art and cognitive science. It isn’t a recipe, and you don’t need to cover every point. It is an example of what could be relevant: use it to see which parts of the design and experience space you are working in. It also serves to help explore this space as a community.
          </p>
          <p class="small">
            Compiled (with AI assistance) from our literature notes on belonging, group mindfulness and ritual media
            (Malaver Turbay, 2022), then edited by us.
          </p>
        </div>
      </div>
      <Checklist />
      <div class="collab-actions reveal">
        <a class="button" href="mailto:michael.anslow@gmail.com?cc=zephir.lorne@ens.psl.eu&subject=Designing%20a%20belonging%20checklist">Start a conversation</a>
      </div>
    </div>
  </section>

  <section class="section wash workshop" id="workshop">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow">Example output · a possible workshop</p>
      </div>
      <div class="grid-2">
        <div class="reveal workshop-main">
          <h2>A workshop on making spaces for belonging</h2>
          <div class="workshop-desc">
            <p>
              We would be open to (co)organising a workshop for artists, designers, researchers, students and communities. Whether to formally explore the concept through an academic lens towards academic papers, or to engaging with it in a creative workshop to explore new belonging creations or just to engage with the topic more to bring belonging into our everyday lives.
            </p>
          </div>
        </div>

        <div class="host reveal">
          <h3>Host it with us</h3>
          <p>
            Would you like to explore a workshop like this at your school, lab, festival or community space? We would be
            glad to shape one together.
          </p>
          <a class="button" href="mailto:michael.anslow@gmail.com?cc=zephir.lorne@ens.psl.eu&subject=A%20workshop%20on%20belonging">Start a conversation</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section wash wash-sky exhibition" id="exhibition">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow">Possible output · an exhibition</p>
      </div>
      <div class="grid-2 head">
        <div class="reveal">
          <h2>An exhibition on belonging</h2>
        </div>
        <div class="reveal">
          <p>
            We would like to bring together installations on different kinds of belonging in one exhibition, and we invite
            artists, designers and researchers to propose their own. <em>Cloudfulness</em> looked at belonging to nature
            through the sky above us; alongside it, other works could explore belonging in other directions.
          </p>
          <p><a class="button" href="mailto:michael.anslow@gmail.com?cc=zephir.lorne@ens.psl.eu&subject=Proposing%20an%20exhibition%20installation">Start a conversation</a></p>
        </div>
      </div>
      <Figure
        src={exhibitionPlan}
        alt="Top-down watercolour view of a mock exhibition building: a campfire room on the left, a meditation room at the top, and a room with a glowing cloud installation on the right, joined by a central hall."
        caption="A mock exhibition bringing belonging to people, to ourselves and to nature together in one building."
        widths={[600, 1024]}
        sizes="(min-width: 72rem) 64rem, 100vw"
        class="exhibition-plan reveal"
      />
      <ul class="belongings">
        {
          belongings.map((b) => (
            <li class="belonging reveal">
              <Image src={b.image} alt={b.alt} widths={[400, 700]} sizes="(min-width: 60rem) 20rem, 100vw" />
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section wash prompts" id="practices">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow">Possible output · everyday practices</p>
        <h2>Designing belonging for everyday contexts</h2>
        <p class="small">Four small practices that could carry belonging beyond an installation, into daily life.</p>
      </div>
      <ol class="prompt-list">
        {prompts.map((p) => <li class="reveal">{p}</li>)}
      </ol>
      <div class="collab-actions reveal">
        <a class="button" href="mailto:michael.anslow@gmail.com?cc=zephir.lorne@ens.psl.eu&subject=Everyday%20practices%20for%20belonging">Start a conversation</a>
      </div>
    </div>
  </section>

  <section class="section wash wash-sky sharing" id="sharing">
    <div class="wrap grid-2">
      <div class="reveal">
        <p class="eyebrow">Possible output · community sharing platform</p>
        <h2>A website for sharing moments of connection</h2>
        <div class="prose" style="margin-top: 1.5rem;">
          <p class="lede">
            By focusing on community sharing, we imagine extending the physical installation into a shared digital space where anyone can contribute their own moments of belonging.
          </p>
          <p>
            Through photos, stories, and personal reflections, participants can share what belonging means to them. This digital space functions as a living, growing collective archive of human belonging and the forms of connection behind that, taking the themes of the installation beyond a single room and inviting a wider public to participate.
          </p>
          <p style="margin-top: 2rem;">
            We found an existing example of a website sharing an individual's photographs of clouds and mindfulness we thought we would share (<em>not affiliated with us</em>):
          </p>
          <div class="collab-actions start reveal" style="margin-top: 1.5rem;">
            <a class="button" href="https://cloudfullness.com/" target="_blank" rel="noopener">Visit cloudfullness.com ↗</a>
            <a class="button" href="mailto:michael.anslow@gmail.com?cc=zephir.lorne@ens.psl.eu&subject=Website%20for%20sharing%20experiences%20of%20belonging">Start a conversation</a>
          </div>
        </div>
      </div>
      <div class="reveal app-image-container">
        <Figure
          src={belongingApp}
          alt="Mockup of the community sharing website, showing sections for 'Moments of belonging', 'Shared moments' with category filter tags, community photos, and community testimonials under 'What people say'."
          widths={[400, 700]}
          sizes="(min-width: 60rem) 30rem, 100vw"
          class="app-image"
        />
      </div>
    </div>
  </section>

</Base>

<style>
  .head {
    margin-bottom: 3rem;
  }
  .small {
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .workshop-desc p {
    font-size: clamp(1.15rem, 1rem + 0.4vw, 1.3rem);
    line-height: 1.6;
    color: var(--ink-soft);
    margin-bottom: 1.5rem;
  }
  .workshop-desc p:last-child {
    margin-bottom: 0;
  }
  .workshop .host {
    border-top: none;
    padding-top: 0;
  }
  .prompt-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1.5rem;
    counter-reset: p;
  }
  .prompt-list li {
    counter-increment: p;
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.35;
    font-weight: 330;
    padding: 1.75rem;
    border-radius: var(--radius);
    background: linear-gradient(160deg, rgb(154 157 234 / 0.28), rgb(220 167 211 / 0.22) 50%, rgb(249 199 124 / 0.32));
  }
  .prompt-list li::before {
    content: counter(p);
    display: block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--ink-faint);
    margin-bottom: 1rem;
  }

  :global(main) > section.wash.contact,
  .contact {
    --wash-glow: rgb(232 130 100 / 0.22);
    padding-top: clamp(7rem, 12vw, 10rem);
    --angle: 180;
    --c1: #fff75c; --m1: 71; --p1: 0;
    --c2: #ff8629; --m2: 73; --p2: 30;
    --c3: #ea0606; --m3: 86; --p3: 71;
    --stop-1: color-mix(in srgb, var(--paper) calc(var(--m1) * 1%), var(--c1));
    --stop-2: color-mix(in srgb, var(--paper) calc(var(--m2) * 1%), var(--c2));
    --stop-3: color-mix(in srgb, var(--paper) calc(var(--m3) * 1%), var(--c3));
    background:
      radial-gradient(ellipse 60% 80% at 72% 50%, var(--wash-glow), transparent 75%),
      linear-gradient(calc(var(--angle) * 1deg),
        var(--stop-1) calc(var(--p1) * 1%),
        var(--stop-2) calc(var(--p2) * 1%),
        var(--stop-3) calc(var(--p3) * 1%),
        var(--paper) 100%);
  }
  .contact-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .contact-copy {
    position: relative;
    z-index: 1;
  }
  .contact-copy h2 {
    max-width: 12ch;
  }
  .contact-copy .lede {
    max-width: 33rem;
  }
  .collab-list {
    margin: 1rem 0 2rem;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.5rem;
    font-size: 1.15rem;
    line-height: 1.6;
  }
  .collab-list li::marker {
    color: var(--dusk);
  }
  .contact :global(.contact-photo) {
    position: relative;
    z-index: 0;
    margin-left: clamp(-7rem, -6vw, -2rem);
    margin-right: clamp(-4rem, -3vw, 0rem);
  }
  .contact-photo :global(img.main) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  @media (max-width: 860px) {
    .contact-inner {
      grid-template-columns: 1fr;
    }
    .contact :global(.contact-photo) {
      margin: 0;
    }
  }
  .bridge {
    padding-block: clamp(3rem, 6vw, 5rem) 0;
  }
  .bridge-inner {
    max-width: 44rem;
  }

  :global(figure.fig.exhibition-plan) {
    max-width: 56rem;
    margin: 0 auto 2rem;
    text-align: center;
  }
  .belongings {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.5rem;
  }
  .belonging {
    padding: 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.45);
  }
  .belonging img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: calc(var(--radius) / 2);
    margin-bottom: 1rem;
  }
  .belonging h3 {
    margin-bottom: 0.4rem;
    font-size: 1.5rem;
  }
  .belonging p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .collab-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    justify-content: center;
    margin-top: 3rem;
  }
  .collab-actions.start {
    justify-content: flex-start;
  }

  :global(main) > section.wash.sharing,
  .sharing {
    padding-block: clamp(4rem, 8vw, 6rem);
    --angle: 0;
    --c1: #5762ff; --m1: 60; --p1: 0;
    --c2: #2e7eff; --m2: 68; --p2: 10;
    --c3: #38b3ff; --m3: 84; --p3: 50;
    --stop-1: color-mix(in srgb, var(--paper) calc(var(--m1) * 1%), var(--c1));
    --stop-2: color-mix(in srgb, var(--paper) calc(var(--m2) * 1%), var(--c2));
    --stop-3: color-mix(in srgb, var(--paper) calc(var(--m3) * 1%), var(--c3));
    background:
      radial-gradient(ellipse 60% 80% at 72% 50%, var(--wash-glow), transparent 75%),
      linear-gradient(calc(var(--angle) * 1deg),
        var(--stop-1) calc(var(--p1) * 1%),
        var(--stop-2) calc(var(--p2) * 1%),
        var(--stop-3) calc(var(--p3) * 1%),
        var(--paper) 100%);
  }
  .app-image-container {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  :global(.app-image) {
    max-width: 28rem;
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.08);
    border-radius: var(--radius);
    overflow: hidden;
  }

  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.page-header),
    .workshop,
    .exhibition,
    .prompts,
    .sharing,
    .contact,
    .bridge,
    .head {
      display: none !important;
    }
  }
</style>
