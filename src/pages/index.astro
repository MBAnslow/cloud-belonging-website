  .call-photo :global(img.main) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  @media (max-width: 860px) {
    .call-inner {
      grid-template-columns: 1fr;
    }
    .call :global(.call-photo) {
      margin: 0;
    }
  }
</style>
