---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import JournalCard from '../components/JournalCard.astro';
import Cloud3D from '../components/Cloud3D.astro';
import VideoClip from '../components/VideoClip.astro';
import { getJournal } from '../lib/journal';
import { site } from '../data/site';

import tulleRaised from '../assets/photos/tulle-raised.jpg';
import cloudPurple from '../assets/photos/cloud-bottom-purple.jpg';
import meshFolds from '../assets/photos/mesh-folds.jpg';
import tulleLight from '../assets/photos/tulle-light-1.jpg';
import tulleLight4 from '../assets/photos/tulle-light-4.jpg';
import meshTeam from '../assets/photos/mesh-team.jpg';
import alphaCloudRoom from '../assets/photos/alpha-cloud-room.jpg';
import alphaMagenta from '../assets/photos/alpha-magenta.jpg';
import buildSkewers from '../assets/photos/build-skewers.jpg';
import buildFrameAssembly from '../assets/photos/build-frame-assembly.jpg';
import buildShell from '../assets/photos/build-shell.jpg';

const latest = (await getJournal()).slice(0, 3);

const doors = [
  {
    href: '/installation/',
    eyebrow: '1 · The work',
    title: 'Installation',
    text: 'A cloud that sets with the sun, blooms with colour through a magical twilight, then breathes with you. How it works and how it was made.',
    image: alphaCloudRoom,
    alt: 'The alpha cloud of white fibre glowing pale pink above white sheets, with a teapot on a small pedestal below.',
  },
  {
    href: '/concept/',
    eyebrow: '2 · Concept',
    title: 'Belonging',
    text: 'A need almost as basic as water, renewed in small acts. Why it matters, and why art is a good place to explore it.',
    image: meshTeam,
    alt: 'Michael and Zéphir smiling in the studio, holding up a sheet of green mesh.',
  },
  {
    href: '/process/',
    eyebrow: '3 · How we worked',
    title: 'Process',
    text: 'Research-creation as it happened: material tests, conversations, the alpha, and the lessons we learned along the way.',
    image: buildShell,
    alt: 'Holding a shell of white fibre and hexagonal mesh overhead in the workshop.',
  },
  {
    href: '/toolkit/',
    eyebrow: '4 · For you',
    title: 'Checklist',
    text: 'A tentative checklist of things to consider when designing for belonging, and a workshop in development.',
    image: tulleRaised,
    alt: 'Zéphir holding a bunch of white tulle up towards the ceiling like a small cloud.',
  },
];

const method = [
  {
    step: 'Read',
    text: 'We started from the research on belonging, group contemplative practice and ritual, and from the lessons of the Réespiration study.',
    link: { href: '/concept/', label: 'The concept' },
  },
  {
    step: 'Make',
    text: 'We turned those ideas into materials, light, sensors and a score, building and testing the cloud piece by piece in the studio.',
    link: { href: '/installation/#fabrication', label: 'How the cloud is made' },
  },
  {
    step: 'Listen',
    text: 'We lay under it with other people, shared it in public, and let what we noticed reshape the work, then wrote down what we learned.',
    link: { href: '/process/#lessons', label: 'Lessons learned' },
  },
];

const tried = [
  { image: meshFolds, alt: 'A hand holding folded green plastic mesh.', caption: 'Plastic mesh and zip ties' },
  { image: tulleLight, alt: 'A tulle cloud lit in pale blue from below, hanging near a ceiling.', caption: 'Layers of tulle' },
  { image: cloudPurple, alt: 'Fibre glowing purple from LEDs inside.', caption: 'LEDs inside the cloud' },
  { image: tulleLight4, alt: 'A tulle cloud lit green and blue from below.', caption: 'A projector as the sun' },
  { image: buildFrameAssembly, alt: 'A mesh-wrapped wooden frame strung with LED pixels.', caption: 'A pyramid of LED pixels' },
  { image: buildSkewers, alt: 'Hands pinning fibre into hexagonal mesh with a bamboo skewer.', caption: 'Fibre pinned with skewers' },
  { image: alphaMagenta, alt: 'The alpha cloud glowing magenta, seen from a beanbag.', caption: 'The alpha, July 2026' },
];
---

<Base overlayHeader>
  <section class="hero" data-cloud-tone="global" data-tone="dark">
    <Cloud3D
      mode="cycle"
      initial="golden"
      cycle={['golden', 'dusk', 'twilight', 'breath', 'dawn', 'day']}
      place={[0.68, 0.12, 0.56]}
      placeNarrow={[0, 0.58, 0.3]}
    />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-content">
      <p class="eyebrow">A research-creation installation<br />Paris, 2026</p>
      <h1>{site.title}</h1>
      <p class="hero-lede">
        A cloud installation and a call for belonging. To ourselves, each other and nature. Under the sky we all live
        under and look up to.
      </p>
      <div class="hero-actions">
        <a class="button solid-light" href={url("/installation/")}>See the installation</a>
        <a class="button" href={url("/concept/")}>Why belonging</a>
      </div>
    </div>
    <a class="scroll-hint" href="#invitation" aria-label="Scroll to introduction">
      <span></span>
    </a>
  </section>

  <section id="invitation" class="section">
    <div class="wrap grid-2">
      <div class="reveal">
        <p class="eyebrow">An invitation</p>
        <h2 class="statement">
          Belonging isn’t something we have. It is something that happens — between people, and between people and
          the places they share.
        </h2>
      </div>
      <div class="reveal intro-text">
        <p class="lede">
          In 2026 we made <em>Cloudfulness</em>: a cloud you lie beneath. It watches the sun set with you, blooms with
          colour through a magical twilight, and then breathes with you.
        </p>
        <p>
          The installation is our example of one kind of belonging: belonging to nature, to the weather, water and sky we
          all share. We made it as research-creation, an artist-researcher and a creative technologist learning by
          reading, building and trying it with people.
        </p>
        <p>This site holds:</p>
        <ol class="three">
          <li><strong>The installation</strong>: how the cloud works, why it is the way it is, and how it was made.</li>
          <li><strong>Belonging</strong>: why we think it matters, and how the cloud puts it into practice.</li>
          <li><strong>Our process</strong>: a journal of what we tried, the false starts, and the lessons we learned.</li>
          <li><strong>A checklist</strong>: a tentative list of things to consider when designing for belonging.</li>
          <li><strong>An invitation</strong> to take belonging further in your own art and research.</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section tried dark">
    <div class="wrap">
      <div class="tried-head">
        <div class="reveal">
          <p class="eyebrow">The installation</p>
          <h2>From a crumpled sheet of mesh to a cloud full of light</h2>
          <p class="tried-lede">
            The cloud above is a simulation. This one is real: our alpha, built at the end of July 2026 from polyester
            fibre, bamboo skewers and a pyramid of LED pixels, with lightning flickering through it.
          </p>
        </div>
        <VideoClip name="alpha-dusk" caption="The alpha cloud in the studio, 30 July 2026." class="reveal" />
      </div>
      <div class="strip">
        {
          tried.map((t) => (
            <Figure src={t.image} alt={t.alt} caption={t.caption} ratio="3 / 4" widths={[360, 600]} sizes="(min-width: 60rem) 18rem, 70vw" class="reveal" />
          ))
        }
      </div>
      <a class="button" href={url("/installation/#fabrication")}>See how it is made</a>
    </div>
  </section>

  <section class="section doors-section">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Explore the project</p>
        <h2>Four ways in</h2>
      </div>
      <div class="doors">
        {
          doors.map((d) => (
            <a class="door reveal" href={url(d.href)}>
              <Figure src={d.image} alt={d.alt} ratio="4 / 5" widths={[400, 700, 900]} sizes="(min-width: 60rem) 18rem, 100vw" />
              <p class="eyebrow">{d.eyebrow}</p>
              <h3>{d.title} <span aria-hidden="true">→</span></h3>
              <p>{d.text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section method">
    <div class="wrap">
      <div class="grid-2 method-head">
        <div class="reveal">
          <p class="eyebrow">Research-creation</p>
          <h2>Making the work was how we asked the question</h2>
        </div>
        <p class="reveal lede">
          In research-creation, making and studying happen together. The cloud wasn’t only the result of our research
          on belonging. It was the way we did it.
        </p>
      </div>
      <ol class="method-steps">
        {
          method.map((m, i) => (
            <li class="reveal">
              <span class="m-num">{i + 1}</span>
              <h3>{m.step}</h3>
              <p>{m.text}</p>
              <a href={url(m.link.href)}>{m.link.label} →</a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="latest-head reveal">
        <div>
          <p class="eyebrow">From the process journal</p>
          <h2>Latest notes</h2>
        </div>
        <a class="button" href={url("/process/")}>All entries</a>
      </div>
      <div class="grid-3">
        {latest.map((entry) => <JournalCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section call">
    <div class="wrap measure reveal">
      <p class="eyebrow">A call for belonging</p>
      <h2>We explored one kind of belonging. There are many more.</h2>
      <p class="lede">
        <em>Cloudfulness</em> looked at belonging to nature: to weather, water and the sky above us. Belonging to
        ourselves, to each other, to places and to communities need artists and researchers just as much.
      </p>
      <p class="lede">
        Take the checklist, borrow our process, make your own work, and tell us what you find.
      </p>
      <div class="call-actions">
        <a class="button solid" href={url("/toolkit/")}>Use the belonging checklist</a>
        <a class="button" href={url("/about/#contact")}>Get in touch</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    --hero-fg: #fbfaff;
    --hero-fg-soft: rgb(251 250 255 / 0.82);
    --hero-shade: rgb(27 34 80 / 0.55);
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: var(--hero-fg);
    transition: color 2s ease;
  }
  .hero[data-tone='light'] {
    --hero-fg: #1f2650;
    --hero-fg-soft: rgb(31 38 80 / 0.78);
    --hero-shade: rgb(248 247 244 / 0.55);
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 10% 90%, var(--hero-shade), transparent 70%);
    transition: background 2s ease;
    pointer-events: none;
  }
  .hero-content {
    position: relative;
    padding-block: 10rem clamp(5rem, 12vh, 8rem);
  }
  .hero .eyebrow {
    color: var(--hero-fg-soft);
    transition: color 2s ease;
  }
  .hero h1 {
    font-size: clamp(3.2rem, 1.8rem + 6vw, 7rem);
    color: var(--hero-fg);
    margin-bottom: 1.25rem;
    transition: color 2s ease;
  }
  .hero-lede {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.05rem + 0.9vw, 1.75rem);
    line-height: 1.38;
    font-weight: 300;
    max-width: 24ch;
    color: var(--hero-fg-soft);
    transition: color 2s ease;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .hero .button {
    transition: background 0.25s, color 2s, border-color 2s;
  }
  .hero .button:hover {
    background: var(--hero-fg);
    color: var(--night);
  }
  .hero[data-tone='light'] .button:hover {
    color: var(--paper);
  }
  .button.solid-light {
    background: var(--hero-fg);
    color: var(--night);
    border-color: var(--hero-fg);
  }
  .hero[data-tone='light'] .button.solid-light {
    color: var(--paper);
  }
  .button.solid-light:hover {
    background: var(--amber) !important;
    border-color: var(--amber);
    color: var(--night) !important;
  }
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    width: 1.5rem;
    height: 2.4rem;
    margin-left: -0.75rem;
    border: 1px solid currentColor;
    opacity: 0.6;
    border-radius: 999px;
  }
  .scroll-hint span {
    position: absolute;
    left: 50%;
    top: 0.45rem;
    width: 3px;
    height: 0.5rem;
    margin-left: -1.5px;
    background: currentColor;
    border-radius: 2px;
    animation: hint 2.4s ease-in-out infinite;
  }
  @keyframes hint {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
    }
    80% {
      opacity: 0;
      transform: translateY(0.8rem);
    }
    100% {
      opacity: 0;
    }
  }
  @media (max-width: 760px) {
    .scroll-hint {
      display: none;
    }
  }

  .statement {
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3.3rem);
    font-weight: 300;
  }
  .intro-text {
    padding-top: 2.2rem;
  }
  .three {
    padding-left: 1.2em;
    display: grid;
    gap: 0.8rem;
    color: var(--ink-soft);
  }
  .three li::marker {
    font-family: var(--font-display);
    color: var(--dusk);
  }

  .section-head {
    margin-bottom: 2.5rem;
  }
  .doors {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .method {
    background: linear-gradient(180deg, var(--paper), var(--paper-deep));
  }
  .method-head {
    margin-bottom: 3rem;
    align-items: end;
  }
  .method-head .lede {
    margin: 0;
  }
  .method-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  .method-steps li {
    padding-top: 1.5rem;
    border-top: 1px solid var(--ink);
  }
  .method-steps p {
    color: var(--ink-soft);
  }
  .method-steps a {
    color: var(--ink);
    font-size: 0.92rem;
  }
  .m-num {
    display: block;
    font-family: var(--font-display);
    color: var(--dusk);
    margin-bottom: 0.8rem;
  }
  .call-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 1rem;
  }
  .door {
    text-decoration: none;
    display: block;
  }
  .door :global(figure) {
    margin-bottom: 1.25rem;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .door :global(img) {
    transition: transform 1.2s ease;
  }
  .door:hover :global(img) {
    transform: scale(1.04);
  }
  .door .eyebrow {
    margin-bottom: 0.4rem;
  }
  .door h3 {
    font-size: 1.75rem;
  }
  .door h3 span {
    display: inline-block;
    transition: transform 0.3s;
  }
  .door:hover h3 span {
    transform: translateX(0.3rem);
  }
  .door p:last-child {
    color: var(--ink-soft);
  }

  .tried-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    margin-bottom: 3rem;
  }
  .tried-lede {
    color: var(--ink-soft);
  }
  @media (max-width: 860px) {
    .tried-head {
      grid-template-columns: 1fr;
    }
  }
  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(14rem, 1fr);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
    margin-bottom: 2.5rem;
  }
  .strip :global(figure) {
    scroll-snap-align: start;
  }
  .strip :global(figcaption) {
    color: var(--ink-soft);
  }

  .latest-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .latest-head h2 {
    margin: 0;
  }

  .call {
    text-align: center;
    background: linear-gradient(180deg, var(--paper), var(--cream));
  }
  .call .measure {
    margin-inline: auto;
  }
</style>
