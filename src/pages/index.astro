    text-align: center;
  }
  .featured-block {
    margin-top: clamp(1.25rem, 3vw, 2.25rem);
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
  }
  .featured-heading {
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
