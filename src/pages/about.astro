---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import zephirExplains from '../assets/photos/zephir-explains-hands-up.jpg';
import { site } from '../data/site';
import CloudFrame from '../components/CloudFrame.astro';
import together from '../assets/team/together.jpg';
import { url } from '../lib/url';

// Ordered left to right, as they appear in the photo.
const order = ['Michael Anslow', 'Zéphir Lorne'];
const team = [...site.team].sort((a, b) => order.indexOf(a.name) - order.indexOf(b.name));
---

<Base title="About" description="The people, context and sources behind Cloudfulness, a research-creation project on belonging.">
  <PageHeader
    eyebrow="About"
    image={zephirExplains}
    imageAlt="Zéphir presenting the Cloudfulness concept at the Académie du Climat in Paris."
    title="Who, where and for what?"
    lede="Cloudfulness began as a research-creation project at Sony CSL Paris at the intersection of cognitive science, contemplative practice, art and creative technology."
  />

  <section class="section">
    <div class="wrap">
      <p class="eyebrow reveal">Team</p>
      <h2 class="team-title reveal">Two people under a cloud</h2>
      <figure class="team-photo reveal">
        <div class="photo-frame">
          <CloudFrame
            seed={11}
            keep={[[27, 46, 21, 29], [61, 42, 15, 24]]}
            src={together}
            alt="Selfie of Michael and Zéphir underneath the cloud's white mesh shell, Michael smiling on the left, Zéphir laughing and waving on the right."
            widths={[800, 1300, 1500]}
            sizes="(min-width: 72rem) 72rem, 100vw"
          />
        </div>
        <div class="callouts">
          {
            team.map((person, i) => (
              <article class="callout">
                <h3>{person.name}</h3>
                <p class="role">{person.role}</p>
                <p class="bio">{person.bio}</p>
                <div class="profile-links" aria-label={`${person.name} links`}>
                  <a href={person.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
                  <a href={person.website} target="_blank" rel="noreferrer">Website</a>
                  <a href={`mailto:${person.email}`}>Email</a>
                </div>
              </article>
            ))
          }
        </div>
        <figcaption>Under the outer shell of the cloud while we were building it, July 2026.</figcaption>
      </figure>
      <p class="collab-pointer reveal">
        Interested in working with us? <a href={url('/collaborate/')}>See how to collaborate <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>
</Base>

<style>
  .team-title {
    max-width: 20ch;
    margin-bottom: 1.25rem;
  }
  .team-photo {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    grid-template-areas: 'photo people' 'caption people';
    column-gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .photo-frame {
    grid-area: photo;
    width: min(100%, calc((100svh - 14rem) * 1.3));
    justify-self: center;
  }
  .team-photo figcaption {
    grid-area: caption;
    text-align: center;
  }
  .photo-frame {
    position: relative;
    color: var(--ink-soft, currentColor);
  }
  @media (max-width: 900px) {
    .team-photo {
      grid-template-columns: 1fr;
      grid-template-areas: 'photo' 'caption' 'people';
    }
    .callouts {
      grid-template-columns: 1fr 1fr;
    }
  }
  .callouts {
    grid-area: people;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }
  .callout {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .callout h3 {
    margin: 0 0 0.15rem;
    font-size: clamp(1.35rem, 1.1rem + 0.7vw, 1.7rem);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .role {
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--ink-soft);
  }
  .bio {
    margin: 0;
    max-width: 34rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-faint, var(--ink-soft));
  }
  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }
  .profile-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
  }
  .profile-links a:hover {
    border-color: var(--ink-soft);
    color: var(--ink);
  }
  .team-photo figcaption {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  @media (max-width: 760px) {
    .callouts {
      grid-template-columns: 1fr;
    }
  }
  .collab-pointer {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
  }
  .collab-pointer a {
    color: var(--ink);
  }
</style>
