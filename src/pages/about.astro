---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import talkSlide from '../assets/photos/talk-slide.jpg';
import { site } from '../data/site';
import { references } from '../data/references';
import { Image } from 'astro:assets';
import together from '../assets/team/together.jpg';

// Ordered left to right, as they appear in the photo.
const order = ['Michael Anslow', 'Zéphir Lorne'];
const team = [...site.team].sort((a, b) => order.indexOf(a.name) - order.indexOf(b.name));
const themes = [...new Set(references.map((r) => r.theme))];
---

<Base title="About" description="The people, context and sources behind Cloudfulness, a research-creation project on belonging.">
  <PageHeader
    eyebrow="About"
    image={talkSlide}
    imageAlt="Zéphir presenting the project at the Académie du Climat in Paris."
    title="Who, where, and with whose help"
    lede="Cloudfulness began as a research-creation internship in 2026. It sits where cognitive science, contemplative practice, art and creative technology meet."
  />

  <section class="section">
    <div class="wrap">
      <p class="eyebrow reveal">Team</p>
      <h2 class="team-title reveal">Two people under a cloud</h2>
      <figure class="team-photo reveal">
        <div class="photo-frame">
          <Image
            src={together}
            alt="Selfie of Michael and Zéphir underneath the cloud's white mesh shell, Michael smiling on the left, Zéphir laughing and waving on the right."
            widths={[800, 1300, 1500]}
            sizes="(min-width: 72rem) 72rem, 100vw"
          />
        </div>
        <div class="callouts">
          {
            team.map((person, i) => (
              <article class="callout">
                <p class="callout-num">{String(i + 1).padStart(2, '0')}</p>
                <h3>{person.name}</h3>
                <p class="role">{person.role}</p>
                <p class="bio">{person.bio}</p>
              </article>
            ))
          }
        </div>
        <figcaption>Under the outer shell of the cloud while we were building it, July 2026.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      <div class="reveal">
        <p class="eyebrow">Context</p>
        <h2>Research-creation</h2>
      </div>
      <div class="reveal">
        <p>
          In research-creation, making the work and studying it happen together. We build something, invite people in,
          and listen carefully, through first-person accounts as much as measurements. What we learn goes back into the
          work.
        </p>
        <p>
          The project grew out of Zéphir’s research-creation proposal <em>A Space For You</em> and the <em>Réespiration</em>
          pilot study Zéphir has been running. It was developed during an internship at <a href="https://csl.sony.fr/">Sony CSL Paris</a>,
          alongside <a href="https://csl.sony.fr/projects/funiki/">Funiki</a>, a project on dynamic light and sound atmospheres.
        </p>
        <p>
          With thanks to everyone who shared their time and ideas along the way, including Amos Blanton, Joanna, Alice
          and Ben.
        </p>
      </div>
    </div>
  </section>

  <section class="section contact dark" id="contact">
    <div class="wrap grid-2">
      <div class="reveal">
        <p class="eyebrow">Contact</p>
        <h2>Host it, try it, think with us</h2>
      </div>
      <div class="reveal">
        <p class="lede">
          We’d love to hear from venues interested in hosting the installation, groups who would like to try the
          workshop, and artists and researchers exploring belonging in their own work.
        </p>
        {
          site.contactEmail ? (
            <a class="button" href={`mailto:${site.contactEmail}`}>
              {site.contactEmail}
            </a>
          ) : (
            <p class="pending">Contact details coming soon.</p>
          )
        }
      </div>
    </div>
  </section>

  <section class="section" id="references">
    <div class="wrap">
      <div class="refs-head reveal">
        <p class="eyebrow">Sources</p>
        <h2>What we read</h2>
        <p class="measure">
          A selection from our literature review. These readings shaped our thinking about belonging, group practice,
          ritual and interactive experience.
        </p>
      </div>
      <div class="refs">
        {
          themes.map((theme) => (
            <div class="theme reveal">
              <h3>{theme}</h3>
              <ul>
                {references
                  .filter((r) => r.theme === theme)
                  .map((r) => (
                    <li>
                      {r.url ? <a href={r.url}>{r.citation}</a> : r.citation}
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .team-title {
    max-width: 20ch;
    margin-bottom: 2rem;
  }
  .team-photo {
    margin: 0;
  }
  .photo-frame {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 30px 80px -40px rgb(91 76 180 / 0.6), 0 0 0 1px rgb(255 255 255 / 0.6);
  }
  .photo-frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .callouts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-top: 2rem;
  }
  .callout {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .callout-num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--dusk);
    margin-bottom: 0.3rem;
  }
  .callout h3 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    margin-bottom: 0.3rem;
  }
  .role {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dusk);
    margin-bottom: 0.75rem;
  }
  .bio {
    color: var(--ink-soft);
    margin: 0;
  }
  .team-photo figcaption {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  @media (max-width: 760px) {
    .callouts {
      grid-template-columns: 1fr;
    }
  }
  .contact .pending {
    color: var(--ink-faint);
    font-style: italic;
  }
  .refs-head {
    margin-bottom: 3rem;
  }
  .refs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 3rem;
  }
  .theme h3 {
    font-size: 1.35rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--line);
  }
  .theme ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .theme li {
    font-size: 0.9rem;
    color: var(--ink-soft);
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
  }
  .theme a {
    text-decoration: none;
  }
  .theme a:hover {
    text-decoration: underline;
  }
</style>
