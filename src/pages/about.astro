---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import talkSlide from '../assets/photos/talk-slide.jpg';
import { site } from '../data/site';
import { references } from '../data/references';
import CloudFrame from '../components/CloudFrame.astro';
import together from '../assets/team/together.jpg';
import callForBelonging from '../assets/photos/call-for-belonging-flag.jpg';

// Ordered left to right, as they appear in the photo.
const order = ['Michael Anslow', 'Zéphir Lorne'];
const team = [...site.team].sort((a, b) => order.indexOf(a.name) - order.indexOf(b.name));
const themes = [...new Set(references.map((r) => r.theme))];
---

<Base title="About" description="The people, context and sources behind Cloudfulness, a research-creation project on belonging.">
  <PageHeader
    eyebrow="About"
    image={talkSlide}
    imageAlt="Zéphir presenting the project at the Académie du Climat in Paris."
    title="Who, where and for what?"
    lede="Cloudfulness began as a research-creation project at Sony CSL Paris at the intersection of cognitive science, contemplative practice, art and creative technology."
  />

  <section class="section">
    <div class="wrap">
      <p class="eyebrow reveal">Team</p>
      <h2 class="team-title reveal">Two people under a cloud</h2>
      <figure class="team-photo reveal">
        <div class="photo-frame">
          <CloudFrame
            seed={11}
            keep={[[27, 46, 21, 29], [61, 42, 15, 24]]}
            src={together}
            alt="Selfie of Michael and Zéphir underneath the cloud's white mesh shell, Michael smiling on the left, Zéphir laughing and waving on the right."
            widths={[800, 1300, 1500]}
            sizes="(min-width: 72rem) 72rem, 100vw"
          />
        </div>
        <div class="callouts">
          {
            team.map((person, i) => (
              <article class="callout">
                <h3>{person.name}</h3>
                <p class="role">{person.role}</p>
                <p class="bio">{person.bio}</p>
              </article>
            ))
          }
        </div>
        <figcaption>Under the outer shell of the cloud while we were building it, July 2026.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section wash contact" id="contact">
    <div class="wrap contact-inner">
      <div class="contact-copy reveal">
        <p class="eyebrow">A call for belonging</p>
        <h2>Open to collaborate and explore belonging</h2>
        <p class="lede">
          Our next space, our next installation, our next research-creation iteration, our next conceptual leap in
          understanding and our next new acquaintances.
        </p>
        <p class="lede">
          We welcome venues, researchers, artists and communities who want to explore and build belonging together.
        </p>
        {
          site.contactEmail ? (
            <a class="button" href={`mailto:${site.contactEmail}`}>
              {site.contactEmail}
            </a>
          ) : (
            <p class="pending">Contact details coming soon.</p>
          )
        }
      </div>
      <CloudFrame
        src={callForBelonging}
        alt="A lone figure holding a large flag above a sea of clouds at sunrise."
        widths={[500, 800, 1100]}
        sizes="(min-width: 60rem) 42rem, 100vw"
        seed={47}
        class="contact-photo reveal"
      />
    </div>
  </section>

  <section class="section" id="references">
    <div class="wrap">
      <div class="refs-head reveal">
        <p class="eyebrow">Sources</p>
        <h2>What we read</h2>
        <p class="measure">
          A selection from our literature review. These readings shaped our thinking about belonging, group practice,
          ritual and interactive experience.
        </p>
      </div>
      <div class="refs">
        {
          themes.map((theme) => (
            <div class="theme reveal">
              <h3>{theme}</h3>
              <ul>
                {references
                  .filter((r) => r.theme === theme)
                  .map((r) => (
                    <li>
                      {r.url ? <a href={r.url}>{r.citation}</a> : r.citation}
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .team-title {
    max-width: 20ch;
    margin-bottom: 1.25rem;
  }
  .team-photo {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    grid-template-areas: 'photo people' 'caption people';
    column-gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .photo-frame {
    grid-area: photo;
    width: min(100%, calc((100svh - 14rem) * 1.3));
    justify-self: center;
  }
  .team-photo figcaption {
    grid-area: caption;
    text-align: center;
  }
  .photo-frame {
    position: relative;
    color: var(--ink-soft, currentColor);
  }
  @media (max-width: 900px) {
    .team-photo {
      grid-template-columns: 1fr;
      grid-template-areas: 'photo' 'caption' 'people';
    }
    .callouts {
      grid-template-columns: 1fr 1fr;
    }
  }
  .callouts {
    grid-area: people;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }
  .callout {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .callout h3 {
    margin: 0 0 0.15rem;
    font-size: clamp(1.35rem, 1.1rem + 0.7vw, 1.7rem);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .role {
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--ink-soft);
  }
  .bio {
    margin: 0;
    max-width: 34rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-faint, var(--ink-soft));
  }
  .team-photo figcaption {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  @media (max-width: 760px) {
    .callouts {
      grid-template-columns: 1fr;
    }
  }
  .contact .pending {
    color: var(--ink-faint);
    font-style: italic;
  }
  .contact {
    --wash-glow: rgb(232 130 100 / 0.22);
  }
  .contact-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .contact-copy {
    position: relative;
    z-index: 1;
  }
  .contact-copy h2 {
    max-width: 12ch;
  }
  .contact-copy .lede {
    max-width: 33rem;
  }
  .contact :global(.contact-photo) {
    position: relative;
    z-index: 0;
    margin-left: clamp(-7rem, -6vw, -2rem);
    margin-right: clamp(-4rem, -3vw, 0rem);
  }
  .contact-photo :global(img.main) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  @media (max-width: 860px) {
    .contact-inner {
      grid-template-columns: 1fr;
    }
    .contact :global(.contact-photo) {
      margin: 0;
    }
  }
  .refs-head {
    margin-bottom: 3rem;
  }
  .refs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 3rem;
  }
  .theme h3 {
    font-size: 1.35rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--line);
  }
  .theme ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .theme li {
    font-size: 0.9rem;
    color: var(--ink-soft);
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
  }
  .theme a {
    text-decoration: none;
  }
  .theme a:hover {
    text-decoration: underline;
  }
</style>
