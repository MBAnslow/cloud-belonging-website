---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SkyPhases from '../components/SkyPhases.astro';
import BreathChart from '../components/BreathChart.astro';
import VideoClip from '../components/VideoClip.astro';
import Figure from '../components/Figure.astro';

import meshZephir from '../assets/photos/mesh-zephir.jpg';
import tulleAssembly from '../assets/photos/tulle-assembly.jpg';
import tulleLight2 from '../assets/photos/tulle-light-2.jpg';
import beltSketch from '../assets/photos/belt-sketch.jpg';
import printFrame from '../assets/photos/print-frame-1.jpg';
import alphaWarm from '../assets/photos/alpha-warm.jpg';
import alphaLyingBlue from '../assets/photos/alpha-lying-blue.jpg';
import buildFrameAssembly from '../assets/photos/build-frame-assembly.jpg';
import buildSkewers from '../assets/photos/build-skewers.jpg';

import cloudMaterials from '../assets/photos/cloud-materials.jpg';
import ledLightingDiagram from '../assets/photos/led-lighting-diagram.jpg';
import swSimulator from '../assets/software/simulator.png';
import swMapping from '../assets/software/mapping.png';
import swSkyTimeline from '../assets/software/simulator-sky-timeline.png';
import swLightning from '../assets/software/simulator-lightning.png';
import swDrones from '../assets/software/drones.png';
import swSamples from '../assets/software/samples.png';
import swPads from '../assets/software/pads.png';

const outerLayers = [
  {
    name: 'Cotton',
    text: 'The outermost layer and the one you see. Pulled into tufts, it gives the cloud its billowing, cumulus surface.',
  },
  {
    name: 'Polyester fleece wadding',
    text: 'A thicker layer of wadding under the cotton. It gives the cloud its body and softens the light again on its way out.',
  },
  {
    name: 'White mesh',
    text: 'A white plastic mesh with hexagonal cells, shaped into the cloud’s outline. It is the shell that holds the soft layers in place.',
  },
  {
    name: 'Nylon diffuser fabric',
    text: 'The first thing the light meets. It spreads each point of light out before it reaches the wadding, so no single LED shows through as a hot spot.',
  },
];

const innerLayers = [
  {
    name: 'Inner mesh frame',
    text: 'A square-grid mesh that forms the core of the cloud and carries the lights.',
  },
  {
    name: 'Addressable LEDs',
    text: 'Individually controllable LED pixels (for example WS2811), fixed across the frame. Each can take its own colour and brightness, which makes gradients, lightning, colour blooms and breathing light possible.',
  },
  {
    name: 'Directionality cylinders',
    text: 'A short card tube around each LED aims its light outwards, so each pixel lights its own patch of the cloud instead of washing into its neighbours.',
  },
  {
    name: 'Support struts',
    text: 'Tubes of rolled mesh, rising from the frame, hold the outer layers at a distance from the lights.',
  },
  {
    name: 'Black fabric layer',
    text: 'Underneath the frame, a black fabric stops light escaping backwards, so it only leaves through the diffusing layers.',
  },
];

const belongingMap = [
  {
    quality: 'Belonging is embodied and anchored',
    choice: 'A multisensory space.',
    how: ' You take off your shoes and lie down beneath the cloud, among soft fabric, warm light and a glass of tea.',
  },
  {
    quality: 'Belonging is a journey',
    choice: 'An evolving score.',
    how: ' Dusk, a magical twilight, then breath synchrony: the experience moves, and you move with it.',
  },
  {
    quality: 'Belonging is dynamic',
    choice: 'Biofeedback.',
    how: ' A sensor follows your breathing, and the cloud’s light rises and settles with it. You breathe with the cloud rather than control it.',
  },
  {
    quality: 'Belonging depends on the quality of connections',
    choice: 'A shared experience.',
    how: ' One sky over everyone in the room, with nobody in a better seat.',
  },
];

const whyCloud = [
  { title: 'It is above everyone', text: 'Nobody has a better seat. A cloud offers a shared perspective without a stage.' },
  { title: 'It gives light a body', text: 'A cloud is a volume for light to live in — glowing, flashing, catching the sun.' },
  { title: 'It is always changing', text: 'Clouds are impermanence made visible. They form, drift, rain and form again.' },
  { title: 'It is water, and so are we', text: 'The water cycle is continuity and unity: the same water in vapour, rain, river, tea, and us.' },
  { title: 'It follows you home', text: 'Everyone sees clouds. We hope the next one you see brings a little of this back.' },
  { title: 'It is forgiving', text: 'Dim, diffuse light feels primal and hides the imperfections of whatever room we are in.' },
];

const tour = [
  {
    kicker: 'LED mapping',
    title: 'Placing 344 lights on a lumpy cloud',
    img: swMapping,
    alt: 'The LED mapping page: a wireframe model of the pyramid-shaped cloud on a grid, with numbered blue dots for each LED and control panels on both sides.',
    caption: 'The mapping page. Each numbered dot is a physical LED, placed in strand order.',
    body: [
      'We modelled the cloud’s shape in Blender and loaded it into the mapping page. Then we placed the LEDs on it one by one, in the order they run along the physical strand, lighting each real LED to check it was in the right spot.',
      'A smooth model is not a cloud, so we added 48 soft “domes” over the surface where the real cloud billows. They lift nearby LEDs and change how light reaches them, so a pixel tucked in a fold sits in shadow and one on a crest catches the light. A movable test light, which can stream straight to the cloud, let us check the mapping by eye.',
    ],
  },
  {
    kicker: 'Colour',
    title: 'Choosing colours on a 24-hour sky',
    img: swSkyTimeline,
    wide: true,
    alt: 'The sky timeline: a row of day periods (magical night, dawn, day, dusk, night) above tracks for lightning, breath, and gradient tracks of colour stops for the sun, moon and ambient light.',
    caption: 'The sky timeline. Periods across the top, then colour stops for sun, moon and ambient light.',
    body: [
      'The day is split into periods: magical night, dawn, day, dusk and night. Below them sit three colour tracks, for the sun, the moon and the ambient sky, each with its own draggable colour stops. The sun and moon move on physically plausible arcs, and their colours blend smoothly between stops.',
      'We chose the colours by eye, not by formula. We dragged a stop, watched the real cloud change, and kept what felt like a sky: the violets and ambers of our palette, deep blues at night, and hue-preserving brightness so sunset oranges don’t bleach to white.',
    ],
  },
  {
    kicker: 'Lightning',
    title: 'Bolts, strikes and sprites',
    img: swLightning,
    alt: 'The lightning panel: a storm intensity curve keyframed across dusk, night, magical night and dawn, three colour gradient tracks for the bolts, rate and shape sliders, and a library of thunder and sprite sounds and images.',
    caption: 'The lightning panel. Storm intensity across the night, bolt colours, shape, and a library of thunder sounds.',
    body: [
      'Lightning is simulated as branching bolts that crawl through the cloud’s 3D volume, lighting the LEDs they pass. There are in-cloud flashes, ground strikes, and image “sprites”: pictures projected through the cloud in a short strobe, which became the strange flashes of the magical twilight.',
      'Storm intensity is keyframed across the night, building from dusk into the magical twilight. Each bolt takes its colours from three gradient tracks, so a flash can move from pale gold to magenta to green. Every flash also picks a thunder recording that matches its length and intensity, arriving a moment later like real thunder.',
    ],
  },
  {
    kicker: 'Sound · drones',
    title: 'A score written across the day',
    img: swDrones,
    alt: 'The drones page: a piano roll spanning 24 hours with a few long blue notes, and controls for oscillator waveform, an ADSR envelope, tremolo and distortion.',
    caption: 'Drones on a 24-hour piano roll, with oscillator, envelope and tremolo.',
    body: [
      'The soundscape is composed on the same 24-hour clock as the light. A drone synth and a warm pad synth each have a piano roll that spans the whole day, so a note might hold for hours of sky time, from dusk into night.',
      'Drones are built from slow, layered sine tones, with a tiny drift that dissolves beating between close intervals into a soft chorus.',
    ],
  },
  {
    kicker: 'Sound · pads',
    title: 'Warm chords that change with the light',
    img: swPads,
    alt: 'The pads page: a piano roll across the 24-hour day with chord notes, and synth controls with keyframe curves for each parameter.',
    caption: 'The pad synth, with its own piano roll and parameters keyframed across the day.',
    body: [
      'Above the drones sits a warm pad synth: several detuned voices per note, spread across the stereo field, then through saturation, chorus, reverb and delay.',
      'Its chords are written on the same day clock, clustered through the night and early morning. Any parameter can be keyframed across the day. Here the filter cutoff rises and falls, so the pads open up and soften again as the light on the cloud changes.',
    ],
  },
  {
    kicker: 'Sound · samples',
    title: 'Birdsong, bells and the breath of the room',
    img: swSamples,
    alt: 'The samples page: a library of sound files with waveforms on the left, arranged as orange clips on lanes across a 24-hour timeline, with automation curves for volume and effects.',
    caption: 'Samples arranged on lanes across the day, with automation for volume, pan, filter, reverb and delay.',
    body: [
      'Recorded sounds are dragged from a library onto lanes on the day timeline: morning birdsong, dusk ambience, gentle and reversed bells, chimes. Each lane has its own curves for volume, pan, filter, reverb and delay.',
      'Breath plays its part too. Each out-breath can trigger a soft sound, and how much of the cloud is lit by breath feeds back into the mix. The room hears itself breathing with the cloud.',
    ],
  },
];

const glow = 'stroke="url(#toc-glow)"';
const icons = {
  concept: `<path d="M13 34h22a7 7 0 0 0 .5-14A10 10 0 0 0 17 18a8 8 0 0 0-4 16Z"/><path ${glow} d="M17 27c5-4 10 3 15-1"/><path ${glow} fill="#f6b89c" stroke="none" d="M31 9l1.2 3.3L35.5 13.5l-3.3 1.2L31 18l-1.2-3.3-3.3-1.2 3.3-1.2Z"/>`,
  narrative: `<path d="M6 34h36"/><path ${glow} d="M14 34a10 10 0 0 1 20 0"/><path d="M30 12a7 7 0 1 0 6 10 6 6 0 0 1-6-10Z"/><path ${glow} d="M10 40h8M22 40h16"/>`,
  fabrication: `<path d="M24 8 40 16 24 24 8 16Z"/><path ${glow} d="M8 23l16 8 16-8"/><path d="M8 30l16 8 16-8"/>`,
  making: `<path d="M6 30c4 0 4-10 8-10s4 14 8 14 4-18 8-18 4 12 8 12 3-4 4-4"/><circle cx="22" cy="34" r="2.2" fill="#c3b6f0" stroke="none"/><circle cx="30" cy="16" r="2.2" fill="#f6b89c" stroke="none"/><path ${glow} d="M6 40h36"/>`,
};

const contents = [
  { id: 'concept', label: 'Concept', desc: 'Belonging to nature, and why a cloud' },
  { id: 'narrative', label: 'Narrative', desc: 'Dusk, magical twilight, breath synchrony' },
  { id: 'fabrication', label: 'Fabrication', desc: 'The final cloud, layer by layer' },
  { id: 'making', label: 'Technical details', desc: 'Materials, light, breath sensing, frame, software' },
];
---

<Base title="Installation" description="Cloudfulness, a breathing cloud installation about belonging to nature: the concept, the narrative, fabrication and technical details.">
  <PageHeader
    eyebrow="The installation"
    image={alphaLyingBlue}
    imageAlt="People lying on the floor beneath the glowing cloud, lit blue."
    title="A cloud that listens"
    lede="A cloud hangs above you. The sun sets, lightning begins, and then the whole cloud starts to bloom with colour. Then the cloud begins to breathe with you.">
    <p class="status">
      <span class="dot" aria-hidden="true"></span>
      <span>
        <em>Cloudfulness</em>. Three stages: dusk, magical twilight, breath synchrony. First alpha
        built and tested in July 2026.
      </span>
    </p>
  </PageHeader>

  <nav class="contents" aria-label="On this page">
    <div class="wrap">
      <svg width="0" height="0" aria-hidden="true" style="position:absolute">
        <linearGradient id="toc-glow" x1="0" x2="1">
          <stop offset="0" stop-color="#b3a4ee"></stop>
          <stop offset="1" stop-color="#f6a98a"></stop>
        </linearGradient>
      </svg>
      <p class="eyebrow ruled">On this page</p>
      <ol>
        {
          contents.map((c, i) => (
            <li>
              <a href={`#${c.id}`}>
                <svg class="icon" viewBox="0 0 48 48" aria-hidden="true">
                  <Fragment set:html={icons[c.id as keyof typeof icons]} />
                </svg>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <span class="label">{c.label}</span>
                <span class="desc">{c.desc}</span>
                <span class="arrow" aria-hidden="true">↓</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </nav>

  <section class="section built-in" id="concept">
    <div class="wrap grid-2">
      <div class="reveal">
        <p class="eyebrow">An example of belonging</p>
        <h2>Belonging to nature, built into a room</h2>
        <p>
          Belonging to ourselves, to each other and to nature are always connected. <em>Cloudfulness</em> leans towards
          nature: a shared sky, weather and water, something larger that was here before us and will continue after.
        </p>
        <p>
          We started from what the research says belonging is, and turned each quality into a design choice.{' '}
          <a href={url('/belonging/')}>More on belonging →</a>
        </p>
      </div>
      <dl class="mapping reveal">
        {
          belongingMap.map((m) => (
            <div>
              <dt>{m.quality}</dt>
              <dd>
                <strong>{m.choice}</strong>
                {m.how}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap why-cloud">
      <div class="why-text">
        <p class="eyebrow reveal">Why a cloud</p>
        <h2 class="reveal">Something we all live under</h2>
        <div class="why-grid">
          {
            whyCloud.map((w) => (
              <div class="why reveal">
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </div>
            ))
          }
        </div>
      </div>
      <Figure
        src={alphaWarm}
        alt="Looking up from the floor at the fibre cloud glowing warm white, hanging from the ceiling in a dark room."
        caption="Looking up at the alpha cloud, 29 July 2026."
        ratio="3 / 4"
        widths={[400, 700, 1000]}
        sizes="(min-width: 60rem) 22rem, 100vw"
        class="reveal why-video"
      />
    </div>
  </section>

  <SkyPhases />

  <section class="section fabrication" id="fabrication">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Fabrication</p>
        <h2>The final cloud, layer by layer</h2>
        <p class="lede measure">
          After months of trying mesh, tulle and fibre, this is how the finished cloud is made: a glowing core of light,
          wrapped in four soft layers that turn hundreds of points of light into one diffuse glow.
        </p>
      </div>

      <Figure
        src={cloudMaterials}
        alt="Diagram of the cloud's layers. Left: the outer layers, from outside to inside, are cotton, polyester fleece wadding, white hexagonal mesh and nylon diffuser fabric. Right: the inner layer, with addressable LEDs set in card directionality cylinders on an inner mesh frame, a rolled-mesh support strut, and a black fabric layer underneath."
        caption="The materials and layers of the final cloud."
        widths={[600, 1024]}
        sizes="(min-width: 72rem) 64rem, 100vw"
        class="reveal fab-diagram"
      />

      <div class="fab-layers">
        <div class="reveal">
          <h3>Outer layers <span>outside → inside</span></h3>
          <ol class="layer-list">
            {
              outerLayers.map((l) => (
                <li>
                  <strong>{l.name}</strong>
                  <p>{l.text}</p>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="reveal">
          <h3>Inner layer <span>the core of light</span></h3>
          <ul class="layer-list">
            {
              innerLayers.map((l) => (
                <li>
                  <strong>{l.name}</strong>
                  <p>{l.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section making" id="making">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Making</p>
        <h2>How a cloud gets built</h2>
        <p class="lede measure">
          How we got to the final cloud: what we tried, what surprised us, and what we learned.
        </p>
      </div>

      <article class="make">
        <div class="make-text reveal">
          <p class="make-num">01 · Body</p>
          <h3>From chicken mesh to tulle to fibre</h3>
          <p>
            Our first cloud was plastic chicken mesh, crumpled into folds and held with zip ties. It was easy to cut
            and shape, but heavy-looking and opaque. Then we tried tulle. A single layer is almost transparent, very
            light, and catches light beautifully.
          </p>
          <p>
            For the alpha we returned to the loose polyester fibre of our first lit cloud bottom, the kind used to stuff
            cushions. Layered over a white hexagonal mesh and pinned in place with bamboo skewers, it hides the individual
            lights and turns them into a soft glow with darker folds.
          </p>
          <p>
            <a href={url("/process/2026-05-21-mesh-and-tulle/")}>Mesh and tulle →</a>
            <br />
            <a href={url("/process/2026-07-30-the-alpha-cloud/")}>Fibre and skewers →</a>
          </p>
        </div>
        <div class="make-media three">
          <Figure src={meshZephir} alt="Zéphir shaping green plastic mesh on the studio floor." caption="Mesh, May 2026." ratio="3 / 4" class="reveal" />
          <Figure src={tulleAssembly} alt="Zéphir fixing layers of tulle to a stand." caption="Tulle, June 2026." ratio="3 / 4" class="reveal" />
          <Figure src={buildSkewers} alt="Hands pinning fibre into hexagonal mesh with a bamboo skewer." caption="Fibre, July 2026." ratio="3 / 4" class="reveal" />
        </div>
      </article>

      <article class="make">
        <div class="make-text reveal">
          <p class="make-num">02 · Light</p>
          <h3>A glow inside, a sun below</h3>
          <p>
            LEDs inside the cloud make it glow from within. An addressable LED matrix could create gradients, travelling
            light and lightning. Lit from the floor by a projector, the tulle throws beams and casts its shadow onto the
            ceiling. That gave us the idea that the audience might be the sun.
          </p>
          <p>
            In the alpha, rows of addressable LED pixels are tied across a pyramid inside the fibre, driven by an ESP32
            controller. Before anyone lay underneath, we checked the wiring with a thermal camera.
          </p>
          <p><a href={url("/process/2026-06-24-breath-as-sound/")}>Read about being the sun →</a></p>
        </div>
        <div class="make-media three">
          <VideoClip name="cloud-led" orientation="portrait" caption="LEDs inside the cloud." class="reveal" />
          <VideoClip name="led-matrix" orientation="portrait" caption="LED matrix test." class="reveal" />
          <Figure src={tulleLight2} alt="The tulle cloud lit blue and green near the ceiling." caption="Projected light through tulle." ratio="9 / 16" class="reveal" />
        </div>
      </article>

      <article class="make" id="breath">
        <div class="make-text reveal">
          <p class="make-num">03 · Breath</p>
          <h3>A belt that listens</h3>
          <p>
            Each participant wears a light belt with a stretch sensor. A tiny ESP32-C3 board sends the reading
            wirelessly as OSC messages to TouchDesigner, which detects the start of each in- and out-breath. Below are
            real recordings from our tests with different band widths and amounts of stretch, all on the same scale.
          </p>
          <p><a href={url("/process/2026-06-12-a-belt-that-listens/")}>Read about the belt →</a></p>
        </div>
        <div class="make-media">
          <Figure src={beltSketch} alt="Sketch of a vest with a breathing sensor band around the torso." caption="Early design sketch for the breathing vest." class="reveal" />
        </div>
      </article>
      <div class="reveal chart">
        <BreathChart />
      </div>

      <article class="make">
        <div class="make-text reveal">
          <p class="make-num">04 · Sound</p>
          <h3>Wind that turns into chimes</h3>
          <p>
            We imagine the soundscape moving from field recordings (wind in bare trees, a distant dawn chorus)
            towards something more musical as the experience builds. Each out-breath becomes a sound object that drifts up
            and plays the cloud. Notes arriving together form chords, and held chords swell into drones. Thunder
            answers lightning.
          </p>
          <p>
            One idea we are exploring is generative audio morphs. A generative audio model partially denoises a nature
            recording towards a prompt like “wind chimes”, and we pre-render a continuum of steps between the two to
            crossfade as the room synchronises.
          </p>
        </div>
        <div class="make-media sound-card reveal">
          <p class="eyebrow">Listening list</p>
          <ul>
            <li>Varandas — <em>Slow Down the Wind, the Clouds Need a Break</em></li>
            <li>Timothy Garrett — <em>Divergent Paths</em></li>
            <li>World of White Ice — <em>Frost</em></li>
            <li>Luke Kokoszka</li>
            <li>Field recordings: wind, bare trees, dawn chorus</li>
          </ul>
        </div>
      </article>

      <article class="make">
        <div class="make-text reveal">
          <p class="make-num">05 · Structure</p>
          <h3>A skeleton for something soft</h3>
          <p>
            Soft materials won’t hold a shape on their own. We 3D-printed joints, slotted wooden dowels into them to make a
            low pyramid, wrapped it in the same green mesh as our first cloud, and spray-painted the whole thing white so
            it wouldn’t tint the light. It carries the LEDs, and the fibre shell hangs around it.
          </p>
          <p><a href={url("/process/2026-07-22-a-pyramid-of-light/")}>Read about the frame →</a></p>
        </div>
        <div class="make-media two">
          <Figure src={printFrame} alt="A 3D printer printing a white frame part." caption="Printing joints, July 2026." ratio="4 / 5" class="reveal" />
          <Figure src={buildFrameAssembly} alt="Looking up through a mesh-wrapped wooden frame with LED pixels tied along it." caption="The pyramid, strung with LEDs." ratio="4 / 5" class="reveal" />
        </div>
      </article>

      <article class="make software" id="software">
        <div class="make-text reveal">
          <p class="make-num">06 · Software</p>
          <h3>A vibe-coded instrument and a digital twin</h3>
          <p>
            There was no off-the-shelf tool for lighting a cloud, so we made one. The software was
            <em>vibe coded</em>: written in conversation with AI coding assistants, one idea at a time. We described
            what we wanted to see or hear, tried it on the real cloud, and asked for the next change. What grew out of
            that is less an app than an instrument, built in TypeScript with React and three.js.
          </p>
          <p>
            At its centre is a <strong>digital twin</strong>: a 3D model of the cloud with every one of its 344 LEDs
            placed where it really sits. Five pages share one 24-hour sky clock, so light, lightning, breath and sound
            all follow the same day. Whatever the twin shows is streamed live to the physical LEDs.
          </p>
          <p class="pipeline">
            TouchDesigner (breath) → relay → browser (simulation and audio) → relay → WLED controller (LEDs)
          </p>
          <p>
            <a class="button" href="https://github.com/MBAnslow/cloud-point-cloud-led" target="_blank" rel="noopener">
              View the code on GitHub ↗
            </a>
          </p>
        </div>
        <Figure
          src={swSimulator}
          alt="The simulator: a dark 3D view of the cloud model dotted with glowing LED hemispheres, a 24-hour sky timeline with colour stops across the top, and panels for LED view, breath, lightning and sound."
          caption="The simulator. The cloud’s digital twin, with the sky timeline above."
          widths={[800, 1400, 2000]}
          sizes="(min-width: 72rem) 40rem, 100vw"
          class="reveal"
        />
      </article>

      <div class="twin reveal" id="led-lighting">
        <div class="twin-text">
          <p class="make-num">How each LED gets its colour</p>
          <h3>Light probes on a virtual cloud</h3>
          <ol class="twin-steps">
            <li>
              <strong>A virtual surface.</strong> In the digital twin, a smooth 3D mesh is placed over the pyramid frame
              to approximate the cloud’s shape. It is used only for the lighting calculations.
            </li>
            <li>
              <strong>Probes sample the sky.</strong> At each <em>light probe</em> on that surface, we average the light
              arriving over a hemisphere of directions from the sun, moon and sky. Directions blocked by the cloud’s own
              surface are left out.
            </li>
            <li>
              <strong>Many probes, many values.</strong> Probes are spread across the whole surface. Those on top, open to
              the sky, receive more light. Those in crevices receive less, shaded by the cloud itself.
            </li>
            <li>
              <strong>A value for every probe.</strong> Each probe stores a brightness and colour, giving a map of light
              over the whole cloud.
            </li>
            <li>
              <strong>Probes to LEDs.</strong> Each physical LED inside the cloud takes the value of its nearest probe, or
              a blend of nearby probes, which carries the calculated lighting onto the real lights.
            </li>
            <li>
              <strong>The cloud lights up.</strong> Driven by those values, the LEDs reproduce the highlights and shadows
              across the surface, so a simple frame of lights reads as one bumpy, volumetric cloud.
            </li>
          </ol>
        </div>
        <Figure
          src={ledLightingDiagram}
          alt="Diagram in six steps. 1: a smooth virtual mesh over the pyramid frame, dotted with light probes. 2: a probe averages incoming light over a hemisphere, ignoring directions blocked by the cloud surface. 3: many probes across the cloud; those on top get more light, those in crevices less. 4: each probe stores a lighting value, shown as a heat map from bright to dark. 5: each LED inside the pyramid takes the value of its nearest probe or an interpolation of nearby ones. 6: the result, a cloud glowing with realistic highlights and shadows."
          caption="How the digital twin lights each LED, from virtual surface to physical lights."
          widths={[600, 1024]}
          sizes="(min-width: 72rem) 64rem, 100vw"
        />
      </div>

      <div class="tour">
        {
          tour.map((t) => (
            <div class:list={['tour-row reveal', { wide: t.wide }]}>
              <div class="tour-text">
                <p class="make-num">{t.kicker}</p>
                <h3>{t.title}</h3>
                {t.body.map((p) => <p>{p}</p>)}
              </div>
              <Figure src={t.img} alt={t.alt} caption={t.caption} widths={[800, 1400, 2000]} sizes="(min-width: 72rem) 44rem, 100vw" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

</Base>

