<script>
  const illustrationParams = new URLSearchParams(location.search);
  if (illustrationParams.has('illustration-debug') && !document.querySelector('.illustration-debug')) {
    const head = document.querySelector<HTMLElement>('.schematic-head');
    if (head) {
      const settings = {
        top: 1,
        right: 2,
        width: 36,
        opacity: 0.07,
        glow: 0.12,
        height: 12,
      };
      const controls: [keyof typeof settings, string, number, number, number][] = [
        ['top', 'Top offset (rem)', -6, 12, 0.25],
        ['right', 'Right offset (vw)', -18, 12, 0.5],
        ['width', 'Width (vw)', 30, 120, 1],
        ['opacity', 'Opacity', 0, 1, 0.01],
        ['glow', 'Blue glow strength', 0, 1, 0.01],
        ['height', 'Header min-height (rem)', 10, 36, 0.5],
      ];

      const apply = () => {
        head.style.setProperty('--schematic-ill-top', `${settings.top}rem`);
        head.style.setProperty('--schematic-ill-right', `${settings.right}vw`);
        head.style.setProperty('--schematic-ill-width', `${settings.width}vw`);
        head.style.setProperty('--schematic-ill-opacity', `${settings.opacity}`);
        head.style.setProperty('--schematic-ill-glow', `${settings.glow}`);
        head.style.setProperty('--schematic-head-height', `${settings.height}rem`);
      };

      const panel = document.createElement('div');
      panel.className = 'illustration-debug';
      panel.innerHTML = `<strong>Cloud illustration</strong>${controls
        .map(
          ([key, label, min, max, step]) =>
            `<label>${label}<span><input type="range" name="${key}" min="${min}" max="${max}" step="${step}" value="${settings[key]}"><output>${settings[key]}</output></span></label>`,
        )
        .join('')}<button type="button">Copy values</button>`;
      panel.addEventListener('input', (e) => {
        const input = e.target as HTMLInputElement;
        settings[input.name as keyof typeof settings] = Number(input.value);
        input.nextElementSibling!.textContent = input.value;
        apply();
      });
      panel.querySelector('button')!.addEventListener('click', (e) => {
        navigator.clipboard.writeText(JSON.stringify(settings));
        (e.target as HTMLButtonElement).textContent = 'Copied';
      });
      Object.assign(panel.style, {
        position: 'fixed', right: '1rem', bottom: '1rem', zIndex: '9999', width: '18rem', padding: '0.9rem 1rem',
        display: 'grid', gap: '0.55rem', font: '12px/1.3 system-ui, sans-serif', color: '#111',
        background: 'rgba(255,255,255,0.94)', border: '1px solid #ccc', borderRadius: '8px', boxShadow: '0 6px 24px rgba(0,0,0,0.15)',
      });
      panel.querySelectorAll('label').forEach((l) => Object.assign(l.style, { display: 'grid', gap: '0.2rem' }));
      panel.querySelectorAll('label span').forEach((s) => Object.assign((s as HTMLElement).style, { display: 'flex', gap: '0.5rem', alignItems: 'center' }));
      panel.querySelectorAll('input').forEach((i) => (i.style.flex = '1'));
      document.body.append(panel);
      apply();
    }
  }
</script>

