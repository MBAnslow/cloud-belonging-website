---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SkyPhases from '../components/SkyPhases.astro';
import BreathSync from '../components/BreathSync.astro';
import BreathChart from '../components/BreathChart.astro';
import VideoClip from '../components/VideoClip.astro';
import Figure from '../components/Figure.astro';

import meshZephir from '../assets/photos/mesh-zephir.jpg';
import tulleAssembly from '../assets/photos/tulle-assembly.jpg';
import tulleLight2 from '../assets/photos/tulle-light-2.jpg';
import beltSketch from '../assets/photos/belt-sketch.jpg';
import printFrame from '../assets/photos/print-frame-1.jpg';
import visitCeiling from '../assets/photos/visit-cloud-ceiling.jpg';
import visitFire from '../assets/photos/visit-tv-fire.jpg';
import visitStars from '../assets/photos/visit-stars.jpg';
import alphaLyingUnder from '../assets/photos/alpha-lying-under.jpg';
import alphaCloudRoom from '../assets/photos/alpha-cloud-room.jpg';
import alphaMagenta from '../assets/photos/alpha-magenta.jpg';
import alphaTeaRitual from '../assets/photos/alpha-tea-ritual.jpg';
import alphaControl from '../assets/photos/alpha-control.jpg';
import alphaAmber from '../assets/photos/alpha-amber.jpg';
import buildDowels from '../assets/photos/build-dowels.jpg';
import buildFrameAssembly from '../assets/photos/build-frame-assembly.jpg';
import buildPyramidCourtyard from '../assets/photos/build-pyramid-courtyard.jpg';
import buildLedCloud from '../assets/photos/build-led-cloud.jpg';
import buildSkewersMesh from '../assets/photos/build-skewers-mesh.jpg';
import buildShell from '../assets/photos/build-shell.jpg';
import buildThermal from '../assets/photos/build-thermal.jpg';
import buildStuffing from '../assets/photos/build-stuffing.jpg';
import buildSkewers from '../assets/photos/build-skewers.jpg';

const alphaMosaic = [
  { src: alphaLyingUnder, wide: true, alt: 'A person lies on white sheets beneath the glowing fibre cloud, in front of a blue backdrop.' },
  { src: alphaCloudRoom, wide: false, alt: 'The cloud glowing pale pink above white sheets, with a teapot on a small pedestal below.' },
  { src: alphaMagenta, wide: false, alt: 'The cloud glowing magenta and violet, seen from a beanbag on the floor.' },
  { src: alphaTeaRitual, wide: true, alt: 'Pouring tea beneath the cloud, lit blue, while someone watches from a beanbag.' },
  { src: alphaControl, wide: true, alt: 'The cloud glowing magenta, with breath waveforms in TouchDesigner on a laptop in the foreground.' },
  { src: alphaAmber, wide: false, alt: 'A smiling selfie, pointing up at the cloud glowing warm amber.' },
];

const buildSteps = [
  { src: buildDowels, date: '21 Jul', caption: 'Dowels and printed joints', alt: 'Wooden dowels and 3D-printed joints laid out on the workshop floor.' },
  { src: buildFrameAssembly, date: '21 Jul', caption: 'LED pixels tied to a mesh pyramid', alt: 'Looking up through a mesh-wrapped wooden frame with LED pixels tied along it.' },
  { src: buildPyramidCourtyard, date: '22 Jul', caption: 'Painted white in the courtyard', alt: 'The painted pyramid drying on cardboard in a narrow courtyard.' },
  { src: buildLedCloud, date: '24 Jul', caption: 'First fibre over the lights', alt: 'A mound of fibre glowing violet on top of a frame of LED pixels.' },
  { src: buildSkewersMesh, date: '24 Jul', caption: 'Fibre pinned with bamboo skewers', alt: 'Close-up of fibre on hexagonal mesh, held by bamboo skewers.' },
  { src: buildThermal, date: '28 Jul', caption: 'Checking for heat', alt: 'A thermal camera reading 27.4 °C, pointed at wiring on the floor.' },
  { src: buildShell, date: '28 Jul', caption: 'Judging the shape of the shell', alt: 'Holding the fibre and mesh shell overhead in the workshop.' },
  { src: buildStuffing, date: '29 Jul', caption: 'Final shaping, from below', alt: 'Lying beneath the lit cloud, pushing a skewer up into the fibre.' },
];

const whyCloud = [
  { title: 'It is above everyone', text: 'Nobody has a better seat. A cloud offers a shared perspective without a stage.' },
  { title: 'It gives light a body', text: 'A cloud is a volume for light to live in — glowing, flashing, catching the sun.' },
  { title: 'It is always changing', text: 'Clouds are impermanence made visible. They form, drift, rain and form again.' },
  { title: 'It is water, and so are we', text: 'The water cycle is continuity and unity: the same water in vapour, rain, river, tea, and us.' },
  { title: 'It follows you home', text: 'Everyone sees clouds. We hope the next one you see brings a little of this back.' },
  { title: 'It is forgiving', text: 'Dim, diffuse light feels primal and hides the imperfections of whatever room we are in.' },
];

const decisions = [
  {
    choice: 'Breath as the interface',
    why: 'Breath is both voluntary and involuntary, and everyone has it. Breathing in rhythm with something is one of the simplest forms of co-regulation. It also builds on what Zéphir learned from Réespiration.',
  },
  {
    choice: 'Breathing with the cloud, not controlling it',
    why: 'We want people to feel that they belong with the cloud, not that they are in charge of it. Its light follows the rise and fall of your respiration, like a companion keeping time with you, rather than obeying commands.',
  },
  {
    choice: 'Lightning at dusk',
    why: 'People arrive carrying their day. As the sun sets, the first lightning pulls attention into the room and towards weather: nature as vast, a little wild, and very present.',
  },
  {
    choice: 'A magical twilight before the breath',
    why: 'The twilight turns the experience into a story. As its light intensifies and colours flare up through the whole cloud at once, the cloud gains a presence and a character. By the time it begins to breathe with you, a bond is already there.',
  },
  {
    choice: 'Lying down, shoes off',
    why: 'Posture changes the role you play. Lying on the floor under a sky turns a visitor into an inhabitant, and the small ritual of preparation already begins the shared experience.',
  },
  {
    choice: 'No instructions about feelings',
    why: 'Being told to feel connected is the fastest way not to be. The space offers conditions and a little mystery, and leaves the story to the people in it.',
  },
];

const openQuestions = [
  'How do we invite someone to breathe with the cloud without instructing them?',
  'How much of the twilight’s story should be told, and how much left to the imagination?',
  'Should there be a goal (“save a cloud”) or only an invitation?',
  'Where should it live: a gallery, a public space, a train carriage, a boat?',
  'How does the bond with the cloud carry on after you leave?',
];
---

<Base title="The Cloud" description="The concept, score and construction of a breathing cloud installation: why a cloud, the phases of the experience, and what we tried.">
  <PageHeader
    eyebrow="The work"
    title="A cloud that listens"
    lede="A cloud hangs above you. The sun sets, lightning begins, and then the whole cloud starts to bloom with colour. Then the cloud begins to breathe with you.">
    <p class="status">
      <span class="dot" aria-hidden="true"></span>
      <span>
        <em>Cloudfulness</em>. Three stages: dusk, magical twilight, breath synchrony. First alpha
        built and tested in July 2026.
      </span>
    </p>
  </PageHeader>

  <section class="section">
    <div class="wrap why-cloud">
      <div class="why-text">
        <p class="eyebrow reveal">Why a cloud</p>
        <h2 class="reveal">Something we all live under</h2>
        <div class="why-grid">
          {
            whyCloud.map((w) => (
              <div class="why reveal">
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </div>
            ))
          }
        </div>
      </div>
      <VideoClip
        name="tulle-projector"
        orientation="portrait"
        caption="A tulle cloud test, lit from below by a projector (June 2026)."
        class="reveal why-video"
      />
    </div>
  </section>

  <SkyPhases />

  <section class="section dark alpha" id="alpha">
    <div class="wrap">
      <div class="grid-2 alpha-head">
        <div class="reveal">
          <p class="eyebrow">The alpha · 29–30 July 2026</p>
          <h2>A cloud you can lie under</h2>
        </div>
        <div class="reveal">
          <p>
            At the end of July we built the first full cloud: loose polyester fibre pinned over a mesh shell, with a
            pyramid of LED pixels glowing inside. We closed off a corner of the studio with a blue backdrop and black
            panels, laid white sheets on the floor, and kept a pot of tea warm under the cloud.
          </p>
          <p>
            Over two days, people lay and sat beneath it while it moved through amber, violet, magenta and blue, lightning
            flickered through the fibre, and the breath belts streamed into TouchDesigner.
          </p>
          <p><a href={url('/process/2026-07-30-the-alpha-cloud/')}>Read the full story of the alpha →</a></p>
        </div>
      </div>

      <div class="alpha-clips">
        <VideoClip name="alpha-dusk" caption="Lightning and a warm, setting light (30 July)." class="reveal" />
        <VideoClip name="alpha-twilight" caption="Violet, magenta and green (29 July)." class="reveal" />
      </div>

      <div class="mosaic">
        {
          alphaMosaic.map((m) => (
            <Figure
              src={m.src}
              alt={m.alt}
              class:list={['reveal', { wide: m.wide }]}
              widths={m.wide ? [600, 900, 1400] : [400, 700]}
              sizes={m.wide ? '(min-width: 60rem) 48rem, 100vw' : '(min-width: 60rem) 24rem, 100vw'}
            />
          ))
        }
      </div>

      <div class="build-head reveal">
        <p class="eyebrow">Ten days of building</p>
        <p class="small">From printed joints to a cloud on the ceiling, 20–29 July 2026. Scroll sideways.</p>
      </div>
      <div class="build-strip">
        {
          buildSteps.map((b) => (
            <Figure
              src={b.src}
              alt={b.alt}
              caption={`${b.date} · ${b.caption}`}
              ratio="3 / 4"
              widths={[360, 600]}
              sizes="(min-width: 60rem) 16rem, 60vw"
              class="reveal"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section dark sim">
    <div class="wrap">
      <div class="grid-2 sim-head">
        <div class="reveal">
          <p class="eyebrow">Simulating before building</p>
          <h2>An early walk-through in 3D</h2>
        </div>
        <div class="reveal">
          <p>
            Before building at full scale, we made a simulation of the room to think through the experience. Breaths
            are shown as waves with their own rate, depth and phase, and a <em>synchrony</em> measure rises as they
            align. Lightning can be tuned for frequency and intensity.
          </p>
          <p class="small">
            This recording is from July 2026, when the score still ended at sunrise. The final score is the three stages
            above.
          </p>
        </div>
      </div>
      <VideoClip name="simulation" ratio="1280 / 636" caption="Screen recording of the July 2026 simulation." class="reveal" />
    </div>
  </section>

  <section class="section try">
    <div class="wrap">
      <div class="grid-2 try-head">
        <div class="reveal">
          <p class="eyebrow">Try it</p>
          <h2>Breath synchrony, in your browser</h2>
        </div>
        <div class="reveal">
          <p>
            In the installation, a sensor follows your real breathing. Here, a button stands in for it. Your breath is
            the large cloud, which swells and glows as you breathe in. The smaller clouds drift at their own rhythms,
            and as you breathe slowly and steadily they gradually fall into step with you. Hold the rhythm long enough
            and the sky brightens.
          </p>
          <p class="small">
            This playful web version extends the idea beyond the installation. The small clouds are modelled as coupled
            oscillators (a Kuramoto model), the same maths often used to describe fireflies flashing in unison.
          </p>
        </div>
      </div>
      <div class="reveal">
        <BreathSync />
      </div>
    </div>
  </section>

  <section class="section decisions">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">How we reasoned</p>
        <h2>Why it is the way it is</h2>
        <p class="lede measure">
          Every element of the installation answers a question about belonging. These are the decisions we have made
          so far, and our reasons for them.
        </p>
      </div>
      <dl class="decision-list">
        {
          decisions.map((d) => (
            <div class="decision reveal">
              <dt>{d.choice}</dt>
              <dd>{d.why}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section making" id="making">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Making</p>
        <h2>How a cloud gets built</h2>
        <p class="lede measure">
          What we tried, what surprised us, and what we are still working out.
        </p>
      </div>

      <article class="make">
        <div class="make-text reveal">
          <p class="make-num">01 · Body</p>
          <h3>From chicken mesh to tulle to fibre</h3>
          <p>
            Our first cloud was plastic chicken mesh, crumpled into folds and held with zip ties. It was easy to cut
            and shape, but heavy-looking and opaque. Then we tried tulle. A single layer is almost transparent, very
            light, and catches light beautifully.
          </p>
          <p>
            For the alpha we returned to the loose polyester fibre of our first lit cloud bottom, the kind used to stuff
            cushions. Layered over a white hexagonal mesh and pinned in place with bamboo skewers, it hides the individual
            lights and turns them into a soft glow with darker folds.
          </p>
          <p>
            <a href={url("/process/2026-05-21-mesh-and-tulle/")}>Mesh and tulle →</a>
            <br />
            <a href={url("/process/2026-07-30-the-alpha-cloud/")}>Fibre and skewers →</a>
          </p>
        </div>
        <div class="make-media three">
          <Figure src={meshZephir} alt="Zéphir shaping green plastic mesh on the studio floor." caption="Mesh, May 2026." ratio="3 / 4" class="reveal" />
          <Figure src={tulleAssembly} alt="Zéphir fixing layers of tulle to a stand." caption="Tulle, June 2026." ratio="3 / 4" class="reveal" />
          <Figure src={buildSkewers} alt="Hands pinning fibre into hexagonal mesh with a bamboo skewer." caption="Fibre, July 2026." ratio="3 / 4" class="reveal" />
        </div>
      </article>

      <article class="make">
        <div class="make-text reveal">
          <p class="make-num">02 · Light</p>
          <h3>A glow inside, a sun below</h3>
          <p>
            LEDs inside the cloud make it glow from within. An addressable LED matrix could create gradients, travelling
            light and lightning. Lit from the floor by a projector, the tulle throws beams and casts its shadow onto the
            ceiling. That gave us the idea that the audience might be the sun.
          </p>
          <p>
            In the alpha, rows of addressable LED pixels are tied across a pyramid inside the fibre, driven by an ESP32
            controller. Before anyone lay underneath, we checked the wiring with a thermal camera.
          </p>
          <p><a href={url("/process/2026-06-24-breath-as-sound/")}>Read about being the sun →</a></p>
        </div>
        <div class="make-media three">
          <VideoClip name="cloud-led" orientation="portrait" caption="LEDs inside the cloud." class="reveal" />
          <VideoClip name="led-matrix" orientation="portrait" caption="LED matrix test." class="reveal" />
          <Figure src={tulleLight2} alt="The tulle cloud lit blue and green near the ceiling." caption="Projected light through tulle." ratio="9 / 16" class="reveal" />
        </div>
      </article>

      <article class="make" id="breath">
        <div class="make-text reveal">
          <p class="make-num">03 · Breath</p>
          <h3>A belt that listens</h3>
          <p>
            Each participant wears a light belt with a stretch sensor. A tiny ESP32-C3 board sends the reading
            wirelessly as OSC messages to TouchDesigner, which detects the start of each in- and out-breath. Below are
            real recordings from our tests with different band widths and amounts of stretch, all on the same scale.
          </p>
          <p><a href={url("/process/2026-06-12-a-belt-that-listens/")}>Read about the belt →</a></p>
        </div>
        <div class="make-media">
          <Figure src={beltSketch} alt="Sketch of a vest with a breathing sensor band around the torso." caption="Early design sketch for the breathing vest." class="reveal" />
        </div>
      </article>
      <div class="reveal chart">
        <BreathChart />
      </div>

      <article class="make">
        <div class="make-text reveal">
          <p class="make-num">04 · Sound</p>
          <h3>Wind that turns into chimes</h3>
          <p>
            We imagine the soundscape moving from field recordings (wind in bare trees, a distant dawn chorus)
            towards something more musical as the experience builds. Each out-breath becomes a sound object that drifts up
            and plays the cloud. Notes arriving together form chords, and held chords swell into drones. Thunder
            answers lightning.
          </p>
          <p>
            One idea we are exploring is generative audio morphs. A generative audio model partially denoises a nature
            recording towards a prompt like “wind chimes”, and we pre-render a continuum of steps between the two to
            crossfade as the room synchronises.
          </p>
        </div>
        <div class="make-media sound-card reveal">
          <p class="eyebrow">Listening list</p>
          <ul>
            <li>Varandas — <em>Slow Down the Wind, the Clouds Need a Break</em></li>
            <li>Timothy Garrett — <em>Divergent Paths</em></li>
            <li>World of White Ice — <em>Frost</em></li>
            <li>Luke Kokoszka</li>
            <li>Field recordings: wind, bare trees, dawn chorus</li>
          </ul>
        </div>
      </article>

      <article class="make">
        <div class="make-text reveal">
          <p class="make-num">05 · Structure</p>
          <h3>A skeleton for something soft</h3>
          <p>
            Soft materials won’t hold a shape on their own. We 3D-printed joints, slotted wooden dowels into them to make a
            low pyramid, wrapped it in the same green mesh as our first cloud, and spray-painted the whole thing white so
            it wouldn’t tint the light. It carries the LEDs, and the fibre shell hangs around it.
          </p>
          <p><a href={url("/process/2026-07-22-a-pyramid-of-light/")}>Read about the frame →</a></p>
        </div>
        <div class="make-media two">
          <Figure src={printFrame} alt="A 3D printer printing a white frame part." caption="Printing joints, July 2026." ratio="4 / 5" class="reveal" />
          <Figure src={buildFrameAssembly} alt="Looking up through a mesh-wrapped wooden frame with LED pixels tied along it." caption="The pyramid, strung with LEDs." ratio="4 / 5" class="reveal" />
        </div>
      </article>
    </div>
  </section>

  <section class="section visits">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Looking at how others do it</p>
        <h2>Field visits</h2>
        <p class="measure">
          We visited immersive theatre in Paris to study thresholds, hosts and atmosphere: <em>Le Grand Hôtel des
          Rêves</em>, and Moir’s immersive personality test <em>TOI</em>. Other touchstones include Fujiko Nakaya’s fog
          sculptures and Olafur Eliasson’s <em>Beauty</em>.
        </p>
      </div>
      <div class="grid-3">
        <Figure src={visitCeiling} alt="A dark control room with swirling clouds projected across the ceiling." caption="A projected sky of clouds, Le Grand Hôtel des Rêves." ratio="3 / 4" class="reveal" />
        <Figure src={visitStars} alt="A deep blue room with a starry ceiling." caption="A starry room — should our night have stars?" ratio="3 / 4" class="reveal" />
        <Figure src={visitFire} alt="An old television showing a fireplace." caption="A fireplace on an old TV. For a while, a glowing hearth at the centre of the room was part of our design." ratio="3 / 4" class="reveal" />
      </div>
    </div>
  </section>

  <section class="section open dark">
    <div class="wrap grid-2">
      <div class="reveal">
        <p class="eyebrow">Still open</p>
        <h2>What we are still figuring out</h2>
        <p class="lede">The installation is unfinished on purpose. These are the questions we will answer by building it and trying it with people.</p>
      </div>
      <ul class="open-list reveal">
        {openQuestions.map((q) => <li>{q}</li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .status {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding: 0.7rem 1.1rem;
    border-radius: 1.2rem;
    background: rgb(255 255 255 / 0.6);
    border: 1px solid var(--line);
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--rose);
    flex: none;
    animation: pulse 3s ease-in-out infinite;
    transform: translateY(0.05rem);
  }
  @keyframes pulse {
    50% {
      opacity: 0.3;
    }
  }
  .section-head {
    margin-bottom: 3rem;
    max-width: 44rem;
  }
  .why-cloud {
    display: grid;
    grid-template-columns: 1fr minmax(14rem, 22rem);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 2rem 2.5rem;
    margin-top: 2.5rem;
  }
  .why h3 {
    font-size: 1.3rem;
    margin-bottom: 0.3rem;
  }
  .why p {
    color: var(--ink-soft);
    font-size: 0.97rem;
    margin: 0;
  }
  :global(.why-video) {
    position: sticky;
    top: 6rem;
  }
  @media (max-width: 860px) {
    .why-cloud {
      grid-template-columns: 1fr;
    }
    :global(.why-video) {
      position: static;
      max-width: 22rem;
    }
  }

  .sim-head,
  .try-head,
  .alpha-head {
    margin-bottom: 3rem;
  }
  .alpha {
    background: linear-gradient(180deg, var(--night), #141a3d 60%, var(--night));
  }
  .alpha p {
    color: var(--ink-soft);
  }
  .alpha a {
    color: #eceefb;
  }
  .alpha-clips {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .mosaic {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: clamp(14rem, 28vw, 24rem);
    gap: 1.25rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .mosaic :global(figure) {
    height: 100%;
  }
  .mosaic :global(figure.wide) {
    grid-column: span 2;
  }
  .mosaic :global(img) {
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 700px) {
    .mosaic {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
    .mosaic :global(figure.wide) {
      grid-column: auto;
    }
    .mosaic :global(img) {
      aspect-ratio: 4 / 3;
    }
  }
  .build-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-bottom: 1.5rem;
  }
  .build-head .eyebrow {
    margin: 0;
  }
  .build-strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(13rem, 16rem);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
  }
  .build-strip :global(figure) {
    scroll-snap-align: start;
  }
  .build-strip :global(figcaption) {
    color: var(--ink-soft);
  }
  .sim p {
    color: var(--ink-soft);
  }
  .small {
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

  .decision-list {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .decision {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) 2fr;
    gap: 1rem 3rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line);
  }
  .decision dt {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.65rem);
    line-height: 1.2;
  }
  .decision dd {
    margin: 0;
    color: var(--ink-soft);
  }
  @media (max-width: 700px) {
    .decision {
      grid-template-columns: 1fr;
    }
  }

  .make {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }
  .make-num {
    font-size: 0.8rem;
