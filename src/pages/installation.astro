---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import BreathChart from '../components/BreathChart.astro';
import Figure from '../components/Figure.astro';
import insideStruts from '../assets/journal/post-alpha/inside-pyramid-leds-struts.jpg';
import layersShowing from '../assets/journal/post-alpha/different-layers-showing.jpg';
import thickWadding from '../assets/journal/post-alpha/thick-wadding.jpg';
import betterBuck from '../assets/journal/post-alpha/better-buck-converter-different-controller.jpg';
import MediaGallery, { type GalleryItem } from '../components/MediaGallery.astro';

import beltSketch from '../assets/photos/belt-sketch.jpg';
import printedJoints from '../assets/journal/2026-07-17-printing-a-frame/pyramid-3d-joints-printed.jpg';
import pyramidFrameMaking from '../assets/journal/2026-07-22-a-pyramid-of-light/pyramid-frame-making.jpg';

import cloudMaterials from '../assets/photos/cloud-materials.jpg';
import ledLightingDiagram from '../assets/photos/led-light-probes-diagram.jpg';
import swSimulator from '../assets/software/simulator.png';
import swMapping from '../assets/software/mapping.png';
import swSkyTimeline from '../assets/software/simulator-sky-timeline.png';
import swLightning from '../assets/software/simulator-lightning.png';
import swSamples from '../assets/software/samples.png';
import swPads from '../assets/software/pads.png';
import teaFront from '../assets/alpha/tea-front.jpg';
import pinkPurpleBlue from '../assets/alpha/pink-purple-blue.jpg';
import cloudRoom from '../assets/alpha/cloud-room.jpg';
import zephirTeaBlue from '../assets/alpha/zephir-tea-blue.jpg';
import visitorsUnderCloud from '../assets/alpha/visitors-under-cloud.jpg';
import workshopFisheye from '../assets/alpha/workshop-fisheye.jpg';
import wholeRoom from '../assets/alpha/whole-room.jpg';
import selfie from '../assets/alpha/selfie.jpg';
import zephirHug from '../assets/alpha/zephir-hug.jpg';
import zephirLyingUnder from '../assets/alpha/zephir-lying-under.jpg';
import cloudInABag from '../assets/alpha/cloud-in-a-bag.jpg';
import twoScreens from '../assets/alpha/two-screens.jpg';
import touchdesignerBelts from '../assets/alpha/touchdesigner-belts.jpg';
import prepWorkbench from '../assets/alpha/prep-workbench.jpg';
import prepStuffing from '../assets/alpha/prep-stuffing.jpg';
import prepStuffingDistant from '../assets/alpha/prep-stuffing-distant.jpg';
import prepThumbsUp from '../assets/alpha/prep-thumbs-up.jpg';
import prepArmScratches from '../assets/alpha/prep-arm-scratches.jpg';
import elecController from '../assets/alpha/elec-controller.jpg';
import elecBattery from '../assets/alpha/elec-battery.jpg';
import elecBuckConverter from '../assets/alpha/elec-buck-converter.jpg';
import elecOverheating from '../assets/alpha/elec-overheating.jpg';
import elecFanFix from '../assets/alpha/elec-fan-fix.jpg';
import buildDowels from '../assets/photos/build-dowels.jpg';
import buildPyramidCourtyard from '../assets/photos/build-pyramid-courtyard.jpg';
import buildLedCloud from '../assets/photos/build-led-cloud.jpg';
import ledsInsideFrame from '../assets/journal/2026-07-22-a-pyramid-of-light/led-mapping-starting-inside-frame.jpg';
import puttingInLeds from '../assets/journal/2026-07-22-a-pyramid-of-light/alpha-puttin-in-leds.jpg';
import buildSkewersMesh from '../assets/photos/build-skewers-mesh.jpg';
import buildShell from '../assets/photos/build-shell.jpg';
import buildThermal from '../assets/photos/build-thermal.jpg';
import buildStuffing from '../assets/photos/build-stuffing.jpg';

const outerLayers = [
  {
    name: 'Cotton',
    text: 'The outermost layer and the one you see. Pulled into tufts, it gives the cloud its billowing, cumulus surface.',
  },
  {
    name: 'Polyester fleece wadding',
    text: 'A thicker layer of wadding under the cotton. It gives the cloud its body and softens the light again on its way out.',
  },
  {
    name: 'White mesh',
    text: 'A white plastic mesh with hexagonal cells, shaped into the cloud’s outline. It is the shell that holds the soft layers in place.',
  },
  {
    name: 'Nylon diffuser fabric',
    text: 'The first thing the light meets. It spreads each point of light out before it reaches the wadding, so no single LED shows through as a hot spot.',
  },
];

const innerLayers = [
  {
    name: 'Inner mesh frame',
    text: 'A square-grid mesh that forms the core of the cloud and carries the lights.',
  },
  {
    name: 'Addressable LEDs',
    text: 'Individually controllable LED pixels (for example WS2811), fixed across the frame. Each can take its own colour and brightness, which makes gradients, lightning, colour blooms and breathing light possible.',
  },
  {
    name: 'Directionality cylinders',
    text: 'A short card tube around each LED aims its light outwards, so each pixel lights its own patch of the cloud instead of washing into its neighbours.',
  },
  {
    name: 'Support struts',
    text: 'Tubes of rolled mesh, rising from the frame, hold the outer layers at a distance from the lights.',
  },
  {
    name: 'Black fabric layer',
    text: 'Underneath the frame, a black fabric stops light escaping backwards, so it only leaves through the diffusing layers.',
  },
];

const tour = [
  {
    kicker: 'LED mapping',
    title: 'Placing 344 lights on a lumpy cloud',
    img: swMapping,
    alt: 'The LED mapping page: a wireframe model of the pyramid-shaped cloud on a grid, with numbered blue dots for each LED and control panels on both sides.',
    caption: 'The mapping page. Each numbered dot is a physical LED, placed in strand order.',
    body: [
      'We modelled the cloud’s shape in Blender and loaded it into the mapping page. Then we placed the LEDs on it one by one, in the order they run along the physical strand, lighting each real LED to check it was in the right spot.',
      'A smooth model is not a cloud, so we added 48 soft “domes” over the surface where the real cloud billows. They lift nearby LEDs and change how light reaches them, so a pixel tucked in a fold sits in shadow and one on a crest catches the light. A movable test light, which can stream straight to the cloud, let us check the mapping by eye.',
    ],
  },
  {
    kicker: 'Colour',
    title: 'Choosing colours on a 24-hour sky',
    img: swSkyTimeline,
    wide: true,
    alt: 'The sky timeline: a row of day periods (magical night, dawn, day, dusk, night) above tracks for lightning, breath, and gradient tracks of colour stops for the sun, moon and ambient light.',
    caption: 'The sky timeline. Periods across the top, then colour stops for sun, moon and ambient light.',
    body: [
      'The day is split into periods: magical night, dawn, day, dusk and night. Below them sit three colour tracks, for the sun, the moon and the ambient sky, each with its own draggable colour stops. The sun and moon move on physically plausible arcs, and their colours blend smoothly between stops.',
      'We chose the colours by eye, not by formula. We dragged a stop, watched the real cloud change, and kept what felt like a sky: the violets and ambers of our palette, deep blues at night, and hue-preserving brightness so sunset oranges don’t bleach to white.',
    ],
  },
  {
    kicker: 'Lightning',
    title: 'Bolts, strikes and sprites',
    img: swLightning,
    alt: 'The lightning panel: a storm intensity curve keyframed across dusk, night, magical night and dawn, three colour gradient tracks for the bolts, rate and shape sliders, and a library of thunder and sprite sounds and images.',
    caption: 'The lightning panel. Storm intensity across the night, bolt colours, shape, and a library of thunder sounds.',
    body: [
      'Lightning is simulated as branching bolts that crawl through the cloud’s 3D volume, lighting the LEDs they pass. There are in-cloud flashes, ground strikes, and image “sprites”: pictures projected through the cloud in a short strobe, which became the strange flashes of the magical twilight.',
      'Storm intensity is keyframed across the night, building from dusk into the magical twilight. Each bolt takes its colours from three gradient tracks, so a flash can move from pale gold to magenta to green. Every flash also picks a thunder recording that matches its length and intensity, arriving a moment later like real thunder.',
    ],
  },
  {
    kicker: 'Sound · drones',
    title: 'A score written across the day',
    video: 'drone-interface',
    alt: 'Screen recording of the drones page: a playhead moves across a 24-hour piano roll of long blue notes, above per-note controls for layer mix, a pink tremolo curve, a blue filter curve, and octave layers with tremolo and drift.',
    caption: 'The drones page, with audio. Long notes on a 24-hour piano roll, shaped by tremolo, filter and drift.',
    body: [
      'The soundscape is composed on the same 24-hour clock as the light. A drone synth and a warm pad synth each have a piano roll that spans the whole day, so a note might hold for hours of sky time, from dusk into night.',
      'Drones are built from slow, layered sine tones, with a tiny drift that dissolves beating between close intervals into a soft chorus.',
    ],
  },
  {
    kicker: 'Sound · pads',
    title: 'Warm chords that change with the light',
    img: swPads,
    alt: 'The pads page: a piano roll across the 24-hour day with chord notes, and synth controls with keyframe curves for each parameter.',
    caption: 'The pad synth, with its own piano roll and parameters keyframed across the day.',
    body: [
      'Above the drones sits a warm pad synth: several detuned voices per note, spread across the stereo field, then through saturation, chorus, reverb and delay.',
      'Its chords are written on the same day clock, clustered through the night and early morning. Any parameter can be keyframed across the day. Here the filter cutoff rises and falls, so the pads open up and soften again as the light on the cloud changes.',
    ],
  },
  {
    kicker: 'Sound · samples',
    title: 'Birdsong, bells and the breath of the room',
    img: swSamples,
    alt: 'The samples page: a library of sound files with waveforms on the left, arranged as orange clips on lanes across a 24-hour timeline, with automation curves for volume and effects.',
    caption: 'Samples arranged on lanes across the day, with automation for volume, pan, filter, reverb and delay.',
    body: [
      'Recorded sounds are dragged from a library onto lanes on the day timeline: morning birdsong, dusk ambience, gentle and reversed bells, chimes. Each lane has its own curves for volume, pan, filter, reverb and delay.',
      'Breath plays its part too. Each out-breath can trigger a soft sound, and how much of the cloud is lit by breath feeds back into the mix. The room hears itself breathing with the cloud.',
    ],
  },
  {
    kicker: 'Sound · breath modulation',
    title: 'The mix breathes with the room',
    video: 'audio-breath-modulation',
    alt: 'Screen recording: breath waves sweep through the digital cloud as green spheres, lighting its LEDs, while the drone, pad and sample sliders in the master volume panel rise and fall with them.',
    caption: 'Breath modulating the sound, with audio. Watch the drone, pad and sample controls move as each breath passes through the cloud.',
    body: [
      'As each out-breath travels up into the cloud, the software measures how much of the cloud it lights. That single value then drives the mix. Each slider in the master panel sets where a parameter lands when the cloud is fully lit by breath, plus an offset for where it rests between breaths. The live value glides between the two.',
      'It moves the volume, saturation, tremolo and filters of the drones, the volume, saturation, spread and filters of the pads, and the volume and filters of the samples. The soundscape swells and opens as a breath washes through the cloud, then settles as it fades. Turn the sound on to hear it.',
    ],
  },
];

const lying = [
  { src: zephirLyingUnder, wide: true, alt: 'Lying on white sheets directly beneath the cloud, which glows warm white overhead.' },
  { src: pinkPurpleBlue, wide: false, alt: 'The cloud glowing pink, purple and blue above the sheets, seen from the floor.' },
  { src: visitorsUnderCloud, wide: true, alt: 'Visitors lounging on beanbags and sheets beneath the glowing cloud in front of a blue backdrop.' },
  { src: zephirTeaBlue, wide: true, alt: 'Zéphir pouring tea beneath the cloud, lit blue.' },
  { src: selfie, wide: false, alt: 'A grinning selfie of the two of us beside the cloud, glowing pink.' },
  { src: wholeRoom, wide: true, alt: 'The whole room from above: the cloud glowing over sheets, a small tea table and people sitting on the floor.' },
  { src: zephirHug, wide: false, alt: 'Zéphir hugging the cloud while it glows white.' },
];

const dusk: GalleryItem[] = [
  { video: 'alpha/lightning-short', caption: 'A strike, seen from the floor.' },
  { video: 'alpha/evening-1', caption: 'Dusk falls and the lightning begins.' },
];
const twilight: GalleryItem[] = [
  { video: 'alpha/lightning', portrait: true, caption: 'Lightning and magical sprites flickering through the fibre.' },
  { video: 'alpha/evening-2', caption: 'Violet, magenta and blue through the whole cloud.' },
];
const breath: GalleryItem[] = [
  { video: 'alpha/breath', portrait: true, caption: 'A breath rising into the cloud.' },
  { video: 'alpha/breath-through', caption: 'Waves of breath travelling through it.' },
  { video: 'alpha/tea-lightning', caption: 'Tea under a storm.' },
];

const moments: GalleryItem[] = [
  ...lying.map((m) => ({ image: m.src, alt: m.alt })),
  { image: cloudRoom, alt: 'The alpha cloud glowing above white sheets, with a teapot on a small pedestal below.', caption: 'The room, set for tea.' },
  { image: workshopFisheye, alt: 'A fisheye view of the workshop with the cloud glowing white in its corner.', caption: 'The corner of the workshop we turned into a sky.' },
];

const screens: GalleryItem[] = [
  { image: touchdesignerBelts, alt: 'A laptop running TouchDesigner with breath waveforms from the belts, the cloud glowing behind it.', caption: 'Breath from the belts, in TouchDesigner.' },
  { video: 'alpha/gui', caption: 'Driving the cloud from the control app.' },
  { image: twoScreens, alt: 'Two laptops side by side at the edge of the room, with the cloud lit in the background.', caption: 'Two screens: breath on one, the sky on the other.' },
];

const prep: GalleryItem[] = [
  { image: prepStuffing, alt: 'Close-up from below: hands pushing fibre into the hexagonal mesh with a bamboo skewer.', caption: 'Stuffing the cloud from below.' },
  { image: prepStuffingDistant, alt: 'Lying on the floor under the hanging cloud, reaching up to shape it.', caption: 'Hours on the floor.' },
  { video: 'alpha/prep-hanging', caption: 'Hanging the cloud.' },
  { image: prepThumbsUp, alt: 'Lying under the lit cloud, giving a thumbs up.', caption: 'Nearly there.' },
  { image: prepArmScratches, alt: 'A forearm covered in scratches from the plastic mesh.', caption: 'The mesh fought back.' },
  { image: prepWorkbench, alt: 'The workbench covered in mesh, fibre, spray cans and tools.', caption: 'The workbench, mid-build.' },
];

const buildSteps = [
  { src: buildDowels, date: '21 Jul', caption: 'Dowels and printed joints', alt: 'Wooden dowels and 3D-printed joints laid out on the workshop floor.' },
  { src: ledsInsideFrame, date: '21 Jul', caption: 'LED pixels tied inside a mesh pyramid', alt: 'Looking up inside the mesh-wrapped pyramid, with strings of LED pixels zip-tied along each face.' },
  { src: buildPyramidCourtyard, date: '22 Jul', caption: 'Painted white in the courtyard', alt: 'The painted pyramid drying on cardboard in a narrow courtyard.' },
  { src: buildLedCloud, date: '24 Jul', caption: 'First fibre over the lights', alt: 'A mound of fibre glowing violet on top of a frame of LED pixels.' },
  { src: buildSkewersMesh, date: '24 Jul', caption: 'Fibre pinned with bamboo skewers', alt: 'Close-up of fibre on hexagonal mesh, held by bamboo skewers.' },
  { src: buildThermal, date: '28 Jul', caption: 'Checking for heat', alt: 'A thermal camera reading 27.4 °C, pointed at wiring on the floor.' },
  { src: buildShell, date: '28 Jul', caption: 'Judging the shape of the shell', alt: 'Holding the fibre and mesh shell overhead in the workshop.' },
  { src: buildStuffing, date: '29 Jul', caption: 'Final shaping, from below', alt: 'Lying beneath the lit cloud, pushing a skewer up into the fibre.' },
];

const electronics = [
  { src: elecController, caption: 'The LED controller.', alt: 'An LED controller board on a small acrylic plate, with wires running off it.' },
  { src: elecBattery, caption: 'The battery pack.', alt: 'A blue lithium battery pack with red and black leads.' },
  { src: elecBuckConverter, caption: 'The buck converter, stepping the voltage down for the LEDs.', alt: 'A buck converter module with a heat sink, wired with lever connectors.' },
  { src: elecOverheating, caption: 'It ran hot. We checked how hot with a thermal camera.', alt: 'A thermal camera pointed at the electronics on the floor, showing a hot spot.' },
  { src: elecFanFix, caption: 'The fix: a small fan on top.', alt: 'The electronics held in a hand, now with a small cooling fan mounted on top.' },
];

const learned = [
  {
    title: 'The twilight needed a story',
    text: 'Colour changes alone read as a light show. They became the magical twilight, with images flashing through the cloud, so the bond forms before the breath begins.',
  },
  {
    title: 'The cloud looked flat up close',
    text: 'From underneath, a single fibre layer showed its lights. After the alpha we rebuilt it in layers, with a diffuser, wadding and cotton, and gave the digital twin bumps so the light follows the cloud’s shape.',
  },
  {
    title: 'Heat and power are part of the design',
    text: 'Hundreds of LEDs wrapped in fibre need their temperature checked, not assumed. The buck converter ran hot until we gave it a fan, and later a better converter and controller.',
  },
];

---

<Base theme="night" title="Installation" description="Cloudfulness, a breathing cloud installation about belonging to nature: the alpha on film, the people beneath it, fabrication and technical details.">
  <PageHeader
    eyebrow="The installation"
    image={teaFront}
    imageAlt="The alpha cloud glowing warm white above white sheets, with a small tea table beneath it."
    title="A cloud that listens"
    lede="A cloud hangs above you. The sun sets, lightning begins, and then the whole cloud starts to bloom with colour. Then the cloud begins to breathe with you.">
    <p class="status">
      <span class="dot" aria-hidden="true"></span>
      <span>
        <em>Cloudfulness</em>. Three stages: dusk, magical twilight, breath synchrony. First alpha
        built and tested in July 2026.
      </span>
    </p>
  </PageHeader>


  <section class="section dark evening" id="alpha">
    <div class="phase-divider" id="alpha-start" aria-label="The alpha">
      <div class="wrap phase-divider-inner">
        <span class="pd-line" aria-hidden="true"></span>
        <span class="pd-glyph" aria-hidden="true">α</span>
        <span class="pd-text"><strong>The alpha</strong><span>July 2026</span></span>
        <span class="pd-line" aria-hidden="true"></span>
      </div>
    </div>

    <div class="wrap">
      <div class="grid-2 head">
        <div class="reveal">
          <p class="eyebrow"><span class="phase-mark">α</span> The evening</p>
          <h2>From dusk to breath</h2>
        </div>
        <div class="reveal">
          <p>
            We closed off a corner of the studio with a blue backdrop and black panels, laid white sheets and beanbags on
            the floor, and kept a pot of tea warm under the cloud. Over two days, people took turns lying beneath it as
            it moved from dusk and lightning, through a violet and magenta twilight, into breathing with them.
          </p>
          <p class="small">All clips are silent. Click any of them to see it larger.</p>
        </div>
      </div>

      <MediaGallery items={dusk} audio="dusk-audio.mp3" numeral="I" title="Dusk and lightning" description="The sun sets on the room and the first strikes flicker through the cloud." class="reveal" />
      <MediaGallery items={twilight} audio="magical-twilight.mp3" numeral="II" title="Magical twilight" description="The light intensifies into violet, magenta and blue." columns={2} class="reveal" />
      <MediaGallery items={breath} audio="breath-effect.mp3" numeral="III" title="Breath" description="The cloud slows down and starts breathing with the people beneath it." columns={2} class="reveal" />
    </div>
  </section>

  <section class="section wash wash-sky moments" id="moments">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="phase-mark">α</span> Moments</p>
        <h2>The people beneath it</h2>
        <p class="lede measure">
          Shoes off, lying on the floor, a glass of tea. Everyone who came had the same seat under the same sky.
        </p>
      </div>
      <MediaGallery items={moments} title="Under the cloud" description="Two days of visitors, tea and beanbags." class="reveal" />
    </div>
  </section>

  <section class="section screens" id="screens">
    <div class="wrap">
      <div class="grid-2 head">
        <div class="reveal">
          <p class="eyebrow"><span class="phase-mark">α</span> Behind the screens</p>
          <h2>Two laptops and a pair of belts</h2>
        </div>
        <div class="reveal">
          <p>
            At the side of the room, TouchDesigner read the breathing belts and showed each breath as a wave, while our
            own control app drove the sky, lightning and colour. Watching the screens and the cloud side by side was how
            we tuned the evening as it happened.
          </p>
          <p><a href={url('/installation/#software')}>More about the software →</a></p>
        </div>
      </div>
      <MediaGallery items={screens} title="The control desk" description="Breath waves on one screen, the sky on the other." class="reveal" />
    </div>
  </section>


  <section class="section getting-ready" id="getting-ready">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="phase-mark">α</span> Getting ready</p>
        <h2>Ten days, and the last few hours</h2>
        <p class="lede measure">
          The alpha was built in ten days in a workshop. The last of it happened lying on the floor, pushing fibre up
          into the cloud one skewer at a time.
        </p>
      </div>

      <MediaGallery items={prep} title="The last few hours" description="Stuffing, hanging and shaping the cloud before the doors opened." class="reveal" />

      <div class="elec">
        <div class="elec-text reveal">
          <p class="eyebrow">Electronics</p>
          <h3>A cloud that ran warm</h3>
          <p>
            The LEDs run from a battery through a buck converter, which steps the voltage down to what the lights need.
            Under the full load of the cloud it ran hot, so we measured it with a thermal camera and added a small fan.
            After the alpha we replaced it with a better converter and controller.
          </p>
        </div>
        <MediaGallery items={electronics.map((e) => ({ image: e.src, alt: e.alt, caption: e.caption }))} columns={3} class="reveal" />
      </div>

      <div class="build-head reveal">
        <p class="eyebrow">Ten days of building</p>
        <p class="small">From printed joints to a cloud on the ceiling, 20–29 July 2026. Scroll sideways.</p>
      </div>
      <div class="build-strip">
        {
          buildSteps.map((b) => (
            <Figure
              src={b.src}
              alt={b.alt}
              caption={`${b.date} · ${b.caption}`}
              ratio="3 / 4"
              widths={[360, 600]}
              sizes="(min-width: 60rem) 16rem, 60vw"
              class="reveal"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section blend schematic making" id="making">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow"><span class="phase-mark">α</span> Technical details</p>
        <h2>Everything behind the cloud</h2>
        <p class="lede measure">
          The hardware and software that made the alpha work. Open any part to see more.
        </p>
      </div>

      <h3 class="tech-group reveal">Hardware</h3>
      <details class="tech" open>
        <summary>
          <span class="tech-num">01</span>
          <span class="tech-kicker">Structure</span>
          <span class="tech-title">A pyramid frame</span>
          <span class="tech-chev" aria-hidden="true"></span>
        </summary>
      <article class="make">
        <div class="make-text reveal">
          <p>
            The cloud hangs from a low pyramid of wooden dowels held together by 3D-printed joints. The frame is wrapped
            in plastic mesh, carries the LEDs, and is sprayed white so it doesn’t tint the light. The fibre shell hangs
            around it.
          </p>
          <p><a href={url("/process/2026-07-22-a-pyramid-of-light/")}>Building the pyramid →</a></p>
        </div>
        <div class="make-media two">
          <Figure src={printedJoints} alt="The 3D-printed joints for the pyramid frame." caption="Printed joints." ratio="4 / 5" class="reveal" />
          <Figure src={pyramidFrameMaking} alt="The wooden dowel frame of the pyramid coming together with its printed joints." caption="The frame comes together." ratio="4 / 5" class="reveal" />
        </div>
      </article>
      </details>

      <details class="tech">
        <summary>
          <span class="tech-num">02</span>
          <span class="tech-kicker">Light</span>
          <span class="tech-title">LED pixels inside the pyramid</span>
          <span class="tech-chev" aria-hidden="true"></span>
        </summary>
      <article class="make">
        <div class="make-text reveal">
          <p>
            Rows of addressable LED pixels are tied along the inside of the pyramid, driven by an ESP32 controller. Each pixel can
            take its own colour and brightness, and each has a position in the digital twin, which is how the software
            knows what colour to give it.
          </p>
          <p><a href={url("/process/2026-07-22-a-pyramid-of-light/")}>A pyramid of light →</a></p>
        </div>
        <div class="make-media two">
          <Figure src={ledsInsideFrame} alt="Looking up inside the mesh-wrapped pyramid, with strings of LED pixels zip-tied in rows along each face." caption="Inside the pyramid." ratio="4 / 5" class="reveal" />
          <Figure src={puttingInLeds} alt="Michael zip-tying LED pixels onto one mesh-covered face of the pyramid frame." caption="Tying in the pixels." ratio="4 / 5" class="reveal" />
        </div>
      </article>
      </details>

      <details class="tech">
        <summary>
          <span class="tech-num">03</span>
          <span class="tech-kicker">Body</span>
          <span class="tech-title">Fibre on a mesh shell</span>
          <span class="tech-chev" aria-hidden="true"></span>
        </summary>
      <article class="make">
        <div class="make-text reveal">
          <p>
            The body is loose polyester fibre, the kind used to stuff cushions, layered over a white hexagonal mesh and
            pinned in place with bamboo skewers. It hides the individual lights and turns them into a soft glow with
            darker folds.
          </p>
          <p><a href={url("/process/2026-07-30-the-alpha-cloud/")}>The alpha cloud →</a></p>
        </div>
        <div class="make-media two">
