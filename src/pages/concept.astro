---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PageContents, { type ContentsItem } from '../components/PageContents.astro';
import Figure from '../components/Figure.astro';
import ScoreGrid from '../components/ScoreGrid.astro';
import alphaWarm from '../assets/photos/alpha-warm.jpg';
import alphaTeam from '../assets/photos/alpha-team.jpg';

const facets = [
  {
    title: 'A need, not a luxury',
    text: 'Belonging is a universal, evolutionarily rooted drive to form and keep meaningful connections. In Maslow’s hierarchy, it comes right after food, water and safety. It is felt as being accepted, valued and understood.',
    cite: 'Baumeister & Leary, 1995; Allen, 2020',
  },
  {
    title: 'A process, not a state',
    text: 'Belonging is never fixed. It flickers, depends on context, and is renegotiated all the time. It is shaped by autonomy, choice and commitment, so it can’t be imposed.',
    cite: 'Allen, 2020',
  },
  {
    title: 'Built in small acts',
    text: 'Sharing a thought or a memory, listening, affirming, moving in time with someone. And reframing shared struggles as normal, so that difficulty doesn’t read as proof that you don’t fit in.',
    cite: 'Walton & Cohen, 2011',
  },
  {
    title: 'Quality over quantity',
    text: 'What matters is frequent, warm, stable contact within real mutual care. Going from no close relationships to two changes everything; going from twenty to twenty-two changes very little.',
    cite: 'Baumeister & Leary, 1995',
  },
  {
    title: 'Embodied and placed',
    text: 'Belonging lives in the body and attaches to places, objects, sounds, smells and textures. Think of a place where you belong and every sense comes back at once.',
    cite: 'Allen, 2020',
  },
];

const practices = [
  {
    title: 'Practising together',
    text: 'Compared with meditating alone, studies of group practice report a deeper experience that is easier to sustain. It is also linked with more care for others, empathy and co-regulation of mood.',
  },
  {
    title: 'Sharing afterwards',
    text: 'A sharing round after a practice normalises experience. People discover that what they felt was not theirs alone, and they are listened to without judgement.',
    cite: 'Fagioli et al., 2023; Wyatt et al., 2014',
  },
  {
    title: 'Listening in pairs',
    text: 'Contemplative dyads — one speaks, one listens, then swap — increased perceived social connectedness over months of training.',
    cite: 'Kok & Singer, 2017',
  },
];

const belongingMap = [
  {
    quality: 'Belonging is embodied and anchored',
    choice: 'A multisensory space.',
    how: ' You take off your shoes and lie down beneath the cloud, among soft fabric, warm light and a glass of tea.',
  },
  {
    quality: 'Belonging is a journey',
    choice: 'An evolving score.',
    how: ' Dusk, a magical twilight, then breath synchrony: the experience moves, and you move with it.',
  },
  {
    quality: 'Belonging is dynamic',
    choice: 'Biofeedback.',
    how: ' A sensor follows your breathing, and the cloud’s light rises and settles with it. You breathe with the cloud rather than control it.',
  },
  {
    quality: 'Belonging depends on the quality of connections',
    choice: 'A shared experience.',
    how: ' One sky over everyone in the room, with nobody in a better seat.',
  },
];

const whyCloud = [
  { title: 'It is above everyone', text: 'Nobody has a better seat. A cloud offers a shared perspective without a stage.' },
  { title: 'It gives light a body', text: 'A cloud is a volume for light to live in — glowing, flashing, catching the sun.' },
  { title: 'It is always changing', text: 'Clouds are impermanence made visible. They form, drift, rain and form again.' },
  { title: 'It is water, and so are we', text: 'The water cycle is continuity and unity: the same water in vapour, rain, river, tea, and us.' },
  { title: 'It follows you home', text: 'Everyone sees clouds. We hope the next one you see brings a little of this back.' },
  { title: 'It is forgiving', text: 'Dim, diffuse light feels primal and hides the imperfections of whatever room we are in.' },
];

const decisions = [
  {
    choice: 'Breath as the interface',
    why: 'Breath is both voluntary and involuntary, and everyone has it. Breathing in rhythm with something is one of the simplest forms of co-regulation. It also builds on what Zéphir learned from Réespiration.',
  },
  {
    choice: 'Breathing with the cloud, not controlling it',
    why: 'We want people to feel that they belong with the cloud, not that they are in charge of it. Its light follows the rise and fall of your respiration, like a companion keeping time with you, rather than obeying commands.',
  },
  {
    choice: 'Lightning at dusk',
    why: 'People arrive carrying their day. As the sun sets, the first lightning pulls attention into the room and towards weather: nature as vast, a little wild, and very present.',
  },
  {
    choice: 'A magical twilight before the breath',
    why: 'The twilight turns the experience into a story. As its light intensifies and colours flare up through the whole cloud at once, the cloud gains a presence and a character. By the time it begins to breathe with you, a bond is already there.',
  },
  {
    choice: 'Lying down, shoes off',
    why: 'Posture changes the role you play. Lying on the floor under a sky turns a visitor into an inhabitant, and the small ritual of preparation already begins the shared experience.',
  },
  {
    choice: 'No instructions about feelings',
    why: 'Being told to feel connected is the fastest way not to be. The space offers conditions and a little mystery, and leaves the story to the people in it.',
  },
];

const openQuestions = [
  'How do we invite someone to breathe with the cloud without instructing them?',
  'How much of the twilight’s story should be told, and how much left to the imagination?',
  'How does the bond with the cloud carry on after you leave?',
  'Where could it live next: a gallery, a public space, a train carriage, a boat?',
  'What would a space for belonging to each other, or to ourselves, look like?',
];

const glow = 'stroke="url(#toc-glow)"';
const contents: ContentsItem[] = [
  {
    id: 'what',
    label: 'What belonging is',
    desc: 'A need, a process, embodied and placed',
    icon: `<circle cx="24" cy="24" r="14"/><path ${glow} d="M17 25c3 4 11 4 14 0"/><circle cx="19" cy="20" r="1.4" fill="currentColor" stroke="none"/><circle cx="29" cy="20" r="1.4" fill="currentColor" stroke="none"/>`,
  },
  {
    id: 'interbeing',
    label: 'Beyond people',
    desc: 'Interbeing, and a cloud in your tea',
    icon: `<path d="M13 22h22a6 6 0 0 0 .5-12A9 9 0 0 0 18 8a7 7 0 0 0-5 14Z"/><path ${glow} d="M18 27v4M24 27v6M30 27v4"/><path d="M14 36h20l-2 6H16Z"/>`,
  },
  {
    id: 'why-art',
    label: 'Why art',
    desc: 'Belonging can’t be streamed',
    icon: `<path d="M24 8 40 38H8Z"/><path ${glow} d="M16 30h16"/>`,
  },
  {
    id: 'into-a-room',
    label: 'Into a room',
    desc: 'How the ideas became a cloud',
    icon: `<path d="M8 40V18L24 8l16 10v22"/><path ${glow} d="M16 26h16a4 4 0 0 0 0-8 6 6 0 0 0-11-1 5 5 0 0 0-5 9Z"/>`,
  },
  {
    id: 'score',
    label: 'The score',
    desc: 'Dusk, magical twilight, breath',
    icon: `<path d="M6 34h36"/><path ${glow} d="M14 34a10 10 0 0 1 20 0"/><path d="M30 12a7 7 0 1 0 6 10 6 6 0 0 1-6-10Z"/>`,
  },
  {
    id: 'decisions',
    label: 'Design decisions',
    desc: 'Why it is the way it is',
    icon: `<path d="M24 6v36"/><path ${glow} d="M24 14h12l4 4-4 4H24"/><path d="M24 26H12l-4 4 4 4h12"/>`,
  },
  {
    id: 'questions',
    label: 'Open questions',
    desc: 'An invitation to take them further',
    icon: `<path d="M18 18a6 6 0 1 1 9 5c-2 1-3 2-3 5"/><circle ${glow} cx="24" cy="36" r="1.8"/><circle cx="24" cy="24" r="18"/>`,
  },
];

const questions = [
  'How do you feel that you belong without feeling that you are being controlled?',
  'What is the difference between having control and playing a role?',
  'Can a room of strangers become a “we” in half an hour — and should it?',
  'Can we belong to weather? To a sky, a cloud, a season?',
  'How do you design for connection that is felt, not performed?',
  'What trace can a one-off encounter leave, so that people might meet again?',
  'When everyone breathes together, where does my breath end?',
];
---

<Base title="Concept" description="The concept behind Cloudfulness: belonging as a need, a process and an embodied experience, why art and research-creation, and how the ideas became a cloud.">
  <PageHeader
    eyebrow="Concept"
    image={alphaTeam}
    imageAlt="Two of the team grinning beside the cloud, lit pink."
    title="Belonging, and why a cloud"
    lede="We started by asking whether art and technology could help people find a moment of peace. We kept arriving at the same answer: peace is rarely something we find alone."
  />

  <PageContents items={contents} />

  <section class="section wash" id="what">
    <div class="wrap grid-2">
      <blockquote class="big-quote reveal">
        <p>“Our need to belong is like our need for water.”</p>
        <cite>Kelly-Ann Allen, <em>The Psychology of Belonging</em> (2020)</cite>
      </blockquote>
      <div class="reveal">
        <p class="lede">
          Belonging is the felt sense of being accepted, included, understood, welcomed, liked and appreciated.
        </p>
        <p>
          Psychology describes it as “a pervasive drive to form and maintain at least a minimum quantity of lasting,
          positive, and significant interpersonal relationships” (Baumeister &amp; Leary, 1995). But reading the
          research as artists, what struck us was how much belonging depends on things a space can hold: small
          rituals, shared attention, the texture of a room, the warmth of light, the chance to be heard.
        </p>
        <p>That makes it a subject for art as much as for science.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Five facets</p>
        <h2>What we mean when we say belonging</h2>
      </div>
      <ol class="facets">
        {
          facets.map((f, i) => (
            <li class="facet reveal">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
              <p class="cite">{f.cite}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section dark blend interbeing" id="interbeing">
    <div class="wrap grid-2">
      <div class="reveal">
        <p class="eyebrow">Beyond people</p>
        <h2>Interbeing: there is a cloud in your tea</h2>
        <p>
          Thich Nhat Hanh often pointed to a cup of tea and saw a cloud in it. The cloud has not died: it became
          rain, then a river, then this tea. Nothing is only itself. It <em>inter-is</em> with everything that made it
          possible.
        </p>
        <p>
          Where belonging is warm, social and fragile, interbeing is quiet and continuous. It never really goes
          away. Our project lives between the two. It invites people to feel connected to each other, and also to
          something larger that was here before them and will continue after: weather, water, sky.
        </p>
        <p>
          Belonging in ourselves, with others, and with our environment are always connected. In this work, we lean
          towards the environment, and let the others follow.
        </p>
        <p>
          <a class="button" href={url('/installation/')}>See how the installation puts this into practice</a>
        </p>
      </div>
      <figure class="circles reveal" aria-label="Three overlapping circles: ourselves, others, environment">
        <svg viewBox="0 0 320 300" role="img" aria-hidden="true">
          <circle cx="120" cy="115" r="82" class="c1"></circle>
          <circle cx="200" cy="115" r="82" class="c2"></circle>
          <circle cx="160" cy="185" r="96" class="c3"></circle>
          <text x="88" y="98" text-anchor="middle">ourselves</text>
          <text x="232" y="98" text-anchor="middle">others</text>
          <text x="160" y="240" text-anchor="middle">environment</text>
        </svg>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Where mindfulness meets belonging</p>
        <h2>Practices that make room for each other</h2>
        <p class="lede measure">
          Our project began in contemplative practice. The literature suggests that some of its most powerful
          effects are social.
        </p>
      </div>
      <div class="grid-3">
        {
          practices.map((p) => (
            <article class="practice reveal">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
              {p.cite && <p class="cite">{p.cite}</p>}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section wash wash-sand why" id="why-art">
    <div class="wrap grid-2">
      <div class="reveal">
        <p class="eyebrow">Why art, why research-creation</p>
        <h2>Belonging can’t be streamed</h2>
      </div>
      <div class="reveal">
        <p>
          You can read about belonging, but you can’t download it. It happens between bodies in a shared place and a
          shared time. That is exactly what installations, rituals and performances are good at: they gather people,
          suspend ordinary rules for a while, and give attention something to rest on together.
        </p>
        <p>
          Research-creation lets us do both at once. We make something, invite people into it, and listen carefully
          to what they experience: through questionnaires, physiology and, above all, their own words. The artwork
          becomes a way of asking a question, and the question keeps reshaping the artwork.
        </p>
        <p>
          We think belonging deserves far more attention from artists and researchers, especially now, when so many
          people feel alone in crowded places.
        </p>
      </div>
    </div>
  </section>

    <section class="section built-in" id="into-a-room">
    <div class="wrap grid-2">
      <div class="reveal">
        <p class="eyebrow">An example of belonging</p>
        <h2>Belonging to nature, built into a room</h2>
        <p>
          Belonging to ourselves, to each other and to nature are always connected. <em>Cloudfulness</em> leans towards
          nature: a shared sky, weather and water, something larger that was here before us and will continue after.
        </p>
        <p>
          We started from what the research says belonging is, and turned each quality into a design choice.{' '}
          <a href={url('/installation/')}>See the installation →</a>
        </p>
      </div>
      <dl class="mapping reveal">
        {
          belongingMap.map((m) => (
            <div>
              <dt>{m.quality}</dt>
              <dd>
                <strong>{m.choice}</strong>
                {m.how}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section wash" id="why-a-cloud">
    <div class="wrap why-cloud">
      <div class="why-text">
        <p class="eyebrow reveal">Why a cloud</p>
        <h2 class="reveal">Something we all live under</h2>
        <div class="why-grid">
          {
            whyCloud.map((w) => (
              <div class="why-item reveal">
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </div>
            ))
          }
        </div>
      </div>
      <Figure
        src={alphaWarm}
        alt="Looking up from the floor at the fibre cloud glowing warm white, hanging from the ceiling in a dark room."
        caption="Looking up at the alpha cloud, 29 July 2026."
        ratio="3 / 4"
        widths={[400, 700, 1000]}
        sizes="(min-width: 60rem) 22rem, 100vw"
        class="reveal why-video"
      />
    </div>
  </section>

  <ScoreGrid />

  <section class="section wash wash-sky decisions" id="decisions">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">How we reasoned</p>
        <h2>Why it is the way it is</h2>
        <p class="lede measure">
          Every element of the installation answers a question about belonging. These are the decisions we made, and
          our reasons for them.
        </p>
      </div>
      <dl class="decision-list">
        {
          decisions.map((d) => (
            <div class="decision reveal">
              <dt>{d.choice}</dt>
              <dd>{d.why}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section questions dark blend" id="questions">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">An open invitation</p>
        <h2>Questions we are living with</h2>
        <p class="lede measure">
          We explored belonging to nature. Belonging to ourselves, to each other, to places and to communities are
          waiting to be explored too. We don’t have answers to these questions. If any of them pull at you, take them
          into your own practice, and tell us what you find.
        </p>
      </div>
      <div class="q-cols">
        <div>
          <h3 class="q-head reveal">About belonging</h3>
          <ul class="q-list">
            {questions.map((q) => <li class="reveal">{q}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="q-head reveal">About the cloud</h3>
          <ul class="q-list">
            {openQuestions.map((q) => <li class="reveal">{q}</li>)}
          </ul>
        </div>
      </div>
      <div class="actions reveal">
        <a class="button" href={url("/toolkit/")}>Use the belonging checklist</a>
        <a class="button" href={url("/process/#lessons")}>Read what we learned</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .big-quote {
    margin: 0;
    font-family: var(--font-display);
  }
  .big-quote p {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.6rem);
    line-height: 1.1;
    font-weight: 300;
    margin-bottom: 1.2rem;
  }
  .big-quote cite {
    font-family: var(--font-body);
    font-style: normal;
    font-size: 0.9rem;
    color: var(--ink-faint);
  }
  .section-head {
    margin-bottom: 3rem;
    max-width: 44rem;
  }
  .facets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .facet {
    background: var(--paper);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    grid-column: span 2;
  }
  .facet:nth-child(n + 4) {
    grid-column: span 3;
  }
  @media (max-width: 900px) {
    .facet,
    .facet:nth-child(n + 4) {
      grid-column: span 3;
    }
    .facet:last-child {
      grid-column: span 6;
    }
  }
  @media (max-width: 600px) {
    .facet,
    .facet:nth-child(n + 4) {
      grid-column: span 6;
    }
  }
  .num {
    display: block;
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--dusk);
    margin-bottom: 1.5rem;
  }
  .facet p {
    color: var(--ink-soft);
    font-size: 0.97rem;
  }
  .cite {
    font-size: 0.8rem !important;
    color: var(--ink-faint) !important;
    margin: 0;
  }
  .interbeing {
    background: radial-gradient(ellipse at 80% 30%, #4a5c9e, #262d5e 75%);
  }
  .interbeing p {
    color: var(--ink-soft);
  }
  .circles {
    margin: 0;
    display: grid;
    place-items: center;
  }
  .circles svg {
    width: min(100%, 26rem);
  }
  .circles circle {
    fill-opacity: 0.18;
    stroke-width: 1;
    stroke-opacity: 0.6;
    mix-blend-mode: screen;
  }
  .c1 {
    fill: #f8a98c;
    stroke: #f8a98c;
  }
  .c2 {
    fill: #9a9dea;
    stroke: #9a9dea;
  }
  .c3 {
    fill: #f9c77c;
    stroke: #f9c77c;
    fill-opacity: 0.28 !important;
  }
  .circles text {
    fill: #f1f2fc;
    font-family: var(--font-display);
    font-size: 15px;
    font-style: italic;
  }
  .practice {
    padding-top: 1.5rem;
    border-top: 1px solid var(--ink);
  }
  .practice p {
    color: var(--ink-soft);
  }
  .questions {
    background: linear-gradient(180deg, var(--night) 0%, #3a3478 100%);
  }
  .q-list {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .q-list li {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1rem + 1.2vw, 2rem);
    font-weight: 300;
    line-height: 1.3;
    padding-block: 1.2rem;
    border-bottom: 1px solid var(--line);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .built-in p {
    color: var(--ink-soft);
  }
  .built-in a {
    color: var(--ink);
  }
  .mapping {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .mapping div {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .mapping dt {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dusk);
    margin-bottom: 0.35rem;
  }
  .mapping dd {
    margin: 0;
    color: var(--ink-soft);
  }
  .mapping strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.25rem;
    color: var(--ink);
  }
  .why-cloud {
    display: grid;
    grid-template-columns: 1fr minmax(14rem, 22rem);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 2rem 2.5rem;
    margin-top: 2.5rem;
  }
  .why-item h3 {
    font-size: 1.3rem;
    margin-bottom: 0.3rem;
  }
  .why-item p {
    color: var(--ink-soft);
    font-size: 0.97rem;
    margin: 0;
  }
  :global(.why-video) {
    position: sticky;
    top: 6rem;
  }
  @media (max-width: 860px) {
    .why-cloud {
      grid-template-columns: 1fr;
    }
    :global(.why-video) {
      position: static;
      max-width: 22rem;
    }
  }

  .decision-list {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .decision {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) 2fr;
    gap: 1rem 3rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line);
  }
  .decision dt {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.65rem);
    line-height: 1.2;
  }
  .decision dd {
    margin: 0;
    color: var(--ink-soft);
  }
  @media (max-width: 700px) {
    .decision {
      grid-template-columns: 1fr;
    }
  }

  .q-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1rem clamp(2rem, 5vw, 5rem);
  }
  .q-head {
    font-size: 1.1rem;
    color: var(--ink-faint);
    margin-bottom: 0.5rem;
  }
</style>
