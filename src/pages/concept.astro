<script>
  const DURATION = 220;

  const animate = (body: HTMLElement, from: number, to: number) =>
    new Promise<void>((resolve) => {
      body.style.height = `${from}px`;
      body.style.transition = `height ${DURATION}ms ease`;
      requestAnimationFrame(() => {
        body.style.height = `${to}px`;
      });
      const done = () => {
        body.style.transition = '';
        body.style.height = '';
        body.removeEventListener('transitionend', done);
        resolve();
      };
      body.addEventListener('transitionend', done);
      // Safety timeout in case transitionend doesn't fire.
      window.setTimeout(done, DURATION + 80);
    });

  const closeDetails = async (d: HTMLDetailsElement) => {
    const body = d.querySelector<HTMLElement>('.facet-body');
    if (!body) { d.open = false; return; }
    const start = body.offsetHeight;
    await animate(body, start, 0);
    d.open = false;
  };

  const openDetails = async (d: HTMLDetailsElement) => {
    d.open = true;
    const body = d.querySelector<HTMLElement>('.facet-body');
    if (!body) return;
    const target = body.offsetHeight;
    await animate(body, 0, target);
  };

  document.querySelectorAll<HTMLElement>('details.facet-card > summary').forEach((summary) => {
    summary.addEventListener('click', async (event) => {
      event.preventDefault();
      const details = summary.parentElement as HTMLDetailsElement | null;
      if (!details) return;
      if (details.open) {
        await closeDetails(details);
        return;
      }
      const groupName = details.getAttribute('name');
      if (groupName) {
        const siblings = document.querySelectorAll<HTMLDetailsElement>(`details[name="${groupName}"]`);
        await Promise.all(
          Array.from(siblings)
            .filter((other) => other !== details && other.open)
            .map((other) => closeDetails(other)),
        );
      }
      await openDetails(details);
    });
  });
</script>
