---
import { url } from '../lib/url';
import { nav, site } from '../data/site';

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(url(href));
---

<header class:list={['site-header', { overlay }]} data-header>
  <div class="bar">
    <a href={url("/")} class="brand" aria-label={`${site.title} — home`}>
      <svg viewBox="80 290 900 480" aria-hidden="true" class="mark">
        <defs>
          <linearGradient id="mark-glow" x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" stop-color="#c3b6f0"></stop>
            <stop offset="1" stop-color="#f6b89c"></stop>
          </linearGradient>
        </defs>
        <g fill="none" stroke-linecap="round">
          <path
            stroke="currentColor"
            stroke-width="26"
            d="M870 745C640 650 420 760 190 735C90 720 80 560 250 528C265 470 330 440 410 452C460 300 720 290 780 515C900 470 1000 610 850 705"
          ></path>
          <path stroke="currentColor" stroke-width="12" opacity="0.7" d="M270 535C320 545 360 570 390 605"></path>
          <g stroke="url(#mark-glow)" stroke-width="12">
            <path d="M270 495C420 470 560 640 720 625C850 615 905 560 880 525"></path>
            <path d="M155 575C130 640 250 700 435 680"></path>
            <path d="M725 348C820 350 905 420 855 495"></path>
          </g>
        </g>
        <circle cx="840" cy="387" r="17" fill="#c3b6f0"></circle>
        <circle cx="173" cy="648" r="17" fill="#f6b89c"></circle>
        <circle cx="890" cy="583" r="9" fill="#f6b89c"></circle>
        <path fill="#f6c3b0" d="M716 410Q722 440 750 445Q722 450 716 480Q710 450 682 445Q710 440 716 410Z"></path>
      </svg>
      <span>{site.title}</span>
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="visually-hidden">Menu</span>
      <span class="lines" aria-hidden="true"></span>
    </button>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('menu-open', !open);
  });
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(248 247 244 / 0.84);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition: background 0.4s, border-color 0.4s, color 0.4s;
  }
  .site-header.scrolled {
    border-bottom-color: var(--line);
  }
  .site-header.overlay {
    position: fixed;
    inset: 0 0 auto;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    color: #fbfaff;
    transition: background 0.4s, border-color 0.4s, color 2s;
  }
  :global(html[data-hero-tone='light']) .site-header.overlay:not(.scrolled):not(.menu-open) {
    color: var(--ink);
  }
  .site-header.overlay.scrolled,
  .site-header.overlay.menu-open {
    background: rgb(27 34 80 / 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: rgb(255 255 255 / 0.08);
  }
  .bar {
    width: min(100% - 2 * var(--gutter), var(--wide));
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .mark {
    width: 2.6rem;
    height: auto;
  }
  nav ul {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    text-decoration: none;
    font-size: 0.92rem;
    opacity: 0.8;
    padding-block: 0.3rem;
    border-bottom: 1px solid transparent;
    transition: opacity 0.2s, border-color 0.2s;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    opacity: 1;
    border-bottom-color: currentColor;
  }
  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    color: inherit;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
    position: relative;
  }
  .lines,
  .lines::before,
  .lines::after {
    position: absolute;
    left: 50%;
    width: 1.4rem;
    height: 1.5px;
    background: currentColor;
    transform: translateX(-50%);
    transition: transform 0.3s, opacity 0.3s;
  }
  .lines {
    top: 50%;
  }
  .lines::before,
  .lines::after {
    content: '';
  }
  .lines::before {
    top: -6px;
  }
  .lines::after {
    top: 6px;
  }
  .menu-open .lines {
    background: transparent;
  }
  .menu-open .lines::before {
    transform: translateX(-50%) translateY(6px) rotate(45deg);
  }
  .menu-open .lines::after {
    transform: translateX(-50%) translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 760px) {
    .menu-toggle {
      display: block;
    }
    nav {
      position: absolute;
      inset: 100% 0 auto;
      background: inherit;
      display: none;
    }
    .site-header:not(.overlay) nav {
      background: var(--paper);
      border-bottom: 1px solid var(--line);
    }
    .overlay nav {
      background: rgb(27 34 80 / 0.95);
    }
    .menu-open nav {
      display: block;
    }
    nav ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem var(--gutter) 1.5rem;
    }
    nav a {
      display: block;
      padding: 0.8rem 0;
      font-family: var(--font-display);
      font-size: 1.4rem;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
