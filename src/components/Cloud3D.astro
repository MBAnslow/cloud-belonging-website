---
import type { CloudStateName } from '../lib/cloud/states';

interface Props {
  /** `cycle` moves through `cycle` states on its own; `controlled` listens for `cloud:state` events. */
  mode?: 'cycle' | 'controlled';
  initial?: CloudStateName;
  cycle?: CloudStateName[];
  /** x, y, scale of the cloud in world units, for wide and for tall containers. */
  place?: [number, number, number];
  placeNarrow?: [number, number, number];
  class?: string;
}

const {
  mode = 'controlled',
  initial = 'golden',
  cycle = ['golden', 'dusk', 'twilight', 'breath', 'dawn', 'day'],
  place = [0.6, 0.2, 0.7],
  placeNarrow = [0, 0.4, 0.42],
  class: className,
} = Astro.props;
---

<div
  class:list={['cloud3d', className]}
  data-cloud3d
  data-mode={mode}
  data-initial={initial}
  data-cycle={cycle.join(',')}
  data-place={place.join(',')}
  data-place-narrow={placeNarrow.join(',')}
  aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  import { CloudRenderer } from '../lib/cloud/renderer';
  import { cloudStates, type CloudStateName } from '../lib/cloud/states';

  const HOLD = 9000;
  const TRANSITION = 11000;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const parse = (s?: string) => (s ?? '').split(',').map(Number) as [number, number, number];
  const luma = (c: number[]) => 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];

  function mount(el: HTMLElement) {
    const canvas = el.querySelector('canvas')!;
    if (!CloudRenderer.supported()) {
      el.classList.add('no-webgl');
      return;
    }
    // ?sky=<state> pins a lighting state, handy for reviewing each look.
    const pinned = new URLSearchParams(location.search).get('sky') as CloudStateName | null;
    if (pinned && cloudStates[pinned]) {
      el.dataset.initial = pinned;
      el.dataset.mode = 'pinned';
    }
    const wide = parse(el.dataset.place);
    const narrow = parse(el.dataset.placeNarrow);
    const toneTarget = el.closest<HTMLElement>('[data-cloud-tone]');
    const global = toneTarget?.dataset.cloudTone === 'global';
    let tone = '';
    let headerTone = '';
    const pick = (l: number, prev: string) => (l > 0.62 ? 'light' : l < 0.55 ? 'dark' : prev);

    let renderer: CloudRenderer;
    try {
      renderer = new CloudRenderer(canvas, cloudStates[(el.dataset.initial ?? 'golden') as CloudStateName], {
        animate: !reduce,
        placement: () => {
          const r = el.getBoundingClientRect();
          const [x, y, scale] = r.width / Math.max(r.height, 1) < 0.9 ? narrow : wide;
          return { x, y, scale };
        },
        onFrame: (s) => {
          if (!toneTarget) return;
          // Hero text sits low, near the horizon; the header sits at the very top, where the sky is almost pure skyTop.
          const next = pick(luma(s.skyHorizon.map((v, i) => v * 0.7 + s.skyTop[i] * 0.3)), tone);
          if (next && next !== tone) {
            tone = next;
            toneTarget.dataset.tone = tone;
          }
          if (!global) return;
          const nextHeader = pick(luma(s.skyTop), headerTone);
          if (nextHeader && nextHeader !== headerTone) {
            headerTone = nextHeader;
            document.documentElement.dataset.heroTone = headerTone;
          }
        },
      });
    } catch (err) {
      console.warn('Cloud renderer unavailable', err);
      el.classList.add('no-webgl');
      return;
    }
    el.classList.add('ready');

    if (el.dataset.mode === 'cycle' && !reduce) {
      const names = (el.dataset.cycle ?? '').split(',') as CloudStateName[];
      let i = Math.max(0, names.indexOf(el.dataset.initial as CloudStateName));
      setInterval(() => {
        if (document.hidden) return;
        i = (i + 1) % names.length;
        renderer.setState(cloudStates[names[i]], TRANSITION);
      }, HOLD + TRANSITION);
    }

    el.addEventListener('cloud:state', (e) => {
      const name = (e as CustomEvent<CloudStateName>).detail;
      if (cloudStates[name]) renderer.setState(cloudStates[name], reduce ? 600 : 2600);
    });

    let visible = false;
    const sync = () => (visible && !document.hidden ? renderer.start() : renderer.stop());
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(el);
    document.addEventListener('visibilitychange', sync);
  }

  document.querySelectorAll<HTMLElement>('[data-cloud3d]').forEach(mount);
</script>

<style>
  .cloud3d {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: linear-gradient(to bottom, #877cbe, #f8a98c);
  }
  canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .ready canvas {
    opacity: 1;
  }
  .no-webgl {
    background:
      radial-gradient(ellipse 30% 22% at 68% 40%, rgb(255 236 214 / 0.9), transparent 70%),
      radial-gradient(ellipse 22% 16% at 58% 46%, rgb(220 167 211 / 0.8), transparent 70%),
      linear-gradient(to bottom, #877cbe, #f8a98c);
  }
</style>
