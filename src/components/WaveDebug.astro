<script>
  type Wave = {
    height: number;
    baseline: number;
    amplitude: number;
    waves: number;
    phase: number;
    ripple: number;
    rippleFreq: number;
    blur: number;
  };

  const wave: Wave = {
    height: 6.25,
    baseline: 56,
    amplitude: 39,
    waves: 2.4,
    phase: 0,
    ripple: 0.43,
    rippleFreq: 2.5,
    blur: 3,
  };
  const mobileWave: Wave = {
    height: 2.75,
    baseline: 56,
    amplitude: 20,
    waves: 2.15,
    phase: 0.01,
    ripple: 0.43,
    rippleFreq: 2.15,
    blur: 2.5,
  };

  const params = new URLSearchParams(location.search);
  if (!document.querySelector('.wave-debug')) {
    const controls: [keyof Wave, string, number, number, number][] = [
      ['height', 'Boundary depth (rem)', 1, 16, 0.25],
      ['baseline', 'Wave centre line (% of depth)', 10, 90, 1],
      ['amplitude', 'Wave height (% of depth)', 0, 45, 1],
      ['waves', 'Number of swells across', 0.25, 6, 0.05],
      ['phase', 'Swell position (shift)', 0, 1, 0.01],
      ['ripple', 'Secondary ripple strength', 0, 1, 0.01],
      ['rippleFreq', 'Secondary ripple frequency', 1, 8, 0.05],
      ['blur', 'Edge softness (blur)', 0, 40, 0.5],
    ];

    const svg = (w: Wave, phaseOffset = 0) => {
      const pts: string[] = [];
      const n = 120;
      for (let i = 0; i <= n; i++) {
        const t = i / n;
        const phase = w.phase + phaseOffset;
        const a = Math.sin(2 * Math.PI * (w.waves * t + phase));
        const b = Math.sin(2 * Math.PI * (w.rippleFreq * w.waves * t + phase * 1.7));
        const y = 120 * (w.baseline / 100 + (w.amplitude / 100) * ((a + w.ripple * b) / (1 + w.ripple)));
        pts.push(`${(-40 + t * 1520).toFixed(1)} ${y.toFixed(1)}`);
      }
      const markup =
        `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1440 120' preserveAspectRatio='none'>` +
        `<filter id='f' x='-5%' y='-50%' width='110%' height='200%'><feGaussianBlur stdDeviation='${w.blur}'/></filter>` +
        `<path filter='url(#f)' d='M-40 -40H1480V${pts[pts.length - 1].split(' ')[1]}L${pts.reverse().join('L')}Z'/></svg>`;
      return `url("data:image/svg+xml,${encodeURIComponent(markup)}")`;
    };

    const boundaries = Array.from(document.querySelectorAll<HTMLElement>('.blend')).map((element) => ({
      element,
      topPhase: Math.random(),
      bottomPhase: Math.random(),
    }));

    const apply = () => {
      const root = document.documentElement.style;
      root.setProperty('--wave-height', `${wave.height}rem`);
      root.setProperty('--mobile-wave-height', `${mobileWave.height}rem`);
      boundaries.forEach(({ element, topPhase, bottomPhase }) => {
        element.style.setProperty('--wave-top', svg(wave, topPhase));
        element.style.setProperty('--wave-bottom', svg(wave, bottomPhase));
        element.style.setProperty('--wave-top-mobile', svg(mobileWave, topPhase));
        element.style.setProperty('--wave-bottom-mobile', svg(mobileWave, bottomPhase));
      });
    };

    apply();
    if (params.has('wave-debug') || params.has('mobile-wave-debug')) {
      const mobile = params.has('mobile-wave-debug');
      const debugWave = mobile ? mobileWave : wave;

      const panel = document.createElement('div');
      panel.className = 'wave-debug';
      panel.innerHTML = `<strong>${mobile ? 'Mobile wave boundaries' : 'Wave boundaries'}</strong>${controls
      .map(
        ([key, label, min, max, step]) =>
          `<label>${label}<span><input type="range" name="${key}" min="${min}" max="${max}" step="${step}" value="${debugWave[key]}"><output>${debugWave[key]}</output></span></label>`,
      )
      .join('')}<button type="button">Copy values</button>`;
    panel.addEventListener('input', (e) => {
      const input = e.target as HTMLInputElement;
      debugWave[input.name as keyof Wave] = Number(input.value);
      input.nextElementSibling!.textContent = input.value;
      apply();
    });
    panel.querySelector('button')!.addEventListener('click', (e) => {
      navigator.clipboard.writeText(JSON.stringify(debugWave));
      (e.target as HTMLButtonElement).textContent = 'Copied';
    });
    Object.assign(panel.style, {
      position: 'fixed', left: '1rem', bottom: '1rem', zIndex: '9999', width: '18rem', padding: '0.9rem 1rem',
      display: 'grid', gap: '0.55rem', font: '12px/1.3 system-ui, sans-serif', color: '#111',
      background: 'rgba(255,255,255,0.94)', border: '1px solid #ccc', borderRadius: '8px', boxShadow: '0 6px 24px rgba(0,0,0,0.15)',
    });
    panel.querySelectorAll('label').forEach((l) => Object.assign(l.style, { display: 'grid', gap: '0.2rem' }));
    panel.querySelectorAll('label span').forEach((s) => Object.assign((s as HTMLElement).style, { display: 'flex', gap: '0.5rem', alignItems: 'center' }));
    panel.querySelectorAll('input').forEach((i) => (i.style.flex = '1'));
      document.body.append(panel);
      apply();
    }
  }
</script>
