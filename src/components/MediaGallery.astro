---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../lib/url';

export type GalleryItem =
  | { image: ImageMetadata; alt: string; caption?: string }
  | { video: string; alt?: string; caption?: string; portrait?: boolean; sound?: boolean; ratio?: number };

interface Props {
  items: GalleryItem[];
  columns?: number;
  title?: string;
  description?: string;
  numeral?: string;
  class?: string;
}

const { items, columns = 3, title, description, numeral, class: className } = Astro.props;

const tiles = await Promise.all(
  items.map(async (item) => {
    if ('image' in item) {
      const full = await getImage({ src: item.image, width: Math.min(2000, item.image.width) });
      return { ...item, kind: 'image' as const, full: full.src, r: item.image.width / item.image.height };
    }
    return {
      ...item,
      kind: 'video' as const,
      src: url(`/video/${item.video}.mp4`),
      poster: url(`/video/${item.video}.jpg`),
      r: item.ratio ?? (item.portrait ? 9 / 16 : 16 / 9),
    };
  }),
);
---

<section class:list={['frame', className]}>
{
  (title || description) && (
    <header class="frame-head">
      {title && (
        <h3>
          {numeral && <span class="numeral">{numeral}</span>}
          {title}
        </h3>
      )}
      {description && <p>{description}</p>}
      <span class="count">{items.length} {items.length === 1 ? 'item' : 'items'}</span>
    </header>
  )
}
<div class:list={["gallery", { "one-row": items.length <= 4 }]} style={`--h:${items.length <= 4 ? 4 : columns >= 4 ? 10 : 15}rem`} data-gallery>
  {
    tiles.map((t, i) => (
      <button
        type="button"
        class="tile"
        style={`--r:${t.r.toFixed(4)}`}
        data-index={i}
        data-kind={t.kind}
        data-src={t.kind === 'image' ? t.full : t.src}
        data-poster={t.kind === 'video' ? t.poster : undefined}
        data-sound={t.kind === 'video' && t.sound ? 'true' : undefined}
        data-caption={t.caption ?? ''}
        data-alt={t.alt ?? t.caption ?? ''}
        aria-label={`Open ${t.caption ?? t.alt ?? 'media'} in the viewer`}>
        {t.kind === 'image' ? (
          <Image src={t.image} alt={t.alt} widths={[400, 700, 1000]} sizes={`(min-width: 72rem) ${Math.round(72 / columns)}rem, 50vw`} />
        ) : (
          <video src={t.src} poster={t.poster} muted loop playsinline preload="none" data-tile-video aria-hidden="true"></video>
        )}
        {t.kind === 'video' && (
          <span class="badge" aria-hidden="true">
            {t.sound ? '♪ Sound' : '▶'}
          </span>
        )}
        {t.caption && <span class="caption">{t.caption}</span>}
      </button>
    ))
  }
</div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let dialog: HTMLDialogElement | null = null;
  let stage: HTMLElement;
  let captionEl: HTMLElement;
  let countEl: HTMLElement;
  let current: HTMLElement[] = [];
  let index = 0;

  function ensureDialog() {
    if (dialog) return dialog;
    dialog = document.createElement('dialog');
    dialog.className = 'lightbox';
    dialog.innerHTML = `
      <div class="lb-stage"></div>
      <p class="lb-caption"><span class="lb-count"></span><span class="lb-text"></span></p>
      <button type="button" class="lb-btn lb-close" aria-label="Close">×</button>
      <button type="button" class="lb-btn lb-prev" aria-label="Previous">‹</button>
      <button type="button" class="lb-btn lb-next" aria-label="Next">›</button>`;
    document.body.append(dialog);
    stage = dialog.querySelector('.lb-stage')!;
    captionEl = dialog.querySelector('.lb-text')!;
    countEl = dialog.querySelector('.lb-count')!;
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog!.close());
    dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === stage) dialog!.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => {
      stage.innerHTML = '';
      document.documentElement.classList.remove('lightbox-open');
      document.querySelectorAll<HTMLVideoElement>('[data-tile-video]').forEach((v) => {
        if (v.dataset.wasPlaying) v.play().catch(() => {});
        delete v.dataset.wasPlaying;
      });
    });
    return dialog;
  }

  function show(i: number) {
    index = (i + current.length) % current.length;
    const t = current[index];
    stage.innerHTML = '';
    if (t.dataset.kind === 'image') {
      const img = document.createElement('img');
      img.src = t.dataset.src!;
      img.alt = t.dataset.alt ?? '';
      stage.append(img);
    } else {
      const v = document.createElement('video');
      v.src = t.dataset.src!;
      v.poster = t.dataset.poster ?? '';
      v.controls = true;
      v.playsInline = true;
      v.loop = !t.dataset.sound;
      v.muted = !t.dataset.sound;
      v.autoplay = true;
      stage.append(v);
    }
    captionEl.textContent = t.dataset.caption ?? '';
    countEl.textContent = current.length > 1 ? `${index + 1} / ${current.length}` : '';
    dialog!.classList.toggle('single', current.length < 2);
  }

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const tiles = [...gallery.querySelectorAll<HTMLElement>('.tile')];
    tiles.forEach((tile, i) =>
      tile.addEventListener('click', () => {
        current = tiles;
        document.querySelectorAll<HTMLVideoElement>('[data-tile-video]').forEach((v) => {
          if (!v.paused) v.dataset.wasPlaying = 'true';
          v.pause();
        });
        document.documentElement.classList.add('lightbox-open');
        ensureDialog().showModal();
        show(i);
      }),
    );
    if (reduce) return;
    const io = new IntersectionObserver((entries) => {
      for (const { target, isIntersecting } of entries) {
        const v = target as HTMLVideoElement;
        if (isIntersecting && !document.documentElement.classList.contains('lightbox-open')) v.play().catch(() => {});
        else v.pause();
      }
    });
    gallery.querySelectorAll<HTMLVideoElement>('[data-tile-video]').forEach((v) => io.observe(v));
  });
</script>

<style>
  .frame {
    --fade: 2rem;
    position: relative;
    isolation: isolate;
    padding: 0.75rem;
    color: #e6e8f7;
  }
  .frame::before {
    content: '';
    position: absolute;
    inset: calc(var(--fade) * -1);
    z-index: -1;
    background: #0a0c1f;
    --edge-x: linear-gradient(90deg, transparent, #000 var(--fade), #000 calc(100% - var(--fade)), transparent);
    --edge-y: linear-gradient(180deg, transparent, #000 var(--fade), #000 calc(100% - var(--fade)), transparent);
    -webkit-mask-image: var(--edge-x), var(--edge-y);
    -webkit-mask-composite: source-in;
    mask-image: var(--edge-x), var(--edge-y);
    mask-composite: intersect;
    pointer-events: none;
  }
  .frame:not(:first-child) {
    margin-top: 1.5rem;
  }
  .frame-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.9rem;
    padding: 0.2rem 0.35rem 0.7rem;
  }
  .frame-head h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.15rem;
    color: #fff;
  }
  .numeral {
    margin-right: 0.55rem;
    letter-spacing: 0.06em;
    opacity: 0.4;
  }
  .frame-head p {
    flex: 1;
    margin: 0;
    font-size: 0.82rem;
    opacity: 0.6;
  }
  .count {
    margin-left: auto;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.4;
  }
  .gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .gallery:not(.one-row)::after {
    content: '';
    flex-grow: 999;
  }
  @media (max-width: 700px) {
    .gallery {
      --h: 7rem !important;
      gap: 0.6rem;
    }
  }
  .tile {
    position: relative;
    display: block;
    flex: var(--r) 1 calc(var(--r) * var(--h));
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0.55rem;
    overflow: hidden;
    cursor: zoom-in;
    background: rgb(255 255 255 / 0.04);
    font: inherit;
    color: #fff;
    text-align: left;
  }
  .tile :global(img),
  .tile video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--r);
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.6s;
  }
  .tile:hover :global(img),
  .tile:hover video,
  .tile:focus-visible :global(img),
  .tile:focus-visible video {
    transform: scale(1.035);
  }
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    pointer-events: none;
  }
  .caption {
    position: absolute;
    right: 0.75rem;
    bottom: 0.6rem;
    max-width: calc(100% - 1.5rem);
    padding: 0.2rem 0.55rem;
    border-radius: 0.4rem;
    font-size: 0.75rem;
    line-height: 1.35;
    text-align: right;
    color: rgb(255 255 255 / 0.55);
    background: rgb(8 10 28 / 0.25);
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.6);
    transition: color 0.3s, background 0.3s;
  }
  .tile:hover .caption,
  .tile:focus-visible .caption,
  .tile:active .caption {
    color: #fff;
    background: rgb(8 10 28 / 0.6);
  }
  .badge {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    background: rgb(8 10 28 / 0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  :global(.lightbox) {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #060816;
    color: #eceefb;
  }
  :global(html.lightbox-open) {
    overflow: hidden;
  }
  :global(html.lightbox-open [data-tile-video]) {
    visibility: hidden;
  }
  :global(.lightbox::backdrop) {
    background: rgb(6 8 22 / 0.85);
  }
  :global(.lightbox .lb-stage) {
    position: absolute;
    inset: 3.5rem 4.5rem 5rem;
    display: grid;
    place-items: center;
  }
  :global(.lightbox .lb-stage img),
  :global(.lightbox .lb-stage video) {
    max-width: 100%;
    max-height: calc(100dvh - 8.5rem);
    border-radius: 0.6rem;
    box-shadow: 0 30px 80px -30px #000;
  }
  :global(.lightbox .lb-caption) {
    position: absolute;
    inset: auto 1.5rem 1.5rem;
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    margin: 0;
    font-size: 0.92rem;
    text-align: right;
  }
  :global(.lightbox .lb-count) {
    font-family: var(--font-display);
    font-style: italic;
    opacity: 0.6;
  }
  :global(.lightbox .lb-btn) {
    position: absolute;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(255 255 255 / 0.06);
    color: inherit;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s;
  }
  :global(.lightbox .lb-btn:hover) {
    background: rgb(255 255 255 / 0.16);
  }
  :global(.lightbox .lb-close) {
    top: 1rem;
    right: 1rem;
  }
  :global(.lightbox .lb-prev),
  :global(.lightbox .lb-next) {
    top: 50%;
    transform: translateY(-50%);
  }
  :global(.lightbox .lb-prev) {
    left: 1rem;
  }
  :global(.lightbox .lb-next) {
    right: 1rem;
  }
  :global(.lightbox.single .lb-prev),
  :global(.lightbox.single .lb-next) {
    display: none;
  }
  @media (max-width: 700px) {
    :global(.lightbox .lb-stage) {
      inset: 3.5rem 0.75rem 5rem;
    }
    :global(.lightbox .lb-prev),
    :global(.lightbox .lb-next) {
      top: auto;
      bottom: 4.5rem;
      transform: none;
    }
  }
</style>
