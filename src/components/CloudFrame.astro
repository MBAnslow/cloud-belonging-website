---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { cloudMasks, defaultTexture, fadeVars } from '../lib/cloudMask';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  seed?: number;
  loading?: 'eager' | 'lazy';
  keep?: [number, number, number, number][];
  class?: string;
}

const { src, alt, widths = [600, 1000, 1400], sizes = '100vw', seed = 3, loading = 'lazy', keep = [], class: className } = Astro.props;
const { mask, spill } = cloudMasks(seed, keep);
---

<div
  class:list={['cloud-frame', className]}
  style={`--mask:${mask};--spill:${spill};${fadeVars(defaultTexture)}`}
  data-seed={seed}
  data-keep={JSON.stringify(keep)}
>
  <Image src={src} alt="" widths={[400]} sizes="400px" loading={loading} class="spill" aria-hidden="true" />
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} class="main" />
</div>

<script>
  import { cloudMasks, defaultTexture, fadeVars, type CloudTexture } from '../lib/cloudMask';

  const params = new URLSearchParams(location.search);
  if (params.has('cloud-debug') && !document.querySelector('.cloud-debug')) {
    const texture: CloudTexture = { ...defaultTexture };
    const controls: [keyof CloudTexture, string, number, number, number][] = [
      ['grainScale', 'Edge grain size (low = zoomed in)', 0.05, 1.5, 0.01],
      ['grainAmount', 'Edge grain strength', 0, 1.5, 0.01],
      ['fringeOpacity', 'Outer fringe opacity', 0, 1, 0.01],
      ['spillGrainScale', 'Spill grain size (low = zoomed in)', 0.05, 1.5, 0.01],
      ['spillGrainAmount', 'Spill grain strength', 0, 1.5, 0.01],
      ['fadeStart', 'Photo fade starts (% from centre)', 0, 100, 1],
      ['fadeEnd', 'Photo fully faded (% from centre)', 1, 140, 1],
      ['spillFadeStart', 'Spill fade starts (% from centre)', 0, 100, 1],
      ['spillFadeEnd', 'Spill fully faded (% from centre)', 1, 140, 1],
      ['scale', 'Image scale', 0.8, 1.6, 0.01],
    ];

    const apply = () => {
      document.querySelectorAll<HTMLElement>('.cloud-frame').forEach((el) => {
        const { mask, spill } = cloudMasks(Number(el.dataset.seed), JSON.parse(el.dataset.keep || '[]'), texture);
        el.style.setProperty('--mask', mask);
        el.style.setProperty('--spill', spill);
        fadeVars(texture).split(';').forEach((d) => {
          const [k, v] = d.split(':');
          el.style.setProperty(k, v);
        });
      });
    };

    const panel = document.createElement('div');
    panel.className = 'cloud-debug';
    panel.innerHTML = `<strong>Cloud crop texture</strong>${controls
      .map(
        ([key, label, min, max, step]) =>
          `<label>${label}<span><input type="range" name="${key}" min="${min}" max="${max}" step="${step}" value="${texture[key]}"><output>${texture[key]}</output></span></label>`,
      )
      .join('')}<button type="button">Copy values</button>`;
    panel.addEventListener('input', (e) => {
      const input = e.target as HTMLInputElement;
      texture[input.name as keyof CloudTexture] = Number(input.value);
      input.nextElementSibling!.textContent = input.value;
      apply();
    });
    panel.querySelector('button')!.addEventListener('click', (e) => {
      navigator.clipboard.writeText(JSON.stringify(texture));
      (e.target as HTMLButtonElement).textContent = 'Copied';
    });
    Object.assign(panel.style, {
      position: 'fixed', right: '1rem', bottom: '1rem', zIndex: '9999', width: '18rem', padding: '0.9rem 1rem',
      display: 'grid', gap: '0.55rem', font: '12px/1.3 system-ui, sans-serif', color: '#111',
      background: 'rgba(255,255,255,0.94)', border: '1px solid #ccc', borderRadius: '8px', boxShadow: '0 6px 24px rgba(0,0,0,0.15)',
    });
    panel.querySelectorAll('label').forEach((l) => Object.assign(l.style, { display: 'grid', gap: '0.2rem' }));
    panel.querySelectorAll('label span').forEach((s) => Object.assign((s as HTMLElement).style, { display: 'flex', gap: '0.5rem', alignItems: 'center' }));
    panel.querySelectorAll('input').forEach((i) => (i.style.flex = '1'));
    document.body.append(panel);
  }
</script>

<style>
  .cloud-frame {
    position: relative;
    isolation: isolate;
    scale: var(--cloud-scale, 1);
  }
  .cloud-frame :global(img.main) {
    display: block;
    width: 100%;
    height: auto;
    -webkit-mask-image: var(--mask), radial-gradient(closest-side, #000 var(--fade-start), transparent var(--fade-end));
    mask-image: var(--mask), radial-gradient(closest-side, #000 var(--fade-start), transparent var(--fade-end));
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  .cloud-frame :global(img.spill) {
    position: absolute;
    inset: -5% -7%;
    z-index: -1;
    width: 114%;
    height: 110%;
    max-width: none;
    aspect-ratio: auto;
    object-fit: cover;
    filter: blur(14px) saturate(1.6) brightness(1.05);
    opacity: 0.8;
    -webkit-mask-image: var(--spill), radial-gradient(closest-side, #000 var(--spill-fade-start), transparent var(--spill-fade-end));
    mask-image: var(--spill), radial-gradient(closest-side, #000 var(--spill-fade-start), transparent var(--spill-fade-end));
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    pointer-events: none;
  }
</style>
