---
interface Props {
  set?: 'dusk' | 'dawn' | 'full';
  labels?: boolean;
  class?: string;
}

const palettes = {
  dusk: ['#344c9e', '#9a9dea', '#f8a98c', '#f9c77c', '#fae7c6'],
  dawn: ['#4455bf', '#dca7d3', '#faa67a', '#fcdcaa'],
  full: ['#1b2250', '#3b52b4', '#9a9dea', '#877cbe', '#dca7d3', '#f8a98c', '#f9c77c', '#fae7c6'],
};

const names: Record<string, string> = {
  '#1b2250': 'Midnight',
  '#3b52b4': 'Ultramarine',
  '#9a9dea': 'Periwinkle',
  '#877cbe': 'Violet',
  '#dca7d3': 'Lilac',
  '#f8a98c': 'Coral',
  '#f9c77c': 'Amber',
  '#fae7c6': 'Cream',
};

const { set = 'dusk', labels = false, class: className } = Astro.props;
const colours = palettes[set];
---

<ul class:list={['swatches', { labelled: labels }, className]} aria-hidden={labels ? undefined : 'true'}>
  {
    colours.map((c) => (
      <li>
        <span class="dot" style={`background:${c}`} />
        {labels && <span class="name">{names[c]}</span>}
      </li>
    ))
  }
</ul>

<style>
  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dot {
    display: block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(127 132 190 / 0.35);
  }
  .labelled {
    gap: 1rem 1.4rem;
  }
  .labelled li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .labelled .dot {
    width: 1.1rem;
    height: 1.1rem;
  }
  .name {
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
</style>
