---
export interface ContentsItem {
  id: string;
  label: string;
  desc: string;
  /** Inner SVG markup on a 48×48 grid; `stroke="url(#toc-glow)"` gives the accent gradient. */
  icon: string;
}

export interface ContentsGroup {
  id: string;
  title: string;
  /** Accent colour for the group, matching its sections on the page. */
  tone: string;
  items: ContentsItem[];
}

interface Props {
  groups: ContentsGroup[];
}

const { groups } = Astro.props;
let n = 0;
---

<nav class="contents" aria-label="On this page">
  <div class="wrap">
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <linearGradient id="toc-glow" x1="0" x2="1">
        <stop offset="0" stop-color="#b3a4ee"></stop>
        <stop offset="1" stop-color="#f6a98a"></stop>
      </linearGradient>
    </svg>
    <p class="eyebrow ruled">On this page</p>
    {
      groups.map((g, gi) => (
        <section class="group" style={`--tone:${g.tone}`}>
          <a class="group-head" href={`#${g.id}`}>
            <span class="part">Part {gi + 1}</span>
            <span class="group-title">{g.title}</span>
          </a>
          <ol>
            {g.items.map((c) => (
              <li>
                <a href={`#${c.id}`}>
                  <svg class="icon" viewBox="0 0 48 48" aria-hidden="true">
                    <Fragment set:html={c.icon} />
                  </svg>
                  <span class="num">{String(++n).padStart(2, '0')}</span>
                  <span class="label">{c.label}</span>
                  <span class="desc">{c.desc}</span>
                  <span class="arrow" aria-hidden="true">↓</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</nav>

<style>
  .contents {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    background:
      radial-gradient(ellipse 40% 80% at 0% 100%, rgb(179 164 238 / 0.18), transparent 70%),
      radial-gradient(ellipse 40% 80% at 100% 0%, rgb(246 169 138 / 0.16), transparent 70%),
      var(--paper-deep);
  }
  .group + .group {
    margin-top: 2.25rem;
  }
  .group-head {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid color-mix(in srgb, var(--tone) 55%, transparent);
    text-decoration: none;
    color: inherit;
  }
  .part {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tone);
    font-weight: 600;
  }
  .group-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.9rem);
  }
  .contents ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
  }
  .contents li a {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem 1.5rem 1.4rem;
    border-radius: var(--radius);
    background: linear-gradient(170deg, color-mix(in srgb, var(--tone) 12%, white), rgb(255 255 255 / 0.8) 60%);
    border: 1px solid rgb(255 255 255 / 0.9);
    border-top: 3px solid color-mix(in srgb, var(--tone) 70%, white);
    box-shadow: 0 1px 2px rgb(27 34 84 / 0.04), 0 10px 30px -12px rgb(27 34 84 / 0.12);
    text-decoration: none;
    color: inherit;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .contents li a:hover {
    transform: translateY(-4px);
    box-shadow: 0 2px 4px rgb(27 34 84 / 0.05), 0 22px 40px -16px color-mix(in srgb, var(--tone) 45%, transparent);
  }
  .contents .icon {
    width: 3.75rem;
    height: 3.75rem;
    padding: 0.55rem;
    margin-bottom: 1.25rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, color-mix(in srgb, var(--tone) 30%, transparent) 75%);
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .contents .num {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--ink-faint);
  }
  .contents .label {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }
  .contents .desc {
    font-size: 0.88rem;
    color: var(--ink-soft);
    flex: 1;
  }
  .contents .arrow {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--tone);
    transition: transform 0.35s ease;
  }
  .contents li a:hover .arrow {
    transform: translateY(3px);
  }
  :global(main [id]) {
    scroll-margin-top: 4.5rem;
  }
  :global(html.theme-night) .contents li a {
    background: rgb(255 255 255 / 0.05);
    border-color: rgb(255 255 255 / 0.1);
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.5);
  }
  :global(html.theme-night) .contents li a:hover {
    background: rgb(255 255 255 / 0.08);
  }
</style>
