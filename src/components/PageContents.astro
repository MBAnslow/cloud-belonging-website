---
export interface ContentsItem {
  id: string;
  label: string;
  desc: string;
  /** Inner SVG markup on a 48×48 grid; `stroke="url(#toc-glow)"` gives the accent gradient. */
  icon: string;
}

export interface BandGradient {
  /** Colour used at each gradient stop. Defaults to the section tone. */
  c1?: string;
  c2?: string;
  c3?: string;
  /** % of the tone mixed into the paper at each gradient stop. */
  m1: number;
  m2: number;
  m3: number;
  /** Position of each stop as a % of the band height. */
  p1: number;
  p2: number;
  p3: number;
  /** White highlight strength (0–1) and position (% across, % down). */
  glow: number;
  glowX: number;
  glowY: number;
}

const defaultGradient: BandGradient = { m1: 10, m2: 18, m3: 30, p1: 0, p2: 45, p3: 100, glow: 0.45, glowX: 85, glowY: 30 };

export interface ContentsGroup {
  id: string;
  title: string;
  /** Accent colour shared with the part's band on the page. */
  tone: string;
  /** Colour for the small "Part X" label in the main section header. */
  labelColor?: string;
  /** Preview-only colour strength multiplier for the "On this page" mini map. */
  previewAlpha?: number;
  gradient?: Partial<BandGradient>;
  items: ContentsItem[];
}

interface Props {
  groups: ContentsGroup[];
}

const { groups } = Astro.props;
let n = 0;
const bandStyle = (g: ContentsGroup, i: number) => {
  const v = { ...defaultGradient, ...g.gradient };
  return [
    `--tone:${g.tone}`,
    `--c1:${v.c1 ?? g.tone}`,
    `--c2:${v.c2 ?? g.tone}`,
    `--c3:${v.c3 ?? g.tone}`,
    `--m1:${v.m1}%`,
    `--m2:${v.m2}%`,
    `--m3:${v.m3}%`,
    `--p1:${v.p1}%`,
    `--p2:${v.p2}%`,
    `--p3:${v.p3}%`,
    `--glow:${v.glow}`,
    `--glow-x:${v.glowX}%`,
    `--glow-y:${v.glowY}%`,
    `--preview-alpha:${g.previewAlpha ?? 1}`,
    `z-index:${groups.length - i}`,
  ].join(';');
};
---

<nav class="contents" aria-label="On this page">
  <div class="wrap">
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <linearGradient id="toc-glow" x1="0" x2="1">
        <stop offset="0" stop-color="#b3a4ee"></stop>
        <stop offset="1" stop-color="#f6a98a"></stop>
      </linearGradient>
    </svg>
    <p class="eyebrow ruled">On this page</p>
    <div class="mini">
    {
      groups.map((g, gi) => (
        <div class="band" style={bandStyle(g, gi)} data-id={g.id} data-title={g.title} data-tone={g.tone} data-label-color={g.labelColor ?? ''} data-preview-alpha={g.previewAlpha ?? 1} data-gradient={JSON.stringify({ ...defaultGradient, ...g.gradient })}>
          <a class="group" href={`#${g.id}`}>
            <span class="part">Part {gi + 1}</span>
            <span class="group-title">{g.title}</span>
          </a>
          <ol>
            {g.items.map((c) => (
              <li>
                <a href={`#${c.id}`}>
                  <svg class="icon" viewBox="0 0 48 48" aria-hidden="true">
                    <Fragment set:html={c.icon} />
                  </svg>
                  <span class="num">{String(++n).padStart(2, '0')}</span>
                  <span class="label">{c.label}</span>
                  <span class="desc">{c.desc}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
    </div>
  </div>
</nav>

<style>
  .contents {
    position: relative;
    z-index: 2;
    padding-block: clamp(3.5rem, 6vw, 5rem);
    background: #fff;
  }
  .contents::before,
  .contents::after {
    content: none;
  }
  .contents ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 13rem));
    justify-content: center;
    gap: 0.9rem;
  }
  .contents .mini {
    --wave-depth: 3rem;
    border-radius: calc(var(--radius) * 1.5);
    overflow: hidden;
    filter: drop-shadow(0 18px 30px rgb(27 34 84 / 0.12));
  }
  .contents .band {
    --stop-1: color-mix(in srgb, var(--c1) calc(var(--m1) * var(--preview-alpha)), var(--paper));
    --stop-2: color-mix(in srgb, var(--c2) calc(var(--m2) * var(--preview-alpha)), var(--paper));
    --stop-3: color-mix(in srgb, var(--c3) calc(var(--m3) * var(--preview-alpha)), var(--paper));
    position: relative;
    isolation: isolate;
    padding: 3rem clamp(1.25rem, 3vw, 2.25rem);
    background:
      radial-gradient(ellipse 50% 70% at var(--glow-x) var(--glow-y), rgb(255 255 255 / var(--glow)), transparent 70%),
      linear-gradient(180deg, var(--stop-1) var(--p1), var(--stop-2) var(--p2), var(--stop-3) var(--p3));
  }
  .contents .band + .band {
    padding-top: 3rem;
  }
  .contents .band::after {
    content: none;
  }
  .contents .band:last-child {
    padding-bottom: 3rem;
  }
  .contents .group {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.35rem;
    color: var(--ink);
    text-align: center;
    text-decoration: none;
  }
  .contents .part {
    font-size: 0.82rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    color: color-mix(in srgb, var(--tone) 75%, var(--ink));
  }
  .contents .group-title {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 1.4rem + 1vw, 2.35rem);
  }
  .contents li a {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 10rem;
    padding: 1.15rem 1.15rem 1rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.75);
    border: 1px solid rgb(255 255 255 / 0.9);
    box-shadow: 0 1px 2px rgb(27 34 84 / 0.04), 0 10px 30px -12px rgb(27 34 84 / 0.12);
    text-decoration: none;
    color: inherit;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .contents li a:hover {
    transform: translateY(-4px);
    box-shadow: 0 2px 4px rgb(27 34 84 / 0.05), 0 22px 40px -16px rgb(91 76 180 / 0.3);
  }
  .contents .icon {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    width: 2.7rem;
    height: 2.7rem;
    padding: 0.45rem;
    margin: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, rgb(179 164 238 / 0.28) 70%, rgb(246 169 138 / 0.3));
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .contents .num {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--ink-faint);
  }
  .contents .label {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.2;
    margin-bottom: 0.35rem;
    padding-right: 1.5rem;
  }
  .contents .desc {
    font-size: 0.76rem;
    color: var(--ink-soft);
    flex: 1;
    padding-right: 3.2rem;
  }
  :global(main [id]) {
    scroll-margin-top: 4.5rem;
  }
  :global(html.theme-night) .contents li a {
    background: rgb(255 255 255 / 0.05);
    border-color: rgb(255 255 255 / 0.1);
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.5);
  }
  :global(html.theme-night) .contents li a:hover {
    background: rgb(255 255 255 / 0.08);
  }
  :global(html.theme-night) .contents .icon {
    background: radial-gradient(circle at 35% 30%, rgb(255 255 255 / 0.2), rgb(179 164 238 / 0.14) 70%, rgb(246 169 138 / 0.2));
  }
</style>

<script>
  type Gradient = {
    c1?: string;
    c2?: string;
    c3?: string;
    m1: number;
    m2: number;
    m3: number;
    p1: number;
    p2: number;
    p3: number;
    glow: number;
    glowX: number;
    glowY: number;
  };

  const params = new URLSearchParams(location.search);
  if (params.has('contents-debug') && !document.querySelector('.contents-debug')) {
    const controls: [keyof Gradient, string, number, number, number][] = [
      ['m1', 'Stop 1 colour strength (% tone)', 0, 80, 1],
      ['p1', 'Stop 1 position (% down)', 0, 100, 1],
      ['m2', 'Stop 2 colour strength (% tone)', 0, 80, 1],
      ['p2', 'Stop 2 position (% down)', 0, 100, 1],
      ['m3', 'Stop 3 colour strength (% tone)', 0, 80, 1],
      ['p3', 'Stop 3 position (% down)', 0, 100, 1],
      ['glow', 'Highlight strength', 0, 1, 0.01],
      ['glowX', 'Highlight across (%)', 0, 100, 1],
      ['glowY', 'Highlight down (%)', 0, 100, 1],
    ];
    const bands = Array.from(document.querySelectorAll<HTMLElement>('.contents .band')).map((el) => ({
      el,
      part: document.getElementById(el.dataset.id ?? ''),
      title: el.dataset.title!,
      tone: el.dataset.tone!,
      labelColor: el.dataset.labelColor || '',
      previewAlpha: Number(el.dataset.previewAlpha ?? 1),
      g: JSON.parse(el.dataset.gradient!) as Gradient,
    }));
    const apply = (b: (typeof bands)[number]) => {
      [b.el, b.part].forEach((target) => {
        if (!target) return;
        const s = target.style;
        s.setProperty('--tone', b.tone);
        if (b.labelColor) s.setProperty('--part-label-color', b.labelColor);
        else s.removeProperty('--part-label-color');
        s.setProperty('--c1', b.g.c1 ?? b.tone);
        s.setProperty('--c2', b.g.c2 ?? b.tone);
        s.setProperty('--c3', b.g.c3 ?? b.tone);
        s.setProperty('--m1', `${b.g.m1}%`);
        s.setProperty('--m2', `${b.g.m2}%`);
        s.setProperty('--m3', `${b.g.m3}%`);
        s.setProperty('--p1', `${b.g.p1}%`);
        s.setProperty('--p2', `${b.g.p2}%`);
        s.setProperty('--p3', `${b.g.p3}%`);
        s.setProperty('--part-p1', `${(b.g.p1 / 100) * 34}rem`);
        s.setProperty('--part-p2', `${(b.g.p2 / 100) * 34}rem`);
        s.setProperty('--part-p3', `${(b.g.p3 / 100) * 34}rem`);
        s.setProperty('--glow', String(b.g.glow));
        s.setProperty('--glow-x', `${b.g.glowX}%`);
        s.setProperty('--glow-y', `${b.g.glowY}%`);
      });
      b.el.style.setProperty('--preview-alpha', String(b.previewAlpha));
    };
    const values = () =>
      bands.map((b) => `// ${b.title}\ntone: '${b.tone}',\n${b.labelColor ? `labelColor: '${b.labelColor}',\n` : ''}previewAlpha: ${b.previewAlpha},\ngradient: ${JSON.stringify(b.g)},`).join('\n\n');

    const panel = document.createElement('div');
    panel.className = 'contents-debug';
    panel.innerHTML =
      `<strong>On this page — band gradients</strong>` +
      `<label>Preview colour intensity only<span><input type="range" name="previewAlphaAll" min="0" max="1" step="0.01" value="1"><output>1</output></span></label>` +
      bands
        .map(
          (b, i) =>
            `<fieldset data-band="${i}"><legend>${b.title}</legend>` +
            `<label>Preview intensity<span><input type="range" name="previewAlpha" min="0" max="1" step="0.01" value="${b.previewAlpha}"><output>${b.previewAlpha}</output></span></label>` +
            `<label>Tone<span><input type="color" name="tone" value="${b.tone}"><output>${b.tone}</output></span></label>` +
            `<label>Main Part label colour<span><input type="color" name="labelColor" value="${b.labelColor || b.tone}"><output>${b.labelColor || 'default'}</output></span></label>` +
            `<label>Stop 1 colour<span><input type="color" name="c1" value="${b.g.c1 ?? b.tone}"><output>${b.g.c1 ?? b.tone}</output></span></label>` +
            `<label>Stop 2 colour<span><input type="color" name="c2" value="${b.g.c2 ?? b.tone}"><output>${b.g.c2 ?? b.tone}</output></span></label>` +
            `<label>Stop 3 colour<span><input type="color" name="c3" value="${b.g.c3 ?? b.tone}"><output>${b.g.c3 ?? b.tone}</output></span></label>` +
            controls
              .map(
                ([key, label, min, max, step]) =>
                  `<label>${label}<span><input type="range" name="${key}" min="${min}" max="${max}" step="${step}" value="${b.g[key]}"><output>${b.g[key]}</output></span></label>`,
              )
              .join('') +
            `</fieldset>`,
        )
        .join('') +
      `<button type="button">Copy values</button>`;
    panel.addEventListener('input', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.name === 'previewAlphaAll') {
        const value = Number(input.value);
        bands.forEach((b) => {
          b.previewAlpha = value;
          apply(b);
        });
        panel.querySelectorAll<HTMLInputElement>('input[name=previewAlpha]').forEach((control) => {
          control.value = input.value;
          control.nextElementSibling!.textContent = input.value;
        });
        input.nextElementSibling!.textContent = input.value;
        return;
      }
      const b = bands[Number(input.closest('fieldset')!.dataset.band)];
      if (input.name === 'tone') b.tone = input.value;
      else if (input.name === 'labelColor') b.labelColor = input.value;
      else if (input.name === 'previewAlpha') b.previewAlpha = Number(input.value);
      else if (input.name === 'c1' || input.name === 'c2' || input.name === 'c3') b.g[input.name] = input.value;
      else b.g[input.name as keyof Gradient] = Number(input.value);
      input.nextElementSibling!.textContent = input.value;
      apply(b);
    });
    panel.querySelector('button')!.addEventListener('click', (e) => {
      navigator.clipboard.writeText(values());
      (e.target as HTMLButtonElement).textContent = 'Copied';
    });
    Object.assign(panel.style, {
      position: 'fixed', right: '1rem', bottom: '1rem', zIndex: '9999', width: '19rem', maxHeight: 'calc(100vh - 6rem)',
      overflowY: 'auto', padding: '0.9rem 1rem', display: 'grid', gap: '0.55rem', font: '12px/1.3 system-ui, sans-serif',
      color: '#111', background: 'rgba(255,255,255,0.94)', border: '1px solid #ccc', borderRadius: '8px',
      boxShadow: '0 6px 24px rgba(0,0,0,0.15)',
    });
    panel.querySelectorAll('fieldset').forEach((f) => Object.assign(f.style, { display: 'grid', gap: '0.45rem', border: '1px solid #ddd', borderRadius: '6px', padding: '0.5rem 0.7rem 0.7rem', margin: '0' }));
    panel.querySelectorAll('label').forEach((l) => Object.assign(l.style, { display: 'grid', gap: '0.2rem' }));
    panel.querySelectorAll('label span').forEach((s) => Object.assign((s as HTMLElement).style, { display: 'flex', gap: '0.5rem', alignItems: 'center' }));
    panel.querySelectorAll('input[type=range]').forEach((i) => ((i as HTMLElement).style.flex = '1'));
    document.body.append(panel);
  }
</script>
