---
export interface ContentsItem {
  id: string;
  label: string;
  desc: string;
  /** Inner SVG markup on a 48×48 grid; `stroke="url(#toc-glow)"` gives the accent gradient. */
  icon: string;
}

export interface BandGradient {
  /** % of the tone mixed into the paper at the top and bottom of the band. */
  top: number;
  bottom: number;
  /** Where the top colour starts fading (% of band height). */
  hold: number;
  /** White highlight strength (0–1) and position (% across, % down). */
  glow: number;
  glowX: number;
  glowY: number;
}

const defaultGradient: BandGradient = { top: 10, bottom: 30, hold: 0, glow: 0.45, glowX: 85, glowY: 30 };

export interface ContentsGroup {
  id: string;
  title: string;
  /** Accent colour shared with the part's band on the page. */
  tone: string;
  gradient?: Partial<BandGradient>;
  items: ContentsItem[];
}

interface Props {
  groups: ContentsGroup[];
}

const { groups } = Astro.props;
let n = 0;
const bandStyle = (g: ContentsGroup, i: number) => {
  const v = { ...defaultGradient, ...g.gradient };
  return [
    `--tone:${g.tone}`,
    `--mix-top:${v.top}%`,
    `--mix-bottom:${v.bottom}%`,
    `--hold:${v.hold}%`,
    `--glow:${v.glow}`,
    `--glow-x:${v.glowX}%`,
    `--glow-y:${v.glowY}%`,
    `z-index:${groups.length - i}`,
  ].join(';');
};
---

<nav class="contents" aria-label="On this page">
  <div class="wrap">
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <linearGradient id="toc-glow" x1="0" x2="1">
        <stop offset="0" stop-color="#b3a4ee"></stop>
        <stop offset="1" stop-color="#f6a98a"></stop>
      </linearGradient>
    </svg>
    <p class="eyebrow ruled">On this page</p>
    <div class="mini">
    {
      groups.map((g, gi) => (
        <div class="band" style={bandStyle(g, gi)} data-title={g.title} data-tone={g.tone} data-gradient={JSON.stringify({ ...defaultGradient, ...g.gradient })}>
          <a class="group" href={`#${g.id}`}>
            <span class="part">Part {gi + 1}</span>
            <span class="group-title">{g.title}</span>
          </a>
          <ol>
            {g.items.map((c) => (
              <li>
                <a href={`#${c.id}`}>
                  <svg class="icon" viewBox="0 0 48 48" aria-hidden="true">
                    <Fragment set:html={c.icon} />
                  </svg>
                  <span class="num">{String(++n).padStart(2, '0')}</span>
                  <span class="label">{c.label}</span>
                  <span class="desc">{c.desc}</span>
                  <span class="arrow" aria-hidden="true">↓</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
    </div>
  </div>
</nav>

<style>
  .contents {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    background:
      radial-gradient(ellipse 40% 80% at 0% 100%, rgb(179 164 238 / 0.18), transparent 70%),
      radial-gradient(ellipse 40% 80% at 100% 0%, rgb(246 169 138 / 0.16), transparent 70%),
      var(--paper-deep);
  }
  .contents ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
  }
  .contents .mini {
    border-radius: calc(var(--radius) * 2);
    overflow: hidden;
    background: var(--paper);
    box-shadow: 0 1px 2px rgb(27 34 84 / 0.04), 0 18px 50px -24px rgb(27 34 84 / 0.25);
  }
  .contents .band {
    --band-top: color-mix(in srgb, var(--tone) var(--mix-top), var(--paper));
    --band-bottom: color-mix(in srgb, var(--tone) var(--mix-bottom), var(--paper));
    --wave-depth: 3rem;
    position: relative;
    isolation: isolate;
    padding: 3rem clamp(1.25rem, 3vw, 2.25rem);
    background:
      radial-gradient(ellipse 50% 70% at var(--glow-x) var(--glow-y), rgb(255 255 255 / var(--glow)), transparent 70%),
      linear-gradient(180deg, var(--band-top) var(--hold), var(--band-bottom));
  }
  .contents .band + .band {
    padding-top: calc(var(--wave-depth) + 1.5rem);
  }
  .contents .band::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 100%;
    height: var(--wave-depth);
    z-index: -1;
    pointer-events: none;
    background: var(--band-bottom);
    -webkit-mask: var(--wave) 0 0 / 100% 100% no-repeat;
    mask: var(--wave) 0 0 / 100% 100% no-repeat;
  }
  .contents .band:last-child {
    padding-bottom: calc(var(--wave-depth) + 1.5rem);
  }
  .contents .band:last-child::after {
    top: auto;
    bottom: 0;
    transform: scale(-1, -1);
    background: var(--paper);
  }
  .contents .group {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
    color: var(--ink);
    text-decoration: none;
  }
  .contents .part {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    color: color-mix(in srgb, var(--tone) 75%, var(--ink));
  }
  .contents .group-title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.75rem);
  }
  .contents li a {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem 1.5rem 1.4rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.75);
    border: 1px solid rgb(255 255 255 / 0.9);
    box-shadow: 0 1px 2px rgb(27 34 84 / 0.04), 0 10px 30px -12px rgb(27 34 84 / 0.12);
    text-decoration: none;
    color: inherit;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .contents li a:hover {
    transform: translateY(-4px);
    box-shadow: 0 2px 4px rgb(27 34 84 / 0.05), 0 22px 40px -16px rgb(91 76 180 / 0.3);
  }
  .contents .icon {
    width: 3.75rem;
    height: 3.75rem;
    padding: 0.55rem;
    margin-bottom: 1.25rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, rgb(179 164 238 / 0.28) 70%, rgb(246 169 138 / 0.3));
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .contents .num {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--ink-faint);
  }
  .contents .label {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }
  .contents .desc {
    font-size: 0.88rem;
    color: var(--ink-soft);
    flex: 1;
  }
  .contents .arrow {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--dusk);
    transition: transform 0.35s ease;
  }
  .contents li a:hover .arrow {
    transform: translateY(3px);
  }
  :global(main [id]) {
    scroll-margin-top: 4.5rem;
  }
  :global(html.theme-night) .contents li a {
    background: rgb(255 255 255 / 0.05);
    border-color: rgb(255 255 255 / 0.1);
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.5);
  }
  :global(html.theme-night) .contents li a:hover {
    background: rgb(255 255 255 / 0.08);
  }
  :global(html.theme-night) .contents .icon {
    background: radial-gradient(circle at 35% 30%, rgb(255 255 255 / 0.2), rgb(179 164 238 / 0.14) 70%, rgb(246 169 138 / 0.2));
  }
</style>

<script>
  type Gradient = { top: number; bottom: number; hold: number; glow: number; glowX: number; glowY: number };

  const params = new URLSearchParams(location.search);
  if (params.has('contents-debug') && !document.querySelector('.contents-debug')) {
    const controls: [keyof Gradient, string, number, number, number][] = [
      ['top', 'Top colour strength (% tone)', 0, 80, 1],
      ['bottom', 'Bottom colour strength (% tone)', 0, 80, 1],
      ['hold', 'Top colour holds until (% down)', 0, 90, 1],
      ['glow', 'Highlight strength', 0, 1, 0.01],
      ['glowX', 'Highlight across (%)', 0, 100, 1],
      ['glowY', 'Highlight down (%)', 0, 100, 1],
    ];
    const bands = Array.from(document.querySelectorAll<HTMLElement>('.contents .band')).map((el) => ({
      el,
      title: el.dataset.title!,
      tone: el.dataset.tone!,
      g: JSON.parse(el.dataset.gradient!) as Gradient,
    }));
    const apply = (b: (typeof bands)[number]) => {
      const s = b.el.style;
      s.setProperty('--tone', b.tone);
      s.setProperty('--mix-top', `${b.g.top}%`);
      s.setProperty('--mix-bottom', `${b.g.bottom}%`);
      s.setProperty('--hold', `${b.g.hold}%`);
      s.setProperty('--glow', String(b.g.glow));
      s.setProperty('--glow-x', `${b.g.glowX}%`);
      s.setProperty('--glow-y', `${b.g.glowY}%`);
    };
    const values = () =>
      bands.map((b) => `// ${b.title}\ntone: '${b.tone}',\ngradient: ${JSON.stringify(b.g)},`).join('\n\n');

    const panel = document.createElement('div');
    panel.className = 'contents-debug';
    panel.innerHTML =
      `<strong>On this page — band gradients</strong>` +
      bands
        .map(
          (b, i) =>
            `<fieldset data-band="${i}"><legend>${b.title}</legend>` +
            `<label>Tone<span><input type="color" name="tone" value="${b.tone}"><output>${b.tone}</output></span></label>` +
            controls
              .map(
                ([key, label, min, max, step]) =>
                  `<label>${label}<span><input type="range" name="${key}" min="${min}" max="${max}" step="${step}" value="${b.g[key]}"><output>${b.g[key]}</output></span></label>`,
              )
              .join('') +
            `</fieldset>`,
        )
        .join('') +
      `<button type="button">Copy values</button>`;
    panel.addEventListener('input', (e) => {
      const input = e.target as HTMLInputElement;
      const b = bands[Number(input.closest('fieldset')!.dataset.band)];
      if (input.name === 'tone') b.tone = input.value;
      else b.g[input.name as keyof Gradient] = Number(input.value);
      input.nextElementSibling!.textContent = input.value;
      apply(b);
    });
    panel.querySelector('button')!.addEventListener('click', (e) => {
      navigator.clipboard.writeText(values());
      (e.target as HTMLButtonElement).textContent = 'Copied';
    });
    Object.assign(panel.style, {
      position: 'fixed', right: '1rem', bottom: '1rem', zIndex: '9999', width: '19rem', maxHeight: 'calc(100vh - 6rem)',
      overflowY: 'auto', padding: '0.9rem 1rem', display: 'grid', gap: '0.55rem', font: '12px/1.3 system-ui, sans-serif',
      color: '#111', background: 'rgba(255,255,255,0.94)', border: '1px solid #ccc', borderRadius: '8px',
      boxShadow: '0 6px 24px rgba(0,0,0,0.15)',
    });
    panel.querySelectorAll('fieldset').forEach((f) => Object.assign(f.style, { display: 'grid', gap: '0.45rem', border: '1px solid #ddd', borderRadius: '6px', padding: '0.5rem 0.7rem 0.7rem', margin: '0' }));
    panel.querySelectorAll('label').forEach((l) => Object.assign(l.style, { display: 'grid', gap: '0.2rem' }));
    panel.querySelectorAll('label span').forEach((s) => Object.assign((s as HTMLElement).style, { display: 'flex', gap: '0.5rem', alignItems: 'center' }));
    panel.querySelectorAll('input[type=range]').forEach((i) => ((i as HTMLElement).style.flex = '1'));
    document.body.append(panel);
  }
</script>
