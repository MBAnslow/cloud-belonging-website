---
import Cloud3D from './Cloud3D.astro';
import VideoClip from './VideoClip.astro';
import { url } from '../lib/url';
import { phases } from '../data/phases';
import type { CloudStateName } from '../lib/cloud/states';

const cells: { id: string; numeral: string; title: string; cloud: CloudStateName; text: string }[] = [
  {
    id: 'arrival',
    numeral: 'Before',
    title: 'Arrival',
    cloud: 'golden',
    text: 'Shoes off, lying down beneath a cloud in warm golden light, before anything begins.',
  },
  ...phases.map((p) => ({ id: p.id, numeral: p.numeral, title: p.title, cloud: p.cloud, text: p.notes.join(' · ') })),
];
---

<section class="section score" id="narrative">
  <div class="wrap">
    <div class="score-head reveal">
      <p class="eyebrow">The narrative</p>
      <h2>From dusk to a cloud that breathes with you</h2>
      <p class="lede">
        The installation unfolds in four stages. Dusk with an approaching lightning storm that builds in intensity, the
        magical twilight turns the experience into a mystical story of transformation, so that by the time the cloud
        begins to breathe with you, you already feel bound to it through dawn. Then finally back to daylight as the
        magic fades and you are back in reality.
      </p>
    </div>
    <ol class="score-grid">
      {
        cells.map((c) => (
          <li class="cell reveal">
            <div class="sky">
              <Cloud3D mode="controlled" initial={c.cloud} place={[0, 0.12, 0.62]} placeNarrow={[0, 0.12, 0.62]} />
            </div>
            <div class="caption">
              <p class="numeral">{c.numeral}</p>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="simulation reveal">
      <p class="lede">
        We explored this narrative through simulation before building it. You can read more of the process in{' '}
        <a href={url('/process/2026-07-08-the-story-of-a-night/')}>The story of a night →</a>
      </p>
      <VideoClip
        name="simulation"
        ratio="1280 / 636"
        caption="A 3D simulation of the room: figures lying on mats, each beneath their own cloud, as the night moves from dusk to daylight."
      />
    </div>
  </div>
</section>

<style>
  .score-head {
    max-width: 46rem;
    margin-bottom: 2.5rem;
  }
  .score-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .cell {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    color: #fbfaff;
    background: #1b2250;
  }
  .sky {
    position: absolute;
    inset: 0;
  }
  .caption {
    position: absolute;
    inset: auto 0 0;
    padding: 2.5rem 1.4rem 1.2rem;
    background: linear-gradient(180deg, transparent, rgb(14 19 40 / 0.72));
  }
  .numeral {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    opacity: 0.8;
    margin: 0 0 0.2rem;
  }
  .caption h3 {
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.8rem);
    margin: 0 0 0.25rem;
  }
  .caption p:last-child {
    margin: 0;
    font-size: 0.88rem;
    opacity: 0.85;
  }
  .simulation {
    max-width: 52rem;
    margin: 4rem auto 0;
  }
  .simulation .lede {
    max-width: 46rem;
    margin-bottom: 1.5rem;
  }
  .simulation .lede a {
    color: var(--ink);
  }
  @media (max-width: 700px) {
    .score-grid {
      grid-template-columns: 1fr;
    }
    .cell {
      aspect-ratio: 4 / 5;
    }
  }
</style>
