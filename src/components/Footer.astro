---
import { url } from '../lib/url';
import { nav, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer dark">
  <div class="wrap inner">
    <div class="about">
      <p class="title">{site.title}</p>
      <p>
        A research-creation installation about belonging to nature, made in 2026 during a research-creation internship
        at Sony CSL Paris. An invitation to explore belonging further.
      </p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {nav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="wrap small">
    <span>© {year} {site.team.map((t) => t.name).join(' & ')}</span>
    <span>Every cloud is borrowed from the sea.</span>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 4rem 2rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--line);
  }
  .about {
    max-width: 28rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: #f1f2fc;
    margin-bottom: 0.5rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  a {
    text-decoration: none;
    color: var(--ink-soft);
  }
  a:hover {
    color: #fff;
  }
  .small {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
</style>
