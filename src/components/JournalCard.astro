---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/journal';
import GenerativeCover from './GenerativeCover.astro';
import discussionPlaceholder from '../assets/photos/discussion-placeholder.png';

const stagePlaceholders: Partial<Record<CollectionEntry<'journal'>['data']['stage'], ImageMetadata>> = {
  Conversation: discussionPlaceholder,
};

interface Props {
  entry: CollectionEntry<'journal'>;
}

const { entry } = Astro.props;
const { title, date, dateLabel, summary, stage, cover, coverAlt, coverVideo, video, tags } = entry.data;
const stagePlaceholder = tags.includes('conversation') ? discussionPlaceholder : stagePlaceholders[stage];
const isArtwork = !cover && !coverVideo && !video && (stage === 'Concept formation' || Boolean(stagePlaceholder));
const hash = (text: string) => {
  let value = 1779033703 ^ text.length;
  for (let i = 0; i < text.length; i++) {
    value = Math.imul(value ^ text.charCodeAt(i), 3432918353);
    value = (value << 13) | (value >>> 19);
  }
  return value >>> 0;
};
const conceptMats = ['#bccde3', '#d3cce8', '#b7cbdc'];
const conversationMats = ['#d8a18f', '#aabcc5', '#d8cdbb'];
const matChoices = stage === 'Concept formation' ? conceptMats : conversationMats;
const artworkMat = matChoices[hash(title) % matChoices.length];
---

<article class="card reveal">
  <a href={url(`/process/${entry.id}/`)} class="link">
    <div
      class:list={['media', { artwork: isArtwork }]}
      style={isArtwork ? `--artwork-mat: ${artworkMat}` : undefined}>
      {
        coverVideo ? (
          <video
            class="cover-video"
            src={url(`/video/${coverVideo}.mp4`)}
            poster={url(`/video/${coverVideo}.jpg`)}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
          />
        ) : cover ? (
          <Image src={cover} alt={coverAlt ?? ''} widths={[400, 700]} sizes="(min-width: 60rem) 22rem, 100vw" />
        ) : video ? (
          <img src={url(`/video/${video}.jpg`)} alt="" loading="lazy" decoding="async" />
        ) : stage === 'Concept formation' ? (
          <GenerativeCover seed={title} />
        ) : stagePlaceholder ? (
          <Image
            src={stagePlaceholder}
            alt=""
            widths={[400, 700]}
            sizes="(min-width: 60rem) 22rem, 100vw"
          />
        ) : (
          <div class="placeholder" aria-hidden="true">
            <svg viewBox="0 0 40 24">
              <path d="M10 21h21a7 7 0 0 0 .6-13.97A9 9 0 0 0 14.3 5.4 6.5 6.5 0 0 0 10 21Z" />
            </svg>
          </div>
        )
      }
    </div>
    <div class="meta">
      <span class="tag" data-stage={stage}>{stage}</span>
      <time datetime={date.toISOString()}>{dateLabel ?? formatDate(date)}</time>
    </div>
    <h3>{title}</h3>
    <p>{summary}</p>
  </a>
</article>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(({ target, isIntersecting }) => {
      const video = target as HTMLVideoElement;
      if (isIntersecting) video.play().catch(() => {});
      else video.pause();
    });
  });
  document.querySelectorAll<HTMLVideoElement>('.cover-video').forEach((v) => observer.observe(v));
</script>

<style>
  .card {
    height: 100%;
  }
  .link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }
  .media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-deep);
    margin-bottom: 1.1rem;
  }
  .media.artwork {
    padding: clamp(0.65rem, 2vw, 1rem);
    background:
      radial-gradient(
        circle at 18% 14%,
        color-mix(in srgb, var(--artwork-mat), white 35%),
        transparent 42%
      ),
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--artwork-mat), white 18%),
        color-mix(in srgb, var(--artwork-mat), #efe9df 48%)
      );
    box-shadow: inset 0 0 0 1px rgb(31 38 80 / 0.06);
  }
  .media img,
  .media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s ease;
  }
  .media.artwork img,
  .media.artwork :global(.generative-cover) {
    border-radius: calc(var(--radius) * 0.35);
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 9%, #000 91%, transparent),
      linear-gradient(to bottom, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 9%, #000 91%, transparent),
      linear-gradient(to bottom, transparent, #000 10%, #000 90%, transparent);
    mask-composite: intersect;
  }
  .media :global(.generative-cover) {
    transition: transform 1.2s ease;
  }
  .link:hover .media img,
  .link:hover .media video,
  .link:hover .media :global(.generative-cover) {
    transform: scale(1.04);
  }
  .placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, #d9d4e6, #f3dccb);
  }
  .placeholder svg {
    width: 38%;
    fill: rgb(255 255 255 / 0.7);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.82rem;
    color: var(--ink-faint);
    margin-bottom: 0.6rem;
  }
  h3 {
    font-size: 1.4rem;
    margin-bottom: 0.4rem;
  }
  .link:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  p {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin: 0;
  }
</style>
