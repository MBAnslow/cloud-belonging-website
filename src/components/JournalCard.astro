---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/journal';

interface Props {
  entry: CollectionEntry<'journal'>;
}

const { entry } = Astro.props;
const { title, date, summary, stage, cover, coverAlt, video } = entry.data;
---

<article class="card reveal">
  <a href={`/process/${entry.id}/`} class="link">
    <div class="media">
      {
        cover ? (
          <Image src={cover} alt={coverAlt ?? ''} widths={[400, 700]} sizes="(min-width: 60rem) 22rem, 100vw" />
        ) : video ? (
          <img src={`/video/${video}.jpg`} alt="" loading="lazy" decoding="async" />
        ) : (
          <div class="placeholder" aria-hidden="true">
            <svg viewBox="0 0 40 24">
              <path d="M10 21h21a7 7 0 0 0 .6-13.97A9 9 0 0 0 14.3 5.4 6.5 6.5 0 0 0 10 21Z" />
            </svg>
          </div>
        )
      }
    </div>
    <div class="meta">
      <span class="tag" data-stage={stage}>{stage}</span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </div>
    <h3>{title}</h3>
    <p>{summary}</p>
  </a>
</article>

<style>
  .card {
    height: 100%;
  }
  .link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }
  .media {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-deep);
    margin-bottom: 1.1rem;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s ease;
  }
  .link:hover .media img {
    transform: scale(1.04);
  }
  .placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, #d9d4e6, #f3dccb);
  }
  .placeholder svg {
    width: 38%;
    fill: rgb(255 255 255 / 0.7);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.82rem;
    color: var(--ink-faint);
    margin-bottom: 0.6rem;
  }
  h3 {
    font-size: 1.4rem;
    margin-bottom: 0.4rem;
  }
  .link:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  p {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin: 0;
  }
</style>
