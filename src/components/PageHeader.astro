---
import CloudFrame from './CloudFrame.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, title, lede, image, imageAlt = '' } = Astro.props;
const seed = [...title].reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 997, 7);
---

<header class:list={['page-header', { 'has-image': !!image }]}>
  <div class="wrap inner">
    <div class="text">
      <p class="eyebrow ruled">{eyebrow}</p>
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
    {
      image && (
        <CloudFrame
          src={image}
          alt={imageAlt}
          widths={[500, 800, 1100]}
          sizes="(min-width: 60rem) 42rem, 100vw"
          seed={seed}
          loading="eager"
          class="photo"
        />
      )
    }
  </div>
</header>

<style>
  .page-header {
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--line);
  }
  .page-header:has(+ :global(.blend), + :global(.wash)) {
    border-bottom: 0;
  }
  .inner {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .has-image .inner {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  }
  .text {
    position: relative;
    z-index: 1;
  }
  .has-image :global(.photo) {
    margin-left: clamp(-9rem, -7vw, -2rem);
    margin-right: clamp(-4rem, -3vw, 0rem);
    position: relative;
    z-index: 0;
  }
  .eyebrow {
    margin-bottom: 1rem;
  }
  h1 {
    max-width: 11ch;
    margin-bottom: 1.5rem;
  }
  .lede {
    max-width: 30rem;
  }
  .photo :global(img.main) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  @media (max-width: 860px) {
    .has-image .inner {
      grid-template-columns: 1fr;
    }
    .has-image :global(.photo) {
      margin: 0;
    }
  }
</style>
