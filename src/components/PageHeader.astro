---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, title, lede, image, imageAlt = '' } = Astro.props;
---

<header class:list={['page-header', { 'has-image': !!image }]}>
  <div class="wrap inner">
    <div class="text">
      <p class="eyebrow ruled">{eyebrow}</p>
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
    {
      image && (
        <Image
          src={image}
          alt={imageAlt}
          widths={[500, 800, 1100]}
          sizes="(min-width: 60rem) 30rem, 100vw"
          loading="eager"
          class="photo"
        />
      )
    }
  </div>
</header>

<style>
  .page-header {
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--line);
  }
  .inner {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .has-image .inner {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }
  .eyebrow {
    margin-bottom: 1rem;
  }
  h1 {
    max-width: 11ch;
    margin-bottom: 1.5rem;
  }
  .lede {
    max-width: 30rem;
  }
  .photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--paper-deep);
  }
  @media (max-width: 860px) {
    .has-image .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
