---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  ratio?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  caption,
  ratio,
  widths = [480, 800, 1200, 1600],
  sizes = '(min-width: 72rem) 36rem, 100vw',
  class: className,
} = Astro.props;
---

<figure class:list={['fig', className]} style={ratio ? `--ratio: ${ratio}` : undefined}>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} class:list={{ cropped: !!ratio }} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig {
    margin: 0;
  }
  img {
    width: 100%;
    border-radius: var(--radius);
    background: var(--paper-deep);
  }
  img.cropped {
    aspect-ratio: var(--ratio);
    object-fit: cover;
  }
  figcaption {
    font-size: 0.85rem;
    color: var(--ink-faint);
    margin-top: 0.7rem;
  }
</style>
