---
import { checklist } from '../data/checklist';
---

<div class="checklist">
  <div class="sections">
    {
      checklist.map((section) => (
        <section class="block">
          <h3>{section.title}</h3>
          <ul>
            {section.items.map((item) => (
              <li>
                <span class="label">{item.label}</span>
                {item.detail && <span class="detail"> — {item.detail}</span>}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</div>

<style>
  .sections {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
  }
  .block {
    padding: 1.1rem 1.2rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.4);
  }
  h3 {
    margin: 0 0 0.6rem;
    font-size: 1.1rem;
    line-height: 1.2;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    position: relative;
    padding: 0.35rem 0 0.35rem 1rem;
    font-size: 0.84rem;
    line-height: 1.45;
  }
  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8rem;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--dusk);
    opacity: 0.7;
  }
  .label {
    font-weight: 550;
    color: var(--ink);
  }
  .detail {
    color: var(--ink-soft);
  }

  @media print {
    .sections {
      display: block;
    }
    .block {
      break-inside: avoid;
      margin-bottom: 1rem;
      background: none;
    }
  }
</style>
