---
import { checklist } from '../data/checklist';

interface Props {
  /** Section titles and item labels only. The long notes live in the process article. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['checklist', { compact }]}>
  <div class="sections">
    {
      checklist.map((section) => (
        <section class="block">
          <h3>{section.title}</h3>
          <ul>
            {section.items.map((item) => (
              <li>
                <span class="label">{item.label}</span>
                {!compact && item.detail && <span class="detail">{item.detail}</span>}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</div>

<style>
  .sections {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
  }
  .block {
    padding: 1.35rem 1.4rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) * 0.9);
    background: rgb(255 255 255 / 0.55);
    box-shadow: 0 1px 2px rgb(27 34 84 / 0.04);
  }
  h3 {
    margin: 0 0 0.35rem;
    padding-bottom: 0.7rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.35rem;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--ink);
    background-image: linear-gradient(90deg, rgb(31 38 80 / 0.22), transparent 78%);
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 100% 1px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    padding: 0.7rem 0;
    border-bottom: 1px solid rgb(31 38 80 / 0.08);
  }
  li:last-child {
    border-bottom: 0;
    padding-bottom: 0.35rem;
  }
  .label {
    display: block;
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .detail {
    display: block;
    margin-top: 0.28rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .compact .label {
    font-weight: 450;
  }

  @media print {
    .sections {
      display: block;
    }
    .block {
      break-inside: avoid;
      margin-bottom: 1rem;
      background: none;
    }
  }
</style>
